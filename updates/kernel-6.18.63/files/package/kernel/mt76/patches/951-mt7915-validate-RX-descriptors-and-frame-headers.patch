+static bool
+mt7915_rx_desc_len_valid(struct sk_buff *skb, const void *data, size_t len)
+{
+	const u8 *start = data;
+	const u8 *end = skb_tail_pointer(skb);
+
+	return start >= skb->data && start <= end && len <= end - start;
+}
