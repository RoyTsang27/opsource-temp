index 00000000..95bc4ee5
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/449-wifi-mac80211-add-the-flow-offload-flush-op.patch
@@ -0,0 +1,262 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sun, 30 Aug 2026 01:41:35 +0200
+Subject: [PATCH] wifi: mac80211: add the flow offload flush op
+
+A driver that uses ieee80211_sta_flow_prio() stores the result in its
+hardware flow entries. Once the SCS or MSCS rules of a station change,
+those entries are stale. Add a driver op that is called after each rule
+change, so that the driver can drop the entries of the station and
+query again when the flows are added back.
+
+A learned MSCS priority also changes an answer, but only for one flow.
+When a flow is learned or its priority changes, the entry is marked
+and a work passes its key to the driver, so that only the matching
+hardware entries are dropped. The work runs under the wiphy lock, since
+the learn path runs in the receive path and the op may sleep. The key
+describes the frames to the station. The driver also drops the entries
+of the flow that carry the frames of the station, since mac80211 learns
+an MSCS priority only from frames that it receives.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/mac80211.h
++++ b/include/net/mac80211.h
+@@ -5119,6 +5119,27 @@ struct ieee80211_ops {
+ 			   struct ieee80211_sta *sta,
+ 			   struct cfg80211_scs_desc * const *desc,
+ 			   struct cfg80211_scs_result *res, u8 n_desc);
++	/**
++	 * @flow_offload_flush:
++	 * Called after the SCS or MSCS rules of a station changed, or after
++	 * the learned MSCS priority of one flow changed. Any priority that
++	 * ieee80211_sta_flow_prio() returned before is stale, so the driver
++	 * must drop the hardware flow entries that use it. With a %NULL
++	 * @key, every entry of the station is stale. Otherwise only the
++	 * entries whose flow, masked to @fields, equals @key are stale.
++	 * @key describes the frames to the station. The driver also drops
++	 * the entries of the same flow in the direction from the station,
++	 * since mac80211 learns an MSCS priority only from frames that it
++	 * receives.
++	 * Optional, only needed by drivers that use ieee80211_sta_flow_prio().
++	 *
++	 * Called with the wiphy mutex held. This callback may sleep.
++	 */
++	void (*flow_offload_flush)(struct ieee80211_hw *hw,
++				   struct ieee80211_vif *vif,
++				   struct ieee80211_sta *sta,
++				   const struct cfg80211_flow_key *key,
++				   u32 fields);
+ 	int (*set_tid_config)(struct ieee80211_hw *hw,
+ 			      struct ieee80211_vif *vif,
+ 			      struct ieee80211_sta *sta,
+--- a/net/mac80211/driver-ops.h
++++ b/net/mac80211/driver-ops.h
+@@ -1578,6 +1578,28 @@ static inline int drv_sta_set_scs(struct
+ 	return ret;
+ }
+ 
++static inline void drv_flow_offload_flush(struct ieee80211_local *local,
++					  struct ieee80211_sub_if_data *sdata,
++					  struct sta_info *sta,
++					  const struct cfg80211_flow_key *key,
++					  u32 fields)
++{
++	might_sleep();
++	lockdep_assert_wiphy(local->hw.wiphy);
++
++	if (!local->ops->flow_offload_flush || !sta->uploaded)
++		return;
++
++	sdata = get_bss_sdata(sdata);
++	if (!check_sdata_in_driver(sdata))
++		return;
++
++	trace_drv_flow_offload_flush(local, sdata, &sta->sta);
++	local->ops->flow_offload_flush(&local->hw, &sdata->vif, &sta->sta, key,
++				       fields);
++	trace_drv_return_void(local);
++}
++
+ static inline int drv_set_tid_config(struct ieee80211_local *local,
+ 				     struct ieee80211_sub_if_data *sdata,
+ 				     struct ieee80211_sta *sta,
+--- a/net/mac80211/ieee80211_i.h
++++ b/net/mac80211/ieee80211_i.h
+@@ -345,6 +345,7 @@ struct ieee80211_if_ap {
+ 	/* learned MSCS entries of every station of this BSS, and its VLANs */
+ 	struct rhashtable flow_tbl;
+ 	struct wiphy_delayed_work flow_gc_work;
++	struct wiphy_work flow_flush_work;
+ };
+ 
+ struct ieee80211_if_vlan {
+--- a/net/mac80211/scs.c
++++ b/net/mac80211/scs.c
+@@ -295,10 +295,65 @@ static void ieee80211_flow_gc_work(struc
+ 		wiphy_delayed_work_queue(wiphy, &ap->flow_gc_work, delay);
+ }
+ 
++/* Tell the driver about every flow whose learned priority changed */
++static void ieee80211_flow_flush_sta(struct ieee80211_sub_if_data *sdata,
++				     struct sta_info *sta)
++{
++	struct ieee80211_mscs_sta *mscs;
++
++	mscs = wiphy_dereference(sdata->local->hw.wiphy, sta->mscs);
++	if (!mscs)
++		return;
++
++	while (true) {
++		struct ieee80211_flow_entry *entry;
++		struct cfg80211_flow_key key;
++		bool found = false;
++
++		spin_lock_bh(&mscs->lock);
++		list_for_each_entry(entry, &mscs->entries, list) {
++			if (!READ_ONCE(entry->flush))
++				continue;
++
++			WRITE_ONCE(entry->flush, false);
++			key = entry->hkey.key;
++			found = true;
++			break;
++		}
++		spin_unlock_bh(&mscs->lock);
++
++		if (!found)
++			return;
++
++		drv_flow_offload_flush(sdata->local, sta->sdata, sta, &key,
++				       mscs->layout);
++	}
++}
++
++static void ieee80211_flow_flush_work(struct wiphy *wiphy,
++				      struct wiphy_work *work)
++{
++	struct ieee80211_sub_if_data *sdata;
++	struct ieee80211_if_ap *ap;
++	struct sta_info *sta;
++
++	ap = container_of(work, struct ieee80211_if_ap, flow_flush_work);
++	sdata = container_of(ap, struct ieee80211_sub_if_data, u.ap);
++
++	list_for_each_entry(sta, &sdata->local->sta_list, list) {
++		if (sta->sdata->bss != ap)
++			continue;
++
++		ieee80211_flow_flush_sta(sdata, sta);
++	}
++}
++
+ int ieee80211_flow_tbl_init(struct ieee80211_sub_if_data *sdata)
+ {
+ 	wiphy_delayed_work_init(&sdata->u.ap.flow_gc_work,
+ 				ieee80211_flow_gc_work);
++	wiphy_work_init(&sdata->u.ap.flow_flush_work,
++			ieee80211_flow_flush_work);
+ 
+ 	return rhashtable_init(&sdata->u.ap.flow_tbl, &flow_rht_params);
+ }
+@@ -314,6 +369,7 @@ void ieee80211_flow_tbl_destroy(struct i
+ {
+ 	wiphy_delayed_work_cancel(sdata->local->hw.wiphy,
+ 				  &sdata->u.ap.flow_gc_work);
++	wiphy_work_cancel(sdata->local->hw.wiphy, &sdata->u.ap.flow_flush_work);
+ 	rhashtable_free_and_destroy(&sdata->u.ap.flow_tbl,
+ 				    ieee80211_flow_tbl_free, NULL);
+ }
+@@ -333,6 +389,8 @@ static void ieee80211_flow_insert(struct
+ 	entry->hkey.key = hkey->key;
+ 	entry->up = up;
+ 	entry->last_update = jiffies;
++	/* An offloaded entry of this flow carries the QoS map fallback */
++	entry->flush = true;
+ 
+ 	spin_lock_bh(&mscs->lock);
+ 
+@@ -365,6 +423,8 @@ static void ieee80211_flow_insert(struct
+ 		wiphy_delayed_work_queue(sdata->local->hw.wiphy,
+ 					 &sdata->bss->flow_gc_work, 1);
+ 
++	wiphy_work_queue(sdata->local->hw.wiphy, &sdata->bss->flow_flush_work);
++
+ 	return;
+ 
+ drop:
+@@ -416,13 +476,18 @@ void ieee80211_flow_learn(struct ieee802
+ 
+ 	entry = rhashtable_lookup(&sdata->bss->flow_tbl, &hkey,
+ 				  flow_rht_params);
+-	if (entry) {
+-		WRITE_ONCE(entry->up, up);
+-		WRITE_ONCE(entry->last_update, jiffies);
++	if (!entry) {
++		ieee80211_flow_insert(sdata, mscs, &hkey, up);
+ 		return;
+ 	}
+ 
+-	ieee80211_flow_insert(sdata, mscs, &hkey, up);
++	WRITE_ONCE(entry->last_update, jiffies);
++	if (READ_ONCE(entry->up) == up)
++		return;
++
++	WRITE_ONCE(entry->up, up);
++	WRITE_ONCE(entry->flush, true);
++	wiphy_work_queue(sdata->local->hw.wiphy, &sdata->bss->flow_flush_work);
+ }
+ 
+ int ieee80211_set_scs(struct wiphy *wiphy, struct net_device *dev,
+@@ -515,6 +580,8 @@ int ieee80211_set_scs(struct wiphy *wiph
+ 	if (old)
+ 		kvfree_rcu(old, rcu_head);
+ 
++	drv_flow_offload_flush(sdata->local, sdata, sta, NULL, 0);
++
+ 	return 0;
+ 
+ free:
+@@ -575,6 +642,8 @@ int ieee80211_set_mscs(struct wiphy *wip
+ 		kfree_rcu(old, rcu_head);
+ 	}
+ 
++	drv_flow_offload_flush(sdata->local, sdata, sta, NULL, 0);
++
+ 	return 0;
+ }
+ 
+--- a/net/mac80211/sta_info.h
++++ b/net/mac80211/sta_info.h
+@@ -696,6 +696,8 @@ struct ieee80211_flow_hkey {
+  * @list: linkage in &ieee80211_mscs_sta.entries
+  * @last_update: jiffies of the last uplink frame of this flow
+  * @up: the learned user priority
++ * @flush: @up changed since the driver was last told to drop the
++ *	offloaded entries of this flow
+  * @rcu_head: for freeing
+  */
+ struct ieee80211_flow_entry {
+@@ -704,6 +706,7 @@ struct ieee80211_flow_entry {
+ 	struct list_head list;
+ 	unsigned long last_update;
+ 	u8 up;
++	bool flush;
+ 	struct rcu_head rcu_head;
+ };
+ 
+--- a/net/mac80211/trace.h
++++ b/net/mac80211/trace.h
+@@ -1056,6 +1056,13 @@ TRACE_EVENT(drv_sta_set_scs,
+ 	)
+ );
+ 
++DEFINE_EVENT(sta_event, drv_flow_offload_flush,
++	TP_PROTO(struct ieee80211_local *local,
++		 struct ieee80211_sub_if_data *sdata,
++		 struct ieee80211_sta *sta),
++	TP_ARGS(local, sdata, sta)
++);
++
+ DEFINE_EVENT(sta_event, drv_sta_statistics,
+ 	TP_PROTO(struct ieee80211_local *local,
+ 		 struct ieee80211_sub_if_data *sdata,
diff --git a/package/kernel/mac80211/patches/subsys/450-wifi-mac80211-keep-learned-MSCS-entries-of-offloaded.patch b/package/kernel/mac80211/patches/subsys/450-wifi-mac80211-keep-learned-MSCS-entries-of-offloaded.patch
new file mode 100644
index 00000000..85464973
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/450-wifi-mac80211-keep-learned-MSCS-entries-of-offloaded.patch
@@ -0,0 +1,211 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 13 Oct 2026 12:00:15 +0200
+Subject: [PATCH] wifi: mac80211: keep learned MSCS entries of offloaded flows
+
+A learned entry expires when no uplink frame of the flow reached
+mac80211 for the stream timeout. Once the uplink is offloaded, its
+frames no longer reach the CPU, so an active flow looks idle and its
+entry is dropped, while the hardware keeps forwarding the downlink
+with the learned priority. 11.25.3 of IEEE 802.11-2024 allows an AP to
+keep a variable past the stream timeout.
+
+Add a driver op that reports how long ago the hardware last forwarded
+a flow. Before an entry expires, ask the driver and refresh the entry
+from the answer, so that it lives as long as the hardware forwards the
+flow.
+
+An MSCS mirrors the user priority that the station uses, and the
+station can change it for a flow at any time. While the uplink stays
+offloaded, mac80211 does not see the change, and the downlink keeps the
+old priority. When the hardware keeps an entry alive, also drop the
+flow from the hardware, so that its next uplink frames reach mac80211.
+A changed priority is thus learned within one stream timeout.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/mac80211.h
++++ b/include/net/mac80211.h
+@@ -5140,6 +5140,23 @@ struct ieee80211_ops {
+ 				   struct ieee80211_sta *sta,
+ 				   const struct cfg80211_flow_key *key,
+ 				   u32 fields);
++	/**
++	 * @flow_offload_idle:
++	 * Called before a learned MSCS entry of a station expires. Return
++	 * the time in seconds since the hardware last forwarded a frame of
++	 * the flow whose tuple, masked to @fields, equals @key, or a
++	 * negative error when no offloaded entry matches. The learned entry
++	 * then survives as long as the hardware forwards the flow, and
++	 * @flow_offload_flush is called for the flow, so that its next
++	 * frames from the station reach mac80211. Optional.
++	 *
++	 * Called with the wiphy mutex held. This callback may sleep.
++	 */
++	int (*flow_offload_idle)(struct ieee80211_hw *hw,
++				 struct ieee80211_vif *vif,
++				 struct ieee80211_sta *sta,
++				 const struct cfg80211_flow_key *key,
++				 u32 fields);
+ 	int (*set_tid_config)(struct ieee80211_hw *hw,
+ 			      struct ieee80211_vif *vif,
+ 			      struct ieee80211_sta *sta,
+--- a/net/mac80211/driver-ops.h
++++ b/net/mac80211/driver-ops.h
+@@ -1600,6 +1600,32 @@ static inline void drv_flow_offload_flus
+ 	trace_drv_return_void(local);
+ }
+ 
++static inline int drv_flow_offload_idle(struct ieee80211_local *local,
++					struct ieee80211_sub_if_data *sdata,
++					struct sta_info *sta,
++					const struct cfg80211_flow_key *key,
++					u32 fields)
++{
++	int ret;
++
++	might_sleep();
++	lockdep_assert_wiphy(local->hw.wiphy);
++
++	if (!local->ops->flow_offload_idle || !sta->uploaded)
++		return -ENOENT;
++
++	sdata = get_bss_sdata(sdata);
++	if (!check_sdata_in_driver(sdata))
++		return -EIO;
++
++	trace_drv_flow_offload_idle(local, sdata, &sta->sta);
++	ret = local->ops->flow_offload_idle(&local->hw, &sdata->vif, &sta->sta,
++					    key, fields);
++	trace_drv_return_int(local, ret);
++
++	return ret;
++}
++
+ static inline int drv_set_tid_config(struct ieee80211_local *local,
+ 				     struct ieee80211_sub_if_data *sdata,
+ 				     struct ieee80211_sta *sta,
+--- a/net/mac80211/scs.c
++++ b/net/mac80211/scs.c
+@@ -237,11 +237,50 @@ static void ieee80211_flow_purge(struct
+ 	mscs->n_entries = 0;
+ }
+ 
++static struct ieee80211_flow_entry *
++ieee80211_flow_expired_find(struct ieee80211_mscs_sta *mscs)
++{
++	struct ieee80211_flow_entry *entry;
++
++	lockdep_assert_held(&mscs->lock);
++
++	list_for_each_entry(entry, &mscs->entries, list)
++		if (time_after_eq(jiffies, READ_ONCE(entry->last_update) +
++					   mscs->timeout))
++			return entry;
++
++	return NULL;
++}
++
++/*
++ * An expired entry survives while the hardware still forwards its flow. The
++ * offloaded uplink frames do not reach the learn path, so the flow is dropped
++ * from the hardware, and a changed priority is learned from its next frames.
++ */
++static bool ieee80211_flow_entry_refresh(struct ieee80211_sub_if_data *sdata,
++					 struct sta_info *sta,
++					 struct ieee80211_mscs_sta *mscs,
++					 struct ieee80211_flow_entry *entry)
++{
++	int idle;
++
++	idle = drv_flow_offload_idle(sdata->local, sta->sdata, sta,
++				     &entry->hkey.key, mscs->layout);
++	if (idle < 0 || idle * HZ >= mscs->timeout)
++		return false;
++
++	WRITE_ONCE(entry->last_update, jiffies - idle * HZ);
++	drv_flow_offload_flush(sdata->local, sta->sdata, sta, &entry->hkey.key,
++			       mscs->layout);
++
++	return true;
++}
++
+ /* Return the time until the next entry expires, zero when none is left */
+-static unsigned long ieee80211_flow_gc_sta(struct ieee80211_if_ap *ap,
++static unsigned long ieee80211_flow_gc_sta(struct ieee80211_sub_if_data *sdata,
+ 					   struct sta_info *sta)
+ {
+-	struct ieee80211_flow_entry *entry, *tmp;
++	struct ieee80211_flow_entry *entry;
+ 	struct ieee80211_mscs_sta *mscs;
+ 	unsigned long delay = 0;
+ 
+@@ -249,20 +288,35 @@ static unsigned long ieee80211_flow_gc_s
+ 	if (!mscs)
+ 		return 0;
+ 
++	/* Only this work and a new MSCS free entries, both under the wiphy
++	 * lock, so an entry stays valid while the driver is asked about it.
++	 */
++	while (true) {
++		spin_lock_bh(&mscs->lock);
++		entry = ieee80211_flow_expired_find(mscs);
++		spin_unlock_bh(&mscs->lock);
++		if (!entry)
++			break;
++
++		if (ieee80211_flow_entry_refresh(sdata, sta, mscs, entry))
++			continue;
++
++		spin_lock_bh(&mscs->lock);
++		ieee80211_flow_entry_free(&sdata->u.ap, entry);
++		mscs->n_entries--;
++		spin_unlock_bh(&mscs->lock);
++	}
++
+ 	spin_lock_bh(&mscs->lock);
+ 
+-	list_for_each_entry_safe(entry, tmp, &mscs->entries, list) {
++	list_for_each_entry(entry, &mscs->entries, list) {
+ 		unsigned long dead = READ_ONCE(entry->last_update) +
+ 				     mscs->timeout;
++		unsigned long left = time_after(dead, jiffies) ? dead - jiffies
++							       : 1;
+ 
+-		if (time_after_eq(jiffies, dead)) {
+-			ieee80211_flow_entry_free(ap, entry);
+-			mscs->n_entries--;
+-			continue;
+-		}
+-
+-		if (!delay || time_before(dead, jiffies + delay))
+-			delay = dead - jiffies;
++		if (!delay || left < delay)
++			delay = left;
+ 	}
+ 
+ 	spin_unlock_bh(&mscs->lock);
+@@ -286,7 +340,7 @@ static void ieee80211_flow_gc_work(struc
+ 		if (sta->sdata->bss != ap)
+ 			continue;
+ 
+-		sta_delay = ieee80211_flow_gc_sta(ap, sta);
++		sta_delay = ieee80211_flow_gc_sta(sdata, sta);
+ 		if (sta_delay && (!delay || sta_delay < delay))
+ 			delay = sta_delay;
+ 	}
+--- a/net/mac80211/trace.h
++++ b/net/mac80211/trace.h
+@@ -1063,6 +1063,13 @@ DEFINE_EVENT(sta_event, drv_flow_offload
+ 	TP_ARGS(local, sdata, sta)
+ );
+ 
++DEFINE_EVENT(sta_event, drv_flow_offload_idle,
++	TP_PROTO(struct ieee80211_local *local,
++		 struct ieee80211_sub_if_data *sdata,
++		 struct ieee80211_sta *sta),
++	TP_ARGS(local, sdata, sta)
++);
++
+ DEFINE_EVENT(sta_event, drv_sta_statistics,
+ 	TP_PROTO(struct ieee80211_local *local,
+ 		 struct ieee80211_sub_if_data *sdata,
diff --git a/package/kernel/mac80211/patches/subsys/451-wifi-mac80211-do-not-check-the-Beacon-of-another-BSS.patch b/package/kernel/mac80211/patches/subsys/451-wifi-mac80211-do-not-check-the-Beacon-of-another-BSS.patch
new file mode 100644
index 00000000..7b504513
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/451-wifi-mac80211-do-not-check-the-Beacon-of-another-BSS.patch
@@ -0,0 +1,43 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 17 Oct 2026 15:00:00 +0200
+Subject: [PATCH] wifi: mac80211: do not check the Beacon of another BSS with
+ an AP's BIGTK
+
+An AP vif holds the BIGTK of its own links alone. For a Beacon with a
+MME, ieee80211_rx_h_decrypt() takes the BIGTK of the key index from the
+station or from the link, and an OBSS has no station, so the AP's own
+BIGTK checked the OBSS Beacon. The MIC failed (RX_DROP_U_MIC_FAIL)
+before ieee80211_rx_h_mgmt_check(), so no OBSS Beacon with beacon
+protection reached cfg80211_report_obss_beacon_khz() and hostapd never
+learned such a neighbour, for example its BSS Color.
+
+Let a Beacon whose transmitter is none of the AP's own addresses go on
+without a key, so that ieee80211_rx_h_mgmt_check() reports it. Beacons
+of the AP's own links, and every Beacon on a non-AP interface, take the
+BIGTK as before. ieee80211_drop_unencrypted_mgmt() is unchanged.
+
+ieee80211_rx_h_mgmt_check() also runs the software BSS Color collision
+check, ieee80211_rx_check_bss_color_collision(), on the Beacons it now
+receives. A neighbour with beacon protection and the AP's own colour
+now raises a colour collision, as an unprotected one does.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/rx.c
++++ b/net/mac80211/rx.c
+@@ -2107,6 +2107,15 @@ ieee80211_rx_h_decrypt(struct ieee80211_
+ 		    (status->flag & RX_FLAG_IV_STRIPPED))
+ 			return RX_CONTINUE;
+ 
++		/*
++		 * An AP holds the BIGTK of its own links alone. The Beacon of
++		 * another BSS goes on unverified to ieee80211_rx_h_mgmt_check(),
++		 * which reports it as an OBSS Beacon.
++		 */
++		if (rx->sdata->vif.type == NL80211_IFTYPE_AP &&
++		    !ieee80211_is_our_addr(rx->sdata, hdr->addr2, NULL))
++			return RX_CONTINUE;
++
+ 		if (mmie_keyidx < NUM_DEFAULT_KEYS + NUM_DEFAULT_MGMT_KEYS ||
+ 		    mmie_keyidx >= NUM_DEFAULT_KEYS + NUM_DEFAULT_MGMT_KEYS +
+ 				   NUM_DEFAULT_BEACON_KEYS) {
diff --git a/package/kernel/mac80211/patches/subsys/454-wifi-mac80211-remove-AP-VLAN-frames-from-station-TXQ.patch b/package/kernel/mac80211/patches/subsys/454-wifi-mac80211-remove-AP-VLAN-frames-from-station-TXQ.patch
new file mode 100644
index 00000000..a729ae85
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/454-wifi-mac80211-remove-AP-VLAN-frames-from-station-TXQ.patch
@@ -0,0 +1,202 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Fri, 23 Oct 2026 11:40:33 +0200
+Subject: [PATCH] wifi: mac80211: remove AP VLAN frames from station TXQs on
+ ifdown
+
+Since commit 531682159092 ("mac80211: fix VLAN handling with TXQs"), a
+queued frame keeps its AP VLAN in info->control.vif, and
+ieee80211_tx_dequeue() maps it to the AP through sdata->bss. When an AP
+VLAN goes down, ieee80211_txq_remove_vlan() removes its frames from the
+TXQ of the AP alone. A station that left the VLAN keeps the frames that
+were queued through it in its own TXQs, and ieee80211_do_stop() does not
+flush that station. hostapd does this when it removes a 4-address
+station: it moves the station back to the BSS interface, then deletes
+the VLAN. ieee80211_do_stop() then sets sdata->bss to NULL, and the next
+dequeue of such a frame dereferences it:
+
+  Unable to handle kernel read from unreadable memory at virtual address 00000000000011a0
+  pc : ieee80211_calc_expected_tx_airtime+0x8/0xd0 [mac80211]
+  lr : ieee80211_tx_dequeue+0xa70/0x191c [mac80211]
+  Call trace:
+   ieee80211_calc_expected_tx_airtime+0x8/0xd0 [mac80211] (P)
+   mt76_txq_send_burst+0xa8/0x2d0 [mt76]
+   mt76_txq_schedule.part.0+0x210/0x268 [mt76]
+   mt76_tx_worker+0x60/0xf0 [mt76]
+
+When an AP VLAN goes down, remove its frames from the TXQs of the AP and
+of every station of the BSS, fragment queues included, and from the
+power save and filtered frame buffers of those stations. Then wait for
+an RCU grace period before sdata->bss is cleared, since a dequeue that
+took a frame of the VLAN before the removal still reads sdata->bss.
+Such a dequeue can also queue the further fragments of the frame, so
+remove the frames of the VLAN again after the grace period.
+
+Fixes: 531682159092 ("mac80211: fix VLAN handling with TXQs")
+Cc: stable@vger.kernel.org
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/iface.c
++++ b/net/mac80211/iface.c
+@@ -712,8 +712,15 @@ static void ieee80211_do_stop(struct iee
+ 		ieee80211_free_txskb(&local->hw, skb);
+ 	}
+ 
+-	if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN)
++	if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN) {
+ 		ieee80211_txq_remove_vlan(local, sdata);
++		/*
++		 * A TXQ dequeue can hold a frame of this VLAN, read sdata->bss
++		 * and queue the further fragments of the frame.
++		 */
++		synchronize_rcu();
++		ieee80211_txq_remove_vlan(local, sdata);
++	}
+ 
+ 	if (sdata->vif.txq)
+ 		ieee80211_txq_purge(sdata->local, to_txq_info(sdata->vif.txq));
+--- a/net/mac80211/tx.c
++++ b/net/mac80211/tx.c
+@@ -1506,38 +1506,129 @@ static void ieee80211_txq_enqueue(struct
+ 	spin_unlock_bh(&fq->lock);
+ }
+ 
++static bool ieee80211_skb_is_vlan(struct sk_buff *skb,
++				  struct ieee80211_vif *vlan)
++{
++	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
++
++	return info->control.vif == vlan;
++}
++
+ static bool fq_vlan_filter_func(struct fq *fq, struct fq_tin *tin,
+ 				struct fq_flow *flow, struct sk_buff *skb,
+ 				void *data)
+ {
+-	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
++	return ieee80211_skb_is_vlan(skb, data);
++}
+ 
+-	return info->control.vif == data;
++static void ieee80211_txqi_remove_vlan(struct ieee80211_local *local,
++				       struct txq_info *txqi,
++				       struct ieee80211_vif *vlan)
++{
++	struct fq *fq = &local->fq;
++	struct sk_buff *skb, *tmp;
++
++	spin_lock_bh(&fq->lock);
++	fq_tin_filter(fq, &txqi->tin, fq_vlan_filter_func, vlan,
++		      fq_skb_free_func);
++	skb_queue_walk_safe(&txqi->frags, skb, tmp) {
++		if (!ieee80211_skb_is_vlan(skb, vlan))
++			continue;
++
++		__skb_unlink(skb, &txqi->frags);
++		ieee80211_free_txskb(&local->hw, skb);
++	}
++	spin_unlock_bh(&fq->lock);
++}
++
++static int ieee80211_skb_queue_remove_vlan(struct ieee80211_local *local,
++					   struct sk_buff_head *queue,
++					   struct ieee80211_vif *vlan)
++{
++	struct sk_buff_head freeq;
++	struct sk_buff *skb, *tmp;
++	unsigned long flags;
++	int removed;
++
++	__skb_queue_head_init(&freeq);
++
++	spin_lock_irqsave(&queue->lock, flags);
++	skb_queue_walk_safe(queue, skb, tmp) {
++		if (!ieee80211_skb_is_vlan(skb, vlan))
++			continue;
++
++		__skb_unlink(skb, queue);
++		__skb_queue_tail(&freeq, skb);
++	}
++	spin_unlock_irqrestore(&queue->lock, flags);
++
++	removed = skb_queue_len(&freeq);
++	while ((skb = __skb_dequeue(&freeq)))
++		ieee80211_free_txskb(&local->hw, skb);
++
++	return removed;
++}
++
++static void ieee80211_sta_remove_vlan(struct ieee80211_local *local,
++				      struct sta_info *sta,
++				      struct ieee80211_vif *vlan)
++{
++	bool buffered_removed = false;
++	int i, ac, removed;
++
++	for (i = 0; i < ARRAY_SIZE(sta->sta.txq); i++) {
++		if (!sta->sta.txq[i])
++			continue;
++
++		ieee80211_txqi_remove_vlan(local, to_txq_info(sta->sta.txq[i]),
++					   vlan);
++	}
++
++	for (ac = 0; ac < IEEE80211_NUM_ACS; ac++) {
++		removed = ieee80211_skb_queue_remove_vlan(local,
++							  &sta->ps_tx_buf[ac],
++							  vlan);
++		local->total_ps_buffered -= removed;
++		if (removed)
++			buffered_removed = true;
++
++		if (ieee80211_skb_queue_remove_vlan(local, &sta->tx_filtered[ac],
++						    vlan))
++			buffered_removed = true;
++	}
++
++	if (buffered_removed)
++		sta_info_recalc_tim(sta);
+ }
+ 
+ void ieee80211_txq_remove_vlan(struct ieee80211_local *local,
+ 			       struct ieee80211_sub_if_data *sdata)
+ {
+-	struct fq *fq = &local->fq;
+-	struct txq_info *txqi;
+-	struct fq_tin *tin;
+ 	struct ieee80211_sub_if_data *ap;
++	struct sta_info *sta;
++
++	lockdep_assert_wiphy(local->hw.wiphy);
+ 
+ 	if (WARN_ON(sdata->vif.type != NL80211_IFTYPE_AP_VLAN))
+ 		return;
+ 
+ 	ap = container_of(sdata->bss, struct ieee80211_sub_if_data, u.ap);
+ 
+-	if (!ap->vif.txq)
+-		return;
+-
+-	txqi = to_txq_info(ap->vif.txq);
+-	tin = &txqi->tin;
++	if (ap->vif.txq)
++		ieee80211_txqi_remove_vlan(local, to_txq_info(ap->vif.txq),
++					   &sdata->vif);
++
++	if (ap->vif.txq_mgmt)
++		ieee80211_txqi_remove_vlan(local, to_txq_info(ap->vif.txq_mgmt),
++					   &sdata->vif);
++
++	/* a station that left this VLAN keeps the frames queued through it */
++	list_for_each_entry(sta, &local->sta_list, list) {
++		if (sta->sdata->bss != sdata->bss)
++			continue;
+ 
+-	spin_lock_bh(&fq->lock);
+-	fq_tin_filter(fq, tin, fq_vlan_filter_func, &sdata->vif,
+-		      fq_skb_free_func);
+-	spin_unlock_bh(&fq->lock);
++		ieee80211_sta_remove_vlan(local, sta, &sdata->vif);
++	}
+ }
+ 
+ void ieee80211_txq_init(struct ieee80211_sub_if_data *sdata,
diff --git a/package/kernel/mac80211/patches/subsys/455-wifi-nl80211-report-the-expiry-of-an-offloaded-AP-Re.patch b/package/kernel/mac80211/patches/subsys/455-wifi-nl80211-report-the-expiry-of-an-offloaded-AP-Re.patch
new file mode 100644
index 00000000..4b418e84
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/455-wifi-nl80211-report-the-expiry-of-an-offloaded-AP-Re.patch
@@ -0,0 +1,115 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Thu, 22 Oct 2026 20:00:00 +0200
+Subject: [PATCH] wifi: nl80211: report the expiry of an offloaded AP Removal
+ Timer
+
+An AP MLD announces the removal of an affiliated AP in the Beacon frames
+of all its links with a Reconfiguration Multi-Link element, whose AP
+Removal Timer counts the TBTTs to the removal (IEEE 802.11be-2024
+35.3.6.3). User space sees no TBTT, so it updates the beacons of every
+link at each beacon interval to count the timer. A device that takes
+each new template as a new critical update then keeps the Critical
+Update flag set for the whole countdown, past the DTIM Beacon frame that
+ends it (35.3.10).
+
+Add an extended feature with which the driver declares that it counts
+the timer in the Beacon frames itself, and let it report the expiry with
+NL80211_CMD_LINKS_REMOVED on the AP interface. The links stay valid,
+because user space removes them after the frames that the removal needs.
+The driver can keep later beacon updates from the device until the
+expiry, since a device can take the timer of each new template as its
+new start.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -11074,6 +11074,10 @@ cfg80211_6ghz_power_type(u8 control, u32
+  * AP MLD removing the corresponding affiliated APs with Multi-Link
+  * reconfiguration. Note that it's not valid to remove all links, in this
+  * case disconnect instead.
++ * On an AP interface, a driver with
++ * %NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD calls it when the AP Removal
++ * Timer of the affiliated APs of @link_mask expired. The links stay valid
++ * until user space removes them.
+  * Also note that the wdev mutex must be held.
+  */
+ void cfg80211_links_removed(struct net_device *dev, u16 link_mask);
+--- a/net/wireless/nl80211.c
++++ b/net/wireless/nl80211.c
+@@ -21969,23 +21969,32 @@ void cfg80211_links_removed(struct net_d
+ 	struct wiphy *wiphy = wdev->wiphy;
+ 	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wiphy);
+ 	struct sk_buff *msg;
++	bool ap = wdev->iftype == NL80211_IFTYPE_AP;
+ 	struct nlattr *links;
+ 	void *hdr;
+ 
+ 	lockdep_assert_wiphy(wdev->wiphy);
+ 	trace_cfg80211_links_removed(dev, link_mask);
+ 
+-	if (WARN_ON(wdev->iftype != NL80211_IFTYPE_STATION &&
+-		    wdev->iftype != NL80211_IFTYPE_P2P_CLIENT))
++	if (ap) {
++		if (WARN_ON(!wiphy_ext_feature_isset(wiphy,
++				NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD)))
++			return;
++	} else if (WARN_ON(wdev->iftype != NL80211_IFTYPE_STATION &&
++			   wdev->iftype != NL80211_IFTYPE_P2P_CLIENT)) {
+ 		return;
++	}
+ 
+ 	if (WARN_ON(!wdev->valid_links || !link_mask ||
+ 		    (wdev->valid_links & link_mask) != link_mask ||
+ 		    wdev->valid_links == link_mask))
+ 		return;
+ 
+-	cfg80211_wdev_release_link_bsses(wdev, link_mask);
+-	wdev->valid_links &= ~link_mask;
++	/* user space removes the links of an AP */
++	if (!ap) {
++		cfg80211_wdev_release_link_bsses(wdev, link_mask);
++		wdev->valid_links &= ~link_mask;
++	}
+ 
+ 	msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
+ 	if (!msg)
+--- a/include/uapi/linux/nl80211.h
++++ b/include/uapi/linux/nl80211.h
+@@ -1333,6 +1333,10 @@
+  *	setup links due to AP MLD removing the corresponding affiliated APs with
+  *	Multi-Link reconfiguration. %NL80211_ATTR_MLO_LINKS is used to provide
+  *	information about the removed STA MLD setup links.
++ *	On an AP interface, with %NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD,
++ *	it reports that the AP Removal Timer of the affiliated APs of the links
++ *	in %NL80211_ATTR_MLO_LINKS expired; the links stay until user space
++ *	removes them.
+  *
+  * @NL80211_CMD_SET_TID_TO_LINK_MAPPING: Set the TID to Link Mapping for a
+  *      non-AP MLD station. The %NL80211_ATTR_MLO_TTLM_DLINK and
+@@ -7383,6 +7387,17 @@ enum nl80211_feature_flags {
+  *	service, configured with %NL80211_CMD_SET_SCS.
+  * @NL80211_EXT_FEATURE_MSCS: Driver supports the mirrored stream
+  *	classification service, configured with %NL80211_CMD_SET_MSCS.
++ * @NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD: The driver counts the AP
++ *	Removal Timer of an affiliated AP that a Reconfiguration Multi-Link
++ *	element in the beacon of an AP MLD link announces (IEEE 802.11be-2024,
++ *	35.3.6.3), in the Beacon frames of every link that carries the element,
++ *	and reports its expiry with %NL80211_CMD_LINKS_REMOVED on the AP
++ *	interface. User space sets the beacons with the element once. Until
++ *	the expiry, the driver can keep later beacon updates of the links of
++ *	the AP MLD from the device, so user space sets the beacons of the links
++ *	that stay again after the event. The expiry comes before the TBTT at
++ *	which the timer reaches 0, and the removed links keep running until
++ *	user space stops them.
+  *
+  * @NUM_NL80211_EXT_FEATURES: number of extended features.
+  * @MAX_NL80211_EXT_FEATURES: highest extended feature index.
+@@ -7472,6 +7487,7 @@ enum nl80211_ext_feature_index {
+ 	NL80211_EXT_FEATURE_AP_ADV_TTLM,
+ 	NL80211_EXT_FEATURE_SCS,
+ 	NL80211_EXT_FEATURE_MSCS,
++	NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD,
+ 
+ 	/* add new features before the definition below */
+ 	NUM_NL80211_EXT_FEATURES,
diff --git a/package/kernel/mac80211/patches/subsys/456-wifi-mac80211-let-a-driver-report-the-expiry-of-an-A.patch b/package/kernel/mac80211/patches/subsys/456-wifi-mac80211-let-a-driver-report-the-expiry-of-an-A.patch
new file mode 100644
index 00000000..04a89a0f
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/456-wifi-mac80211-let-a-driver-report-the-expiry-of-an-A.patch
@@ -0,0 +1,121 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Thu, 22 Oct 2026 20:00:00 +0200
+Subject: [PATCH] wifi: mac80211: let a driver report the expiry of an AP
+ Removal Timer
+
+A driver with NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD learns of the
+expiry from a device event, which can come in atomic context, while
+cfg80211_links_removed() needs the wiphy mutex.
+
+Add ieee80211_links_removed(), which reports the links from a wiphy
+work. A link that user space removed before the work runs is left out,
+since cfg80211 no longer holds it. The driver can report links until it
+removes the interface, which comes after the stop of the interface, so
+the teardown of the interface cancels the work as well.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/include/net/mac80211.h
++++ b/include/net/mac80211.h
+@@ -6126,6 +6126,21 @@ void ieee80211_crit_update_done(struct i
+ 				unsigned int link_id, u32 crit_update_id);
+ 
+ /**
++ * ieee80211_links_removed - notify mac80211 that an AP Removal Timer expired
++ * @vif: &struct ieee80211_vif pointer from the add_interface callback.
++ * @links: bitmap of the link IDs of the affiliated APs whose timer expired
++ *
++ * A driver with %NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD calls this for
++ * an AP MLD when the AP Removal Timer that the Reconfiguration Multi-Link
++ * element of its beacon templates announces expired. mac80211 reports it with
++ * %NL80211_CMD_LINKS_REMOVED, leaves the links running and ignores a link that
++ * user space removed before the report.
++ *
++ * This function can be called from any context.
++ */
++void ieee80211_links_removed(struct ieee80211_vif *vif, u16 links);
++
++/**
+  * ieee80211_proberesp_get - retrieve a Probe Response template
+  * @hw: pointer obtained from ieee80211_alloc_hw().
+  * @vif: &struct ieee80211_vif pointer from the add_interface callback.
+--- a/net/mac80211/ieee80211_i.h
++++ b/net/mac80211/ieee80211_i.h
+@@ -1293,6 +1293,10 @@ struct ieee80211_sub_if_data {
+ 	struct wiphy_work activate_links_work;
+ 	u16 desired_active_links;
+ 
++	/* for ieee80211_links_removed() */
++	struct wiphy_work links_removed_work;
++	atomic_t links_removed;
++
+ 	u16 restart_active_links;
+ 
+ #ifdef CPTCFG_MAC80211_DEBUGFS
+--- a/net/mac80211/iface.c
++++ b/net/mac80211/iface.c
+@@ -877,6 +877,8 @@ static int ieee80211_stop(struct net_dev
+ 	guard(wiphy)(sdata->local->hw.wiphy);
+ 
+ 	wiphy_work_cancel(sdata->local->hw.wiphy, &sdata->activate_links_work);
++	wiphy_work_cancel(sdata->local->hw.wiphy, &sdata->links_removed_work);
++	atomic_set(&sdata->links_removed, 0);
+ 
+ 	/* Close the dependent MBSSID interfaces with wiphy lock as we may be
+ 	 * terminating its partner links too in case of MLD.
+@@ -921,6 +923,9 @@ static void ieee80211_teardown_sdata(str
+ 	if (WARN_ON(!list_empty(&sdata->work.entry)))
+ 		wiphy_work_cancel(sdata->local->hw.wiphy, &sdata->work);
+ 
++	/* the driver can report links until it removes the interface */
++	wiphy_work_cancel(sdata->local->hw.wiphy, &sdata->links_removed_work);
++
+ 	/* free extra data */
+ 	ieee80211_free_keys(sdata, false);
+ 
+@@ -1909,6 +1914,35 @@ static void ieee80211_activate_links_wor
+ 	sdata->desired_active_links = 0;
+ }
+ 
++static void ieee80211_links_removed_work(struct wiphy *wiphy,
++					 struct wiphy_work *work)
++{
++	struct ieee80211_sub_if_data *sdata =
++		container_of(work, struct ieee80211_sub_if_data,
++			     links_removed_work);
++	u16 links = atomic_xchg(&sdata->links_removed, 0);
++	u16 valid_links = sdata->wdev.valid_links;
++
++	/* a link that user space removed meanwhile is gone already */
++	links &= valid_links;
++	if (!ieee80211_sdata_running(sdata) || !links || links == valid_links)
++		return;
++
++	cfg80211_links_removed(sdata->dev, links);
++}
++
++void ieee80211_links_removed(struct ieee80211_vif *vif, u16 links)
++{
++	struct ieee80211_sub_if_data *sdata = vif_to_sdata(vif);
++
++	if (WARN_ON(vif->type != NL80211_IFTYPE_AP || !links))
++		return;
++
++	atomic_or(links, &sdata->links_removed);
++	wiphy_work_queue(sdata->local->hw.wiphy, &sdata->links_removed_work);
++}
++EXPORT_SYMBOL_GPL(ieee80211_links_removed);
++
+ /*
+  * Helper function to initialise an interface to a specific type.
+  */
+@@ -1947,6 +1981,9 @@ static void ieee80211_setup_sdata(struct
+ 	wiphy_work_init(&sdata->work, ieee80211_iface_work);
+ 	wiphy_work_init(&sdata->activate_links_work,
+ 			ieee80211_activate_links_work);
++	wiphy_work_init(&sdata->links_removed_work,
++			ieee80211_links_removed_work);
++	atomic_set(&sdata->links_removed, 0);
+ 
+ 	switch (type) {
+ 	case NL80211_IFTYPE_P2P_GO:
diff --git a/package/kernel/mac80211/patches/subsys/457-wifi-mac80211-use-the-AP-interface-for-link-changes-.patch b/package/kernel/mac80211/patches/subsys/457-wifi-mac80211-use-the-AP-interface-for-link-changes-.patch
new file mode 100644
index 00000000..2e80e4d8
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/457-wifi-mac80211-use-the-AP-interface-for-link-changes-.patch
@@ -0,0 +1,40 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Fri, 23 Oct 2026 23:46:03 +0200
+Subject: [PATCH] wifi: mac80211: use the AP interface for link changes of a VLAN
+ station
+
+ieee80211_sta_activate_link() and ieee80211_sta_remove_link() pass
+sta->sdata to drv_change_sta_links(). For a station on an AP VLAN this
+is the VLAN, which is never added to the driver, so
+check_sdata_in_driver() fails and the call returns -EIO:
+
+  wlan7.sta1: Failed check-sdata-in-driver check, flags: 0x0
+  WARNING: net/mac80211/driver-ops.c:596 at drv_change_sta_links+0x189/0x1c0
+  Call Trace:
+   ieee80211_sta_remove_link+0x56/0x70
+   ieee80211_del_link_station+0x43/0x70
+   nl80211_remove_link_station+0x8a/0xc0
+
+mac80211 then drops the link while the driver keeps it, and a link
+addition for such a station fails. Reachable via
+ieee80211_add_link_station() and ieee80211_del_link_station() for a
+4-address non-AP MLD that hostapd keeps on its WDS VLAN while it adds
+or removes one of its links.
+
+Map an AP VLAN to its AP before the check, as drv_sta_state() and the
+other station operations already do.
+
+Fixes: cb71f1d136a6 ("wifi: mac80211: add sta link addition/removal")
+Cc: stable@vger.kernel.org
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/driver-ops.c
++++ b/net/mac80211/driver-ops.c
+@@ -597,6 +597,7 @@ int drv_change_sta_links(struct ieee8021
+ 	might_sleep();
+ 	lockdep_assert_wiphy(local->hw.wiphy);
+ 
++	sdata = get_bss_sdata(sdata);
+ 	if (!check_sdata_in_driver(sdata))
+ 		return -EIO;
+ 
diff --git a/package/kernel/mac80211/patches/subsys/458-wifi-mac80211-send-MLO-group-frames-only-on-links-wi.patch b/package/kernel/mac80211/patches/subsys/458-wifi-mac80211-send-MLO-group-frames-only-on-links-wi.patch
new file mode 100644
index 00000000..f6b57dec
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/458-wifi-mac80211-send-MLO-group-frames-only-on-links-wi.patch
@@ -0,0 +1,109 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 02:40:00 +0200
+Subject: [PATCH] wifi: mac80211: send MLO group frames only on links with a
+ running AP
+
+ieee80211_mlo_multicast_tx() sends a copy of each group addressed frame
+on every link in vif.active_links. ieee80211_stop_ap() for one link of
+an AP MLD keeps that link in active_links until the link itself goes,
+so the copy for the stopped link reaches a driver without a channel
+context for it. mac80211_hwsim warns:
+
+  TX w/o channel - queue = 0
+  WARNING: drivers/net/wireless/virtual/mac80211_hwsim_main.c:2623 at mac80211_hwsim_tx+0x7d4/0xbd0
+  Call Trace:
+   ieee80211_hwsim_wake_tx_queue+0x44/0x90
+   ieee80211_queue_skb+0x1c5/0x370
+   ieee80211_tx+0xd2/0x140
+   __ieee80211_subif_start_xmit+0x1cf/0x3f0
+   ieee80211_mlo_multicast_tx+0x7b/0xe0
+   ieee80211_subif_start_xmit+0xc4/0x180
+
+Reachable whenever user space stops one link of an AP MLD and removes
+the link later, as OpenWrt's hostapd does for an AP removal
+(IEEE 802.11be-2024 35.3.6.3): it stops the link at the removal TBTT.
+
+Send the copies only on links whose AP has a beacon, taken from the AP
+interface so that an AP VLAN follows the links of its AP. With no such
+link, drop the frame. A copy can wait in the TXQ of the interface while
+the AP of its link stops, so ieee80211_tx_dequeue() drops such a copy
+as well.
+
+Fixes: 963d0e8d08d9 ("wifi: mac80211: optionally implement MLO multicast TX")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/net/mac80211/tx.c
++++ b/net/mac80211/tx.c
+@@ -4042,6 +4042,32 @@ static bool ieee80211_drop_unauth_port(s
+ 	return true;
+ }
+ 
++/* a stopped link of an AP MLD stays in active_links until the link goes */
++static bool ieee80211_ap_link_running(struct ieee80211_sub_if_data *sdata,
++				      unsigned int link_id)
++{
++	struct ieee80211_sub_if_data *ap = container_of(sdata->bss,
++					   struct ieee80211_sub_if_data, u.ap);
++	struct ieee80211_link_data *link = rcu_dereference(ap->link[link_id]);
++
++	return link && rcu_access_pointer(link->u.ap.beacon);
++}
++
++/* the AP of the link of a group addressed frame can stop after the enqueue */
++static bool ieee80211_tx_link_stopped(struct ieee80211_sub_if_data *sdata,
++				      struct ieee80211_tx_info *info)
++{
++	unsigned int link_id = u32_get_bits(info->control.flags,
++					    IEEE80211_TX_CTRL_MLO_LINK);
++
++	if (link_id == IEEE80211_LINK_UNSPECIFIED ||
++	    (sdata->vif.type != NL80211_IFTYPE_AP &&
++	     sdata->vif.type != NL80211_IFTYPE_AP_VLAN))
++		return false;
++
++	return !ieee80211_ap_link_running(sdata, link_id);
++}
++
+ struct sk_buff *ieee80211_tx_dequeue(struct ieee80211_hw *hw,
+ 				     struct ieee80211_txq *txq)
+ {
+@@ -4106,6 +4132,11 @@ begin:
+ 	tx.skb = skb;
+ 	tx.sdata = vif_to_sdata(info->control.vif);
+ 
++	if (!txq->sta && ieee80211_tx_link_stopped(tx.sdata, info)) {
++		ieee80211_free_txskb(&local->hw, skb);
++		goto begin;
++	}
++
+ 	if (txq->sta) {
+ 		tx.sta = container_of(txq->sta, struct sta_info, sta);
+ 
+@@ -4723,11 +4754,26 @@ static void ieee80211_mlo_multicast_tx_o
+ 	__ieee80211_subif_start_xmit(out, sdata->dev, 0, ctrl_flags, NULL);
+ }
+ 
++static u16 ieee80211_mlo_multicast_links(struct ieee80211_sub_if_data *sdata)
++{
++	unsigned long active = sdata->vif.active_links;
++	unsigned int link_id;
++	u16 links = 0;
++
++	rcu_read_lock();
++	for_each_set_bit(link_id, &active, IEEE80211_MLD_MAX_NUM_LINKS)
++		if (ieee80211_ap_link_running(sdata, link_id))
++			links |= BIT(link_id);
++	rcu_read_unlock();
++
++	return links;
++}
++
+ static void ieee80211_mlo_multicast_tx(struct net_device *dev,
+ 				       struct sk_buff *skb)
+ {
+ 	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
+-	unsigned long links = sdata->vif.active_links;
++	unsigned long links = ieee80211_mlo_multicast_links(sdata);
+ 	unsigned int link;
+ 	u32 ctrl_flags = IEEE80211_TX_CTRL_MCAST_MLO_FIRST_TX;
+ 
diff --git a/package/kernel/mac80211/patches/subsys/459-wifi-mac80211-free-the-link-data-of-a-refused-link-r.patch b/package/kernel/mac80211/patches/subsys/459-wifi-mac80211-free-the-link-data-of-a-refused-link-r.patch
new file mode 100644
index 00000000..cfb93346
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/459-wifi-mac80211-free-the-link-data-of-a-refused-link-r.patch
@@ -0,0 +1,37 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 02:45:00 +0200
+Subject: [PATCH] wifi: mac80211: free the link data of a refused link
+ reconfiguration
+
+When the AP MLD refuses every link that a Link Reconfiguration Request
+adds, ieee80211_process_ml_reconf_resp() clears each bit of
+added_links and goes to ieee80211_ml_reconf_reset(). That returns early
+because added_links and removed_links are both 0, so it neither frees
+reconf.add_links_data nor calls cfg80211_mlo_reconf_add_done(), and
+the BSS references of the request stay held. The reset in
+ieee80211_set_disassoc() returns early in the same way. Each later
+authentication then takes its link address from the stale data in
+ieee80211_mgd_setup_link(): a link outside the refused request gets
+the address 00:00:00:00:00:00, and the AP drops the frame.
+
+Also reset the reconfiguration state while add_links_data is set. As
+on a timeout or a disconnection during a reconfiguration, cfg80211 then
+gets the done notification without a frame and releases the BSS
+references.
+
+Fixes: 36e05b0b8390 ("wifi: mac80211: Support dynamic link addition and removal")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/net/mac80211/mlme.c
++++ b/net/mac80211/mlme.c
+@@ -4517,8 +4517,8 @@ static void ieee80211_ml_reconf_reset(st
+ 		sdata->u.mgd.reconf.add_links_data;
+ 
+ 	if (!ieee80211_vif_is_mld(&sdata->vif) ||
+-	    !(sdata->u.mgd.reconf.added_links |
+-	      sdata->u.mgd.reconf.removed_links))
++	    (!(sdata->u.mgd.reconf.added_links |
++	       sdata->u.mgd.reconf.removed_links) && !add_links_data))
+ 		return;
+ 
+ 	wiphy_delayed_work_cancel(sdata->local->hw.wiphy,
diff --git a/package/kernel/mac80211/patches/subsys/460-wifi-mac80211-compute-the-links-of-each-AP-VLAN-on-i.patch b/package/kernel/mac80211/patches/subsys/460-wifi-mac80211-compute-the-links-of-each-AP-VLAN-on-i.patch
