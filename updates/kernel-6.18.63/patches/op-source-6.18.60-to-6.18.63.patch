++void nl80211_adv_ttlm_stop(struct cfg80211_registered_device *rdev,
++			   struct wireless_dev *wdev)
++{
++	struct cfg80211_adv_ttlm_event event = {
++		.cmd = NL80211_CMD_ADV_TTLM_ENDED,
++	};
++	unsigned long flags;
++	struct sk_buff *msg;
++
++	spin_lock_irqsave(&wdev->event_lock, flags);
++	event.cookie = atomic64_xchg(&wdev->u.ap.adv_ttlm_cookie, 0);
++	spin_unlock_irqrestore(&wdev->event_lock, flags);
++	if (!event.cookie)
++		return;
++
++	rdev_adv_ttlm_cancel(rdev, wdev->netdev, event.cookie);
++
++	msg = nl80211_adv_ttlm_msg(wdev->netdev, &event, GFP_KERNEL);
++	if (msg)
++		nl80211_send_adv_ttlm(wdev->netdev, msg, GFP_KERNEL);
++}
