+@@ -151,6 +175,7 @@ u16 ieee80211_select_queue(struct ieee80
+ 	const struct ethhdr *eth = (void *)skb->data;
+ 	struct mac80211_qos_map *qos_map;
+ 	bool qos;
++	u16 ac;
+ 
+ 	/* Ensure hash is set prior to potential SW encryption */
+ 	skb_get_hash(skb);
+@@ -192,7 +217,11 @@ u16 ieee80211_select_queue(struct ieee80
+ 					       &qos_map->qos_map : NULL);
+ 
+  downgrade:
+-	return ieee80211_downgrade_queue(sdata, sta, skb);
++	ac = ieee80211_downgrade_queue(sdata, sta, skb);
++	if (ctrl_flags && !ieee80211_prio_follows_dscp(skb))
++		*ctrl_flags |= IEEE80211_TX_CTRL_EXPLICIT_UP;
++
++	return ac;
+ }
+ 
+ /**
diff --git a/package/kernel/mac80211/patches/subsys/476-wifi-nl80211-set-the-TID-to-link-mapping-of-a-statio.patch b/package/kernel/mac80211/patches/subsys/476-wifi-nl80211-set-the-TID-to-link-mapping-of-a-statio.patch
new file mode 100644
index 00000000..c96bed30
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/476-wifi-nl80211-set-the-TID-to-link-mapping-of-a-statio.patch
@@ -0,0 +1,197 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 27 Oct 2026 13:38:05 +0000
+Subject: [PATCH] wifi: nl80211: set the TID-to-link mapping of a station of an
+ AP MLD
+
+An AP MLD that supports TID-to-link mapping negotiation (IEEE
+802.11be-2024, 35.3.7.2.3) agrees on a mapping with an associated
+non-AP MLD and then sends the frames of each TID only on the links that
+the mapping gives for it. User space negotiates the mapping, but
+NL80211_CMD_SET_TID_TO_LINK_MAPPING sets a mapping only on a non-AP MLD
+interface, so the driver of an AP MLD never learns it.
+
+Accept the command on an AP interface as well, with the MLD address of
+the station in NL80211_ATTR_MAC. Without the two mapping attributes the
+default mapping applies again, which is the result of a teardown. Add
+an extended feature with which the driver declares that it applies
+such a mapping. The TID-To-Link Mapping Negotiation Support subfield in
+the MLD capabilities of the AP interface type does not tell it:
+mac80211_hwsim sets that subfield without applying any mapping.
+
+Co-developed-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
+Signed-off-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -5561,6 +5561,10 @@ struct mgmt_frame_regs {
+  *
+  * @set_hw_timestamp: Enable/disable HW timestamping of TM/FTM frames.
+  * @set_ttlm: set the TID to link mapping.
++ * @set_sta_ttlm: for an AP MLD, set the negotiated TID-to-link mapping of the
++ *	associated non-AP MLD with the given MLD address; %NULL @params sets
++ *	the default mapping. See %NL80211_CMD_SET_TID_TO_LINK_MAPPING.
++ *	(invoked with the wiphy mutex held)
+  * @adv_ttlm_request: advertise a TID-to-link mapping of an AP MLD, see
+  *	%NL80211_CMD_ADV_TTLM_REQUEST. cfg80211 calls it only while no mapping
+  *	is requested or established. (invoked with the wiphy mutex held)
+@@ -5964,6 +5968,9 @@ struct cfg80211_ops {
+ 				    struct cfg80211_set_hw_timestamp *hwts);
+ 	int	(*set_ttlm)(struct wiphy *wiphy, struct net_device *dev,
+ 			    struct cfg80211_ttlm_params *params);
++	int	(*set_sta_ttlm)(struct wiphy *wiphy, struct net_device *dev,
++				const u8 *mac,
++				struct cfg80211_ttlm_params *params);
+ 	int	(*adv_ttlm_request)(struct wiphy *wiphy, struct net_device *dev,
+ 				    struct cfg80211_adv_ttlm_params *params);
+ 	void	(*adv_ttlm_cancel)(struct wiphy *wiphy, struct net_device *dev,
+--- a/net/wireless/nl80211.c
++++ b/net/wireless/nl80211.c
+@@ -19715,6 +19715,38 @@ static int nl80211_set_hw_timestamp(stru
+ }
+ 
+ static int
++nl80211_set_sta_ttlm(struct cfg80211_registered_device *rdev,
++		     struct net_device *dev, struct genl_info *info)
++{
++	struct nlattr *dlink = info->attrs[NL80211_ATTR_MLO_TTLM_DLINK];
++	struct nlattr *ulink = info->attrs[NL80211_ATTR_MLO_TTLM_ULINK];
++	struct wireless_dev *wdev = dev->ieee80211_ptr;
++	struct cfg80211_ttlm_params params = {};
++
++	if (!wiphy_ext_feature_isset(&rdev->wiphy,
++				     NL80211_EXT_FEATURE_AP_NEG_TTLM))
++		return -EOPNOTSUPP;
++
++	if (!wdev->valid_links)
++		return -EINVAL;
++
++	if (!info->attrs[NL80211_ATTR_MAC] || !dlink != !ulink)
++		return -EINVAL;
++
++	if (!dlink)
++		return rdev_set_sta_ttlm(rdev, dev,
++					 nla_data(info->attrs[NL80211_ATTR_MAC]),
++					 NULL);
++
++	nla_memcpy(params.dlink, dlink, sizeof(params.dlink));
++	nla_memcpy(params.ulink, ulink, sizeof(params.ulink));
++
++	return rdev_set_sta_ttlm(rdev, dev,
++				 nla_data(info->attrs[NL80211_ATTR_MAC]),
++				 &params);
++}
++
++static int
+ nl80211_set_ttlm(struct sk_buff *skb, struct genl_info *info)
+ {
+ 	struct cfg80211_ttlm_params params = {};
+@@ -19722,6 +19754,9 @@ nl80211_set_ttlm(struct sk_buff *skb, st
+ 	struct net_device *dev = info->user_ptr[1];
+ 	struct wireless_dev *wdev = dev->ieee80211_ptr;
+ 
++	if (wdev->iftype == NL80211_IFTYPE_AP)
++		return nl80211_set_sta_ttlm(rdev, dev, info);
++
+ 	if (wdev->iftype != NL80211_IFTYPE_STATION &&
+ 	    wdev->iftype != NL80211_IFTYPE_P2P_CLIENT)
+ 		return -EOPNOTSUPP;
+--- a/net/wireless/rdev-ops.h
++++ b/net/wireless/rdev-ops.h
+@@ -1610,6 +1610,22 @@ rdev_set_hw_timestamp(struct cfg80211_re
+ }
+ 
+ static inline int
++rdev_set_sta_ttlm(struct cfg80211_registered_device *rdev,
++		  struct net_device *dev, const u8 *mac,
++		  struct cfg80211_ttlm_params *params)
++{
++	struct wiphy *wiphy = &rdev->wiphy;
++	int ret = -EOPNOTSUPP;
++
++	trace_rdev_set_sta_ttlm(wiphy, dev, mac, params);
++	if (rdev->ops->set_sta_ttlm)
++		ret = rdev->ops->set_sta_ttlm(wiphy, dev, mac, params);
++	trace_rdev_return_int(wiphy, ret);
++
++	return ret;
++}
++
++static inline int
+ rdev_set_ttlm(struct cfg80211_registered_device *rdev,
+ 	      struct net_device *dev,
+ 	      struct cfg80211_ttlm_params *params)
+--- a/net/wireless/trace.h
++++ b/net/wireless/trace.h
+@@ -3247,6 +3247,37 @@ TRACE_EVENT(rdev_set_ttlm,
+ 		  WIPHY_PR_ARG, NETDEV_PR_ARG)
+ );
+ 
++TRACE_EVENT(rdev_set_sta_ttlm,
++	TP_PROTO(struct wiphy *wiphy, struct net_device *netdev, const u8 *mac,
++		 struct cfg80211_ttlm_params *params),
++	TP_ARGS(wiphy, netdev, mac, params),
++	TP_STRUCT__entry(
++		WIPHY_ENTRY
++		NETDEV_ENTRY
++		MAC_ENTRY(mac)
++		__field(bool, dflt)
++		__array(u8, dlink, sizeof(u16) * 8)
++		__array(u8, ulink, sizeof(u16) * 8)
++	),
++	TP_fast_assign(
++		WIPHY_ASSIGN;
++		NETDEV_ASSIGN;
++		MAC_ASSIGN(mac, mac);
++		__entry->dflt = !params;
++		if (params) {
++			memcpy(__entry->dlink, params->dlink,
++			       sizeof(params->dlink));
++			memcpy(__entry->ulink, params->ulink,
++			       sizeof(params->ulink));
++		} else {
++			memset(__entry->dlink, 0, sizeof(__entry->dlink));
++			memset(__entry->ulink, 0, sizeof(__entry->ulink));
++		}
++	),
++	TP_printk(WIPHY_PR_FMT ", " NETDEV_PR_FMT ", sta: %pM, default: %d",
++		  WIPHY_PR_ARG, NETDEV_PR_ARG, __entry->mac, __entry->dflt)
++);
++
+ TRACE_EVENT(rdev_adv_ttlm_request,
+ 	TP_PROTO(struct wiphy *wiphy, struct net_device *netdev,
+ 		 struct cfg80211_adv_ttlm_params *params),
+--- a/include/uapi/linux/nl80211.h
++++ b/include/uapi/linux/nl80211.h
+@@ -1342,6 +1342,11 @@
+  *      non-AP MLD station. The %NL80211_ATTR_MLO_TTLM_DLINK and
+  *      %NL80211_ATTR_MLO_TTLM_ULINK attributes are used to specify the
+  *      TID to Link mapping for downlink/uplink traffic.
++ *	On an AP MLD interface, set the mapping that the AP MLD negotiated
++ *	with the associated non-AP MLD whose MLD address %NL80211_ATTR_MAC
++ *	holds. Without %NL80211_ATTR_MLO_TTLM_DLINK and
++ *	%NL80211_ATTR_MLO_TTLM_ULINK, the default mapping applies again. See
++ *	%NL80211_EXT_FEATURE_AP_NEG_TTLM.
+  *
+  * @NL80211_CMD_ASSOC_MLO_RECONF: For a non-AP MLD station, request to
+  *      add/remove links to/from the association. To indicate link
+@@ -7416,6 +7421,11 @@ enum nl80211_feature_flags {
+  *	that stay again after the event. The expiry comes before the TBTT at
+  *	which the timer reaches 0, and the removed links keep running until
+  *	user space stops them.
++ * @NL80211_EXT_FEATURE_AP_NEG_TTLM: The driver applies the TID-to-link
++ *	mapping that an AP MLD negotiated with an associated non-AP MLD
++ *	(IEEE 802.11be-2024, 35.3.7.2.3), set with
++ *	%NL80211_CMD_SET_TID_TO_LINK_MAPPING on the AP interface: it sends the
++ *	frames of each TID only on the links the mapping gives for it.
+  *
+  * @NUM_NL80211_EXT_FEATURES: number of extended features.
+  * @MAX_NL80211_EXT_FEATURES: highest extended feature index.
+@@ -7506,6 +7516,7 @@ enum nl80211_ext_feature_index {
+ 	NL80211_EXT_FEATURE_SCS,
+ 	NL80211_EXT_FEATURE_MSCS,
+ 	NL80211_EXT_FEATURE_AP_REMOVAL_TIMER_OFFLOAD,
++	NL80211_EXT_FEATURE_AP_NEG_TTLM,
+ 
+ 	/* add new features before the definition below */
+ 	NUM_NL80211_EXT_FEATURES,
diff --git a/package/kernel/mac80211/patches/subsys/477-wifi-mac80211-pass-the-TID-to-link-mapping-of-a-stat.patch b/package/kernel/mac80211/patches/subsys/477-wifi-mac80211-pass-the-TID-to-link-mapping-of-a-stat.patch
new file mode 100644
index 00000000..da4bbde9
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/477-wifi-mac80211-pass-the-TID-to-link-mapping-of-a-stat.patch
@@ -0,0 +1,170 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 27 Oct 2026 13:38:05 +0000
+Subject: [PATCH] wifi: mac80211: pass the TID-to-link mapping of a station to
+ the driver
+
+The device of an AP MLD picks the link of each frame to an associated
+non-AP MLD, so only the driver can apply a mapping that the AP MLD
+negotiated with that station.
+
+Add a driver op that sets the mapping of a station, and implement the
+cfg80211 op of an AP MLD with it. A mapping that names a link that the
+station did not set up is rejected. The default mapping reaches the
+driver as a mapping of every TID to all links of the station.
+
+Co-developed-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
+Signed-off-by: Michael-CY Lee <michael-cy.lee@mediatek.com>
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/include/net/mac80211.h
++++ b/include/net/mac80211.h
+@@ -4736,6 +4736,12 @@ struct ieee80211_prep_tx_info {
+  *	ieee80211_adv_ttlm_duration_set(). The driver passes @params->cookie
+  *	back with each step. cfg80211 calls this only while no mapping is
+  *	requested or established. This callback can sleep.
++ * @set_sta_ttlm: for an AP MLD, apply the TID-to-link mapping negotiated with
++ *	the given non-AP MLD: send the frames of each TID only on the links
++ *	@ttlm gives for it. Without @ttlm->valid, the default mapping applies
++ *	again, and @ttlm maps every TID to all links of the station. A driver
++ *	that implements this sets %NL80211_EXT_FEATURE_AP_NEG_TTLM. This
++ *	callback can sleep.
+  * @adv_ttlm_cancel: cancel the advertised TID-to-link mapping of the given
+  *	cookie, when a link of the AP MLD stops before its end. The driver
+  *	stops the mapping in the device and reports no further step of it;
+@@ -5220,6 +5226,9 @@ struct ieee80211_ops {
+ 				struct cfg80211_adv_ttlm_params *params);
+ 	void (*adv_ttlm_cancel)(struct ieee80211_hw *hw,
+ 				struct ieee80211_vif *vif, u64 cookie);
++	int (*set_sta_ttlm)(struct ieee80211_hw *hw, struct ieee80211_vif *vif,
++			    struct ieee80211_sta *sta,
++			    const struct ieee80211_neg_ttlm *ttlm);
+ 	void (*prep_add_interface)(struct ieee80211_hw *hw,
+ 				   enum nl80211_iftype type);
+ 	int (*set_eml_op_mode)(struct ieee80211_hw *hw,
+--- a/net/mac80211/cfg.c
++++ b/net/mac80211/cfg.c
+@@ -6095,6 +6095,43 @@ ieee80211_adv_ttlm_request(struct wiphy
+ 	return drv_adv_ttlm_request(sdata->local, sdata, params);
+ }
+ 
++static int
++ieee80211_set_sta_ttlm(struct wiphy *wiphy, struct net_device *dev,
++		       const u8 *mac, struct cfg80211_ttlm_params *params)
++{
++	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
++	struct ieee80211_neg_ttlm ttlm = {};
++	struct sta_info *sta;
++	u16 links;
++	int tid;
++
++	lockdep_assert_wiphy(sdata->local->hw.wiphy);
++
++	if (sdata->vif.type != NL80211_IFTYPE_AP ||
++	    !ieee80211_vif_is_mld(&sdata->vif))
++		return -EOPNOTSUPP;
++
++	sta = sta_info_get_bss(sdata, mac);
++	if (!sta)
++		return -ENOENT;
++
++	if (!sta->sta.mlo)
++		return -EINVAL;
++
++	links = sta->sta.valid_links;
++	for (tid = 0; tid < IEEE80211_TTLM_NUM_TIDS; tid++) {
++		if (params &&
++		    ((params->dlink[tid] | params->ulink[tid]) & ~links))
++			return -EINVAL;
++
++		ttlm.downlink[tid] = params ? params->dlink[tid] : links;
++		ttlm.uplink[tid] = params ? params->ulink[tid] : links;
++	}
++	ttlm.valid = !!params;
++
++	return drv_set_sta_ttlm(sdata->local, sdata, sta, &ttlm);
++}
++
+ static void
+ ieee80211_adv_ttlm_cancel(struct wiphy *wiphy, struct net_device *dev,
+ 			  u64 cookie)
+@@ -6264,6 +6301,7 @@ const struct cfg80211_ops mac80211_confi
+ 	.set_ttlm = ieee80211_set_ttlm,
+ 	.adv_ttlm_request = ieee80211_adv_ttlm_request,
+ 	.adv_ttlm_cancel = ieee80211_adv_ttlm_cancel,
++	.set_sta_ttlm = ieee80211_set_sta_ttlm,
+ 	.get_radio_mask = ieee80211_get_radio_mask,
+ 	.assoc_ml_reconf = ieee80211_assoc_ml_reconf,
+ 	.set_epcs = ieee80211_set_epcs,
+--- a/net/mac80211/driver-ops.h
++++ b/net/mac80211/driver-ops.h
+@@ -1875,6 +1875,31 @@ drv_adv_ttlm_request(struct ieee80211_lo
+ 	return ret;
+ }
+ 
++static inline int
++drv_set_sta_ttlm(struct ieee80211_local *local,
++		 struct ieee80211_sub_if_data *sdata,
++		 struct sta_info *sta,
++		 const struct ieee80211_neg_ttlm *ttlm)
++{
++	int ret = -EOPNOTSUPP;
++
++	might_sleep();
++	lockdep_assert_wiphy(local->hw.wiphy);
++	if (!check_sdata_in_driver(sdata))
++		return -EIO;
++
++	if (!sta->uploaded)
++		return -EIO;
++
++	trace_drv_set_sta_ttlm(local, sdata, &sta->sta, ttlm);
++	if (local->ops->set_sta_ttlm)
++		ret = local->ops->set_sta_ttlm(&local->hw, &sdata->vif,
++					       &sta->sta, ttlm);
++	trace_drv_return_int(local, ret);
++
++	return ret;
++}
++
+ static inline void
+ drv_adv_ttlm_cancel(struct ieee80211_local *local,
+ 		    struct ieee80211_sub_if_data *sdata, u64 cookie)
+--- a/net/mac80211/trace.h
++++ b/net/mac80211/trace.h
+@@ -3424,6 +3424,36 @@ TRACE_EVENT(drv_can_neg_ttlm,
+ 	TP_printk(LOCAL_PR_FMT ", " VIF_PR_FMT, LOCAL_PR_ARG, VIF_PR_ARG)
+ );
+ 
++TRACE_EVENT(drv_set_sta_ttlm,
++	    TP_PROTO(struct ieee80211_local *local,
++		     struct ieee80211_sub_if_data *sdata,
++		     struct ieee80211_sta *sta,
++		     const struct ieee80211_neg_ttlm *ttlm),
++
++	TP_ARGS(local, sdata, sta, ttlm),
++
++	TP_STRUCT__entry(LOCAL_ENTRY
++			 VIF_ENTRY
++			 STA_ENTRY
++			 __field(bool, valid)
++			 __array(u16, downlink, sizeof(u16) * 8)
++			 __array(u16, uplink, sizeof(u16) * 8)
++	),
++
++	TP_fast_assign(LOCAL_ASSIGN;
++		       VIF_ASSIGN;
++		       STA_ASSIGN;
++		       __entry->valid = ttlm->valid;
++		       memcpy(__entry->downlink, ttlm->downlink,
++			      sizeof(ttlm->downlink));
++		       memcpy(__entry->uplink, ttlm->uplink,
++			      sizeof(ttlm->uplink));
++	),
++
++	TP_printk(LOCAL_PR_FMT ", " VIF_PR_FMT ", " STA_PR_FMT " valid:%d",
++		  LOCAL_PR_ARG, VIF_PR_ARG, STA_PR_ARG, __entry->valid)
++);
++
+ TRACE_EVENT(drv_neg_ttlm_res,
+ 	    TP_PROTO(struct ieee80211_local *local,
+ 		     struct ieee80211_sub_if_data *sdata,
diff --git a/package/kernel/mac80211/patches/subsys/479-wifi-mac80211-wait-for-RCU-only-when-a-vif-link-is-r.patch b/package/kernel/mac80211/patches/subsys/479-wifi-mac80211-wait-for-RCU-only-when-a-vif-link-is-r.patch
new file mode 100644
index 00000000..840e602e
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/479-wifi-mac80211-wait-for-RCU-only-when-a-vif-link-is-r.patch
@@ -0,0 +1,33 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sun, 25 Oct 2026 10:45:00 +0100
+Subject: [PATCH] wifi: mac80211: wait for RCU only when a vif link is removed
+
+ieee80211_vif_update_links() calls ieee80211_tear_down_links() also when
+the update only adds links, and ieee80211_tear_down_links() waits for an
+RCU grace period whatever its mask holds. The AP VLAN of a 4-address
+station follows the links of its station, so
+ieee80211_add_link_station() updates the links of that VLAN, and a Link
+Reconfiguration add of such a station waits for a grace period before
+hostapd can send the response. A mac80211 station waits 100 ms
+(IEEE80211_ASSOC_TIMEOUT_SHORT) for it and drops the added link on a
+loaded host.
+
+Return from ieee80211_tear_down_links() when no link goes away: no link
+pointer was cleared and nothing is freed after the call, so no reader can
+hold a pointer to freed memory, and there are no keys to free.
+
+Fixes: b2e8434f1829 ("wifi: mac80211: set up/tear down client vif links properly")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/net/mac80211/link.c
++++ b/net/mac80211/link.c
+@@ -234,6 +234,9 @@ static void ieee80211_tear_down_links(st
+ 	LIST_HEAD(keys);
+ 	unsigned int link_id;
+ 
++	if (!mask)
++		return;
++
+ 	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++) {
+ 		if (!(mask & BIT(link_id)))
+ 			continue;
diff --git a/package/kernel/mac80211/patches/subsys/480-wifi-mac80211-keep-the-priority-of-an-802.3-frame-fo.patch b/package/kernel/mac80211/patches/subsys/480-wifi-mac80211-keep-the-priority-of-an-802.3-frame-fo.patch
new file mode 100644
index 00000000..356016cf
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/480-wifi-mac80211-keep-the-priority-of-an-802.3-frame-fo.patch
@@ -0,0 +1,42 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sun, 25 Oct 2026 12:00:00 +0100
+Subject: [PATCH] wifi: mac80211: keep the priority of an 802.3 frame for the slow path
+
+ieee80211_8023_xmit() classifies a frame with ieee80211_select_queue()
+before it checks the aggregation session of its TID. While that session
+is not operational, it passes the frame to
+__ieee80211_subif_start_xmit(), which classifies it again. The first
+classification replaced a priority of 256 to 263 by the UP it names, so
+the second one takes the UP from the DSCP. The frames of a new flow that
+are sent during the ADDBA exchange thus go out with another TID than the
+frames after it.
+
+Give the slow path the priority that the frame had on entry, so that
+both paths classify it the same way.
+
+Fixes: 96ae9cd02c0f ("mac80211: check and refresh aggregation session in encap offload tx")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/tx.c
++++ b/net/mac80211/tx.c
+@@ -4910,6 +4910,7 @@ static void ieee80211_8023_xmit(struct i
+ 	struct tid_ampdu_tx *tid_tx = NULL;
+ 	struct sk_buff *seg, *next;
+ 	unsigned int skbs = 0, len = 0;
++	u32 priority = skb->priority;
+ 	u32 ctrl_flags = 0;
+ 	u16 queue;
+ 	u8 tid;
+@@ -4933,7 +4934,11 @@ static void ieee80211_8023_xmit(struct i
+ 		tid_tx = rcu_dereference(sta->ampdu_mlme.tid_tx[tid]);
+ 	if (tid_tx) {
+ 		if (!test_bit(HT_AGG_STATE_OPERATIONAL, &tid_tx->state)) {
+-			/* fall back to non-offload slow path */
++			/*
++			 * fall back to non-offload slow path, which classifies
++			 * the frame again
++			 */
++			skb->priority = priority;
+ 			__ieee80211_subif_start_xmit(skb, dev, 0,
+ 						     IEEE80211_TX_CTRL_MLO_LINK_UNSPEC,
+ 						     NULL);
diff --git a/package/kernel/mac80211/patches/subsys/481-wifi-mac80211-do-not-send-an-off-channel-frame-after.patch b/package/kernel/mac80211/patches/subsys/481-wifi-mac80211-do-not-send-an-off-channel-frame-after.patch
new file mode 100644
index 00000000..81929ce3
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/481-wifi-mac80211-do-not-send-an-off-channel-frame-after.patch
@@ -0,0 +1,104 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sun, 25 Oct 2026 16:44:33 +0100
+Subject: [PATCH] wifi: mac80211: do not send an off-channel frame after the ROC expired
+
+ieee80211_ready_on_channel() and ieee80211_remain_on_channel_expired()
+only queue the wiphy works hw_roc_start and hw_roc_done. If the wiphy
+lock is held for longer than the ROC duration, the driver reports the
+expiry before hw_roc_start runs. ieee80211_hw_roc_start() then still
+transmits the pending mgmt frame on the off-channel queue, although the
+driver has left the channel. On mac80211_hwsim, which clears tmp_chan
+when its ROC expires, this triggers:
+
+  TX w/o channel - queue = 4
+  WARNING: drivers/net/wireless/virtual/mac80211_hwsim_main.c:2653 at mac80211_hwsim_tx+0x87d/0xc10
+   ieee80211_tx_frags+0x170/0x280
+   __ieee80211_tx_skb_tid_band+0x8e/0x160
+   ieee80211_hw_roc_start+0x59/0xd0
+   cfg80211_wiphy_work+0x88/0xb0
+
+It was seen with a station that sends an action frame off-channel with
+a wait of 0 ms while its disconnection holds the wiphy lock.
+
+Remember that the driver reported the expiry of the current ROC. In that
+case, do not transmit the frames of the ROC when the start is processed:
+hw_roc_done ends the ROC and reports each frame as not acknowledged. Do
+not combine a new request with an expired ROC either, so that it waits
+for a ROC of its own. A plain ROC still gets its ready notification,
+followed by the expiry.
+
+Fixes: 90fc4b3a5ba2 ("mac80211: implement off-channel TX using hw r-o-c offload")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/ieee80211_i.h
++++ b/net/mac80211/ieee80211_i.h
+@@ -1768,6 +1768,7 @@ struct ieee80211_local {
+ 	struct list_head roc_list;
+ 	struct wiphy_work hw_roc_start, hw_roc_done;
+ 	unsigned long hw_roc_start_time;
++	bool hw_roc_expired;
+ 	u64 roc_cookie_counter;
+ 
+ 	struct idr ack_status_frames;
+--- a/net/mac80211/offchannel.c
++++ b/net/mac80211/offchannel.c
+@@ -262,6 +262,7 @@ static void ieee80211_hw_roc_start(struc
+ {
+ 	struct ieee80211_local *local =
+ 		container_of(work, struct ieee80211_local, hw_roc_start);
++	bool expired = READ_ONCE(local->hw_roc_expired);
+ 	struct ieee80211_roc_work *roc;
+ 
+ 	lockdep_assert_wiphy(local->hw.wiphy);
+@@ -271,6 +272,11 @@ static void ieee80211_hw_roc_start(struc
+ 			break;
+ 
+ 		roc->hw_begun = true;
++
++		/* the driver has left the channel, hw_roc_done fails the frame */
++		if (expired && roc->frame)
++			continue;
++
+ 		ieee80211_handle_roc_started(roc, local->hw_roc_start_time);
+ 	}
+ }
+@@ -319,8 +325,11 @@ static void _ieee80211_start_next_roc(st
+ 	}
+ 
+ 	if (local->ops->remain_on_channel) {
+-		int ret = drv_remain_on_channel(local, roc->sdata, roc->chan,
+-						max_dur, type);
++		int ret;
++
++		WRITE_ONCE(local->hw_roc_expired, false);
++		ret = drv_remain_on_channel(local, roc->sdata, roc->chan,
++					    max_dur, type);
+ 
+ 		if (ret) {
+ 			wiphy_warn(local->hw.wiphy,
+@@ -512,6 +521,7 @@ void ieee80211_remain_on_channel_expired
+ 
+ 	trace_api_remain_on_channel_expired(local);
+ 
++	WRITE_ONCE(local->hw_roc_expired, true);
+ 	wiphy_work_queue(hw->wiphy, &local->hw_roc_done);
+ }
+ EXPORT_SYMBOL_GPL(ieee80211_remain_on_channel_expired);
+@@ -533,6 +543,9 @@ ieee80211_coalesce_hw_started_roc(struct
+ 	if (!cur_roc->hw_begun && new_roc->duration > cur_roc->duration)
+ 		return false;
+ 
++	if (READ_ONCE(local->hw_roc_expired))
++		return false;
++
+ 	remaining = cur_roc->start_time +
+ 		    msecs_to_jiffies(cur_roc->duration) -
+ 		    now;
+@@ -625,6 +638,7 @@ static int ieee80211_start_roc_work(stru
+ 			/* otherwise actually kick it off here
+ 			 * (for error handling)
+ 			 */
++			WRITE_ONCE(local->hw_roc_expired, false);
+ 			ret = drv_remain_on_channel(local, sdata, channel,
+ 						    duration, type);
+ 			if (ret) {
diff --git a/package/kernel/mac80211/patches/subsys/483-wifi-cfg80211-check-the-layout-of-the-flow-types.patch b/package/kernel/mac80211/patches/subsys/483-wifi-cfg80211-check-the-layout-of-the-flow-types.patch
new file mode 100644
index 00000000..89e33915
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/483-wifi-cfg80211-check-the-layout-of-the-flow-types.patch
@@ -0,0 +1,64 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 27 Oct 2026 20:00:00 +0100
+Subject: [PATCH] wifi: cfg80211: check the layout of the flow types
+
+The kernel patch 797-00 adds its own copy of the flow types for
+mtk_eth_soc, which fills a struct cfg80211_flow_info that mt76 and
+mac80211 read with this copy. The two copies are separate definitions,
+so a change to one of them still builds and then corrupts the data on
+the other side.
+
+Assert the offset of each field, the size of each structure and the
+value of each flow field, with the same values as 797-00.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -4258,6 +4258,46 @@ struct cfg80211_flow_info {
+ 	u16 l3_off;
+ };
+ 
++/*
++ * The kernel and the backports tree each define these types, and a structure
++ * crosses from one build to the other, so both keep this layout.
++ */
++static_assert(CFG80211_FLOW_F_ETH_SA == 0);
++static_assert(CFG80211_FLOW_F_ETH_DA == 1);
++static_assert(CFG80211_FLOW_F_ETH_TYPE == 2);
++static_assert(CFG80211_FLOW_F_VLAN_PCP == 3);
++static_assert(CFG80211_FLOW_F_VLAN_DEI == 4);
++static_assert(CFG80211_FLOW_F_VLAN_VID == 5);
++static_assert(CFG80211_FLOW_F_IP_VERSION == 6);
++static_assert(CFG80211_FLOW_F_IP_SRC == 7);
++static_assert(CFG80211_FLOW_F_IP_DST == 8);
++static_assert(CFG80211_FLOW_F_SRC_PORT == 9);
++static_assert(CFG80211_FLOW_F_DST_PORT == 10);
++static_assert(CFG80211_FLOW_F_DSCP == 11);
++static_assert(CFG80211_FLOW_F_PROTO == 12);
++static_assert(CFG80211_FLOW_F_FLOW_LABEL == 13);
++static_assert(NUM_CFG80211_FLOW_FIELDS == 14);
++static_assert(offsetof(struct cfg80211_flow_key, src) == 0);
++static_assert(offsetof(struct cfg80211_flow_key, dst) == 16);
++static_assert(offsetof(struct cfg80211_flow_key, flow_label) == 32);
++static_assert(offsetof(struct cfg80211_flow_key, sa) == 36);
++static_assert(offsetof(struct cfg80211_flow_key, da) == 42);
++static_assert(offsetof(struct cfg80211_flow_key, eth_type) == 48);
++static_assert(offsetof(struct cfg80211_flow_key, vlan_tci) == 50);
++static_assert(offsetof(struct cfg80211_flow_key, src_port) == 52);
++static_assert(offsetof(struct cfg80211_flow_key, dst_port) == 54);
++static_assert(offsetof(struct cfg80211_flow_key, ip_version) == 56);
++static_assert(offsetof(struct cfg80211_flow_key, dscp) == 57);
++static_assert(offsetof(struct cfg80211_flow_key, proto) == 58);
++static_assert(offsetof(struct cfg80211_flow_key, pad) == 59);
++static_assert(sizeof(struct cfg80211_flow_key) == 60);
++static_assert(offsetof(struct cfg80211_flow_info, key) == 0);
++static_assert(offsetof(struct cfg80211_flow_info, present) == 60);
++static_assert(offsetof(struct cfg80211_flow_info, skb) == 64);
++static_assert(offsetof(struct cfg80211_flow_info, l3_off) ==
++	      64 + sizeof(void *));
++static_assert(sizeof(struct cfg80211_flow_info) == 64 + 2 * sizeof(void *));
++
+ bool cfg80211_flow_parse(struct sk_buff *skb, struct cfg80211_flow_info *info);
+ 
+ /**
diff --git a/package/kernel/mac80211/patches/subsys/484-wifi-mac80211-don-t-estimate-airtime-for-unsupported-rate-widths.patch b/package/kernel/mac80211/patches/subsys/484-wifi-mac80211-don-t-estimate-airtime-for-unsupported-rate-widths.patch
new file mode 100644
index 00000000..2f41ad0c
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/484-wifi-mac80211-don-t-estimate-airtime-for-unsupported-rate-widths.patch
@@ -0,0 +1,83 @@
+From f394cbd0980c95c9173f8551a5eb4c4f28d598eb Mon Sep 17 00:00:00 2001
+From: François Roux <franzelfranzel@gmail.com>
+Date: Tue, 6 Oct 2026 10:37:51 +0200
+Subject: wifi: mac80211: don't estimate airtime for unsupported rate widths
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+ieee80211_fill_rate_info() copies the driver's rate_info bandwidth into
+the rx_status as is, but ieee80211_get_rate_duration() only handles
+20/40/80/160/320 MHz. When a driver reports another width, e.g. an
+HE/EHT RU allocation, it hits WARN_ON_ONCE() and returns 0 without
+setting *overhead. ieee80211_rate_expected_tx_airtime() then goes on
+using the uninitialized overhead, as Dan's static checker report
+points out.
+
+Seen on a Microsoft Surface Pro 11 (WCN7850, ath12k) while
+NetworkManager dumps station info:
+
+  WARNING: net/mac80211/airtime.c:532 at ieee80211_get_rate_duration.isra.0+0xc0/0x180 [mac80211]
+   ieee80211_get_rate_duration.isra.0+0xc0/0x180 [mac80211]
+   sta_estimate_expected_throughput.isra.0+0x38/0x64 [mac80211]
+   sta_set_sinfo+0x7fc/0x8e4 [mac80211]
+   ieee80211_dump_station+0x4c/0x84 [mac80211]
+   nl80211_dump_station+0x594/0x7e8 [cfg80211]
+
+Only accept widths that ieee80211_get_rate_duration() handles in
+ieee80211_fill_rate_info(). Other widths then give no estimate instead
+of a warning. Also return 0 from ieee80211_rate_expected_tx_airtime()
+when no duration could be computed, as ieee80211_calc_rx_airtime()
+already does.
+
+Tested on the Surface Pro 11 with next-20260929: Wi-Fi works and
+"expected throughput" is still reported (about 1049 Mbit/s for a
+1297 Mbit/s HE 160 MHz tx rate). The warning itself is rare (twice in
+several days of use), so this does not prove it is gone, only that the
+change does not break the normal path.
+
+Fixes: 094dc1619cb0 ("wifi: mac80211: factor out part of ieee80211_calc_expected_tx_airtime")
+Reported-by: Dan Carpenter <error27@gmail.com>
+Closes: https://lore.kernel.org/all/aneGlCMVnqRhlf6p@stanley.mountain/
+Assisted-by: LLM
+Signed-off-by: François Roux <franzelfranzel@gmail.com>
+Link: https://patch.msgid.link/20261006083751.4015-1-franzelfranzel@gmail.com
+Signed-off-by: Johannes Berg <johannes.berg@intel.com>
+---
+ net/mac80211/airtime.c | 18 ++++++++++++++++++
+ 1 file changed, 18 insertions(+)
+
+--- a/net/mac80211/airtime.c
++++ b/net/mac80211/airtime.c
+@@ -632,6 +632,22 @@ static bool ieee80211_fill_rate_info(str
+ 	if (!ri || !sband)
+ 	    return false;
+ 
++	/*
++	 * ieee80211_get_rate_duration() only handles these widths. Drivers
++	 * may also report e.g. HE/EHT RU allocations, which cannot be used
++	 * to estimate airtime here.
++	 */
++	switch (ri->bw) {
++	case RATE_INFO_BW_20:
++	case RATE_INFO_BW_40:
++	case RATE_INFO_BW_80:
++	case RATE_INFO_BW_160:
++	case RATE_INFO_BW_320:
++		break;
++	default:
++		return false;
++	}
++
+ 	stat->bw = ri->bw;
+ 	stat->nss = ri->nss;
+ 	stat->rate_idx = ri->mcs;
+@@ -770,6 +786,8 @@ u32 ieee80211_rate_expected_tx_airtime(s
+ 		return ieee80211_calc_rx_airtime(hw, &stat, len) * 1024;
+ 
+ 	duration = ieee80211_get_rate_duration(hw, &stat, &overhead);
++	if (!duration)
++		return 0;
+ 
+ 	/*
+ 	 * Assume that HT/VHT transmission on any AC except VO will
