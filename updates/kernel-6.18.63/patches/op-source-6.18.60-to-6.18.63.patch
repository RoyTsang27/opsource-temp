++nl80211_adv_ttlm_request(struct sk_buff *skb, struct genl_info *info)
++{
++	struct cfg80211_registered_device *rdev = info->user_ptr[0];
++	struct cfg80211_adv_ttlm_params params = {};
++	struct net_device *dev = info->user_ptr[1];
++	struct wireless_dev *wdev = dev->ieee80211_ptr;
++	unsigned int link_id;
++	unsigned long links;
++	struct sk_buff *msg;
++	u64 cookie;
++	void *hdr;
++	int err;
++
++	if (!rdev->ops->adv_ttlm_request ||
++	    !wiphy_ext_feature_isset(&rdev->wiphy,
++				     NL80211_EXT_FEATURE_AP_ADV_TTLM) ||
++	    !wiphy_ext_feature_isset(&rdev->wiphy,
++				     NL80211_EXT_FEATURE_BEACON_CRIT_UPDATE))
++		return -EOPNOTSUPP;
++
++	if (wdev->iftype != NL80211_IFTYPE_AP || !wdev->valid_links)
++		return -EOPNOTSUPP;
++
++	if (!info->attrs[NL80211_ATTR_MLO_ADV_TTLM_LINKS] ||
++	    !info->attrs[NL80211_ATTR_MLO_ADV_TTLM_SWITCH_TIME] ||
++	    !info->attrs[NL80211_ATTR_MLO_ADV_TTLM_DURATION])
++		return -EINVAL;
++
++	params.links = nla_get_u16(info->attrs[NL80211_ATTR_MLO_ADV_TTLM_LINKS]);
++	params.switch_time =
++		nla_get_u32(info->attrs[NL80211_ATTR_MLO_ADV_TTLM_SWITCH_TIME]);
++	params.duration =
++		nla_get_u32(info->attrs[NL80211_ATTR_MLO_ADV_TTLM_DURATION]);
++
++	if ((params.links & ~wdev->valid_links) ||
++	    params.links == wdev->valid_links)
++		return -EINVAL;
++
++	links = params.links;
++	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS)
++		if (!wdev->links[link_id].ap.beacon_interval)
++			return -ENOLINK;
++
++	msg = nlmsg_new(NLMSG_DEFAULT_SIZE, GFP_KERNEL);
++	if (!msg)
++		return -ENOMEM;
++
++	hdr = nl80211hdr_put(msg, info->snd_portid, info->snd_seq, 0,
++			     NL80211_CMD_ADV_TTLM_REQUEST);
++	if (!hdr) {
++		err = -ENOBUFS;
++		goto free_msg;
++	}
++
++	cookie = cfg80211_assign_cookie(rdev);
++	if (nla_put_u64_64bit(msg, NL80211_ATTR_COOKIE, cookie,
++			      NL80211_ATTR_PAD)) {
++		err = -ENOBUFS;
++		goto free_msg;
++	}
++
++	if (atomic64_cmpxchg(&wdev->u.ap.adv_ttlm_cookie, 0, cookie)) {
++		err = -EBUSY;
++		goto free_msg;
++	}
