++static bool scs_desc_client_match(const struct cfg80211_scs_desc *desc,
++				  const struct cfg80211_flow_info *info,
++				  bool *undecided)
++{
++	if (is_zero_ether_addr(desc->client))
++		return true;
++
++	if (!(info->present & FLOW_F(ETH_DA))) {
++		*undecided = true;
++		return false;
++	}
++
++	return ether_addr_equal(desc->client, info->key.da);
++}
