@@ -0,0 +1,28 @@
+Subject: [PATCH] wifi: mt76: mt7915: skip recovery on MCU probe timeout
+
+The MCU handshake can time out before mt76_register_device()
+initializes the primary PHY transmit list. The response timeout
+handler can queue the full recovery worker, which assumes that the
+list and mac80211 device are ready. mt7915_reset() already uses
+hw_init_done to guard the corresponding interrupt-driven recovery.
+
+Return the probe error without scheduling recovery before hardware
+initialization finishes. Runtime timeouts continue to request reset.
+
+Link: https://github.com/openwrt/openwrt/issues/25819
+
+diff --git a/mt7915/mcu.c b/mt7915/mcu.c
+index 1d845cf..7734d79 100644
+--- a/mt7915/mcu.c
++++ b/mt7915/mcu.c
+@@ -165,6 +165,10 @@ mt7915_mcu_parse_response(struct mt76_dev *mdev, int cmd,
+ 		dev_err(mdev->dev, "Message %08x (seq %d) timeout\n",
+ 			cmd, seq);
+ 
++		/* The recovery worker requires a registered device. */
++		if (!dev->recovery.hw_init_done)
++			return -ETIMEDOUT;
++
+ 		if (!test_and_set_bit(MT76_MCU_RESET, &dev->mphy.state)) {
+ 			dev->recovery.restart = true;
+ 			wake_up(&dev->mt76.mcu.wait);
diff --git a/package/kernel/mt76/patches/960-mt7915-bound-TX-firmware-DMA-length.patch b/package/kernel/mt76/patches/960-mt7915-bound-TX-firmware-DMA-length.patch
new file mode 100644
index 00000000..daae17b5
--- /dev/null
+++ b/package/kernel/mt76/patches/960-mt7915-bound-TX-firmware-DMA-length.patch
@@ -0,0 +1,26 @@
+Subject: [PATCH] wifi: mt76: mt7915: bound the firmware DMA preview length
+
+The TX DMA code maps skb_headlen(skb) bytes before calling
+mt7915_tx_prepare_skb(). The firmware header preview descriptor
+then unconditionally requests MT_CT_PARSE_LEN bytes even when
+the first DMA mapping is shorter.
+
+Cap the preview length to the existing mapping. The firmware TXP
+still records the original buffer lengths for the actual packet.
+
+Based on the posted patch by Joshua Klinesmith.
+Link: https://lore.kernel.org/linux-wireless/20260406184556.8245-3-joshuaklinesmith@gmail.com/
+
+diff --git a/mt7915/mac.c b/mt7915/mac.c
+index 06cddff..721f8d4 100644
+--- a/mt7915/mac.c
++++ b/mt7915/mac.c
+@@ -799,7 +799,7 @@ int mt7915_tx_prepare_skb(struct mt76_dev *mdev, void *txwi_ptr,
+ 	tx_info->skb = NULL;
+ 
+ 	/* pass partial skb header to fw */
+-	tx_info->buf[1].len = MT_CT_PARSE_LEN;
++	tx_info->buf[1].len = min_t(u16, MT_CT_PARSE_LEN, tx_info->buf[1].len);
+ 	tx_info->buf[1].skip_unmap = true;
+ 	tx_info->nbuf = MT_CT_DMA_BUF_NUM;
+ 
diff --git a/package/kernel/mt76/patches/961-mt76-discard-incomplete-DMA-RX-chains.patch b/package/kernel/mt76/patches/961-mt76-discard-incomplete-DMA-RX-chains.patch
