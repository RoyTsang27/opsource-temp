+index 63ba188..d3eca5a 100644
+--- a/mt76.h
++++ b/mt76.h
+@@ -259,6 +259,7 @@ struct mt76_queue {
+ 	int buf_size;
+ 	bool stopped;
+ 	bool blocked;
++	bool rx_drop;
+ 
+ 	u8 buf_offset;
+ 	u16 flags;
