diff --git a/package/kernel/mt76/patches/100-wifi-mt76-mt76x02-restart-mac_work-after-a-channel-change.patch b/package/kernel/mt76/patches/100-wifi-mt76-mt76x02-restart-mac_work-after-a-channel-change.patch
new file mode 100644
index 00000000..4e6aaf4c
--- /dev/null
+++ b/package/kernel/mt76/patches/100-wifi-mt76-mt76x02-restart-mac_work-after-a-channel-change.patch
@@ -0,0 +1,66 @@
+From 4389a25ec075b45de6a2e15135c7908ce9693c4e Mon Sep 17 00:00:00 2001
+From: Rosen Penev <rosenp@gmail.com>
+Date: Thu, 22 Oct 2026 14:29:41 -0700
+Subject: [PATCH] wifi: mt76: mt76x02: restart mac_work after a channel
+ change
+
+Since the channel change code moved to the core, mt76_set_channel()
+cancels phy->mac_work before calling the driver's set_channel op. The
+mt7603, mt7615 and mt7915 set_channel ops queue mac_work again, but the
+mt76x0 and mt76x2 ones do not, and they only queue it in their start
+op. After the first channel change, which happens on every interface
+up, association and scan, mt76x02_mac_work never runs again.
+
+mt76x02_mac_work calls mt76_tx_status_check() to time out frames that
+wait for a TX status report. Without it, frames whose report is lost
+stay in the wcid pktid idr until another report happens to sweep them.
+On an MT7612U station sending 25 Mbit/s of UDP, 48 such frames piled
+up within seconds. They kept their AQL airtime and their socket memory,
+and the sender blocked on a full socket send buffer for up to 30 s
+until a connection monitor probe swept them. The work also collects the
+survey, A-MPDU and EDCCA statistics and checks for MAC errors.
+
+Queue mac_work again at the end of the set_channel ops.
+
+Fixes: f4fdd7716290 ("wifi: mt76: partially move channel change code to core")
+Assisted-by: LLM
+Signed-off-by: Rosen Penev <rosenp@gmail.com>
+---
+ mt76x0/main.c     | 2 ++
+ mt76x2/pci_main.c | 2 ++
+ mt76x2/usb_main.c | 2 ++
+ 3 files changed, 6 insertions(+)
+
+--- a/mt76x0/main.c
++++ b/mt76x0/main.c
+@@ -26,6 +26,8 @@ int mt76x0_set_channel(struct mt76_phy *
+ 		tasklet_enable(&dev->dfs_pd.dfs_tasklet);
+ 	}
+ 	mt76x02_pre_tbtt_enable(dev, true);
++	ieee80211_queue_delayed_work(mt76_hw(dev), &dev->mphy.mac_work,
++				     MT_MAC_WORK_INTERVAL);
+ 
+ 	return 0;
+ }
+--- a/mt76x2/pci_main.c
++++ b/mt76x2/pci_main.c
+@@ -49,6 +49,8 @@ int mt76x2e_set_channel(struct mt76_phy
+ 
+ 	tasklet_enable(&dev->dfs_pd.dfs_tasklet);
+ 	tasklet_enable(&dev->mt76.pre_tbtt_tasklet);
++	ieee80211_queue_delayed_work(mt76_hw(dev), &dev->mphy.mac_work,
++				     MT_MAC_WORK_INTERVAL);
+ 
+ 	return 0;
+ }
+--- a/mt76x2/usb_main.c
++++ b/mt76x2/usb_main.c
+@@ -45,6 +45,8 @@ int mt76x2u_set_channel(struct mt76_phy
+ 	mt76x2_mac_resume(dev);
+ 
+ 	mt76x02_pre_tbtt_enable(dev, true);
++	ieee80211_queue_delayed_work(mt76_hw(dev), &dev->mphy.mac_work,
++				     MT_MAC_WORK_INTERVAL);
+ 
+ 	return err;
+ }
diff --git a/package/kernel/mt76/patches/101-wifi-mt76-mt76x2u-limit-TX-A-MSDUs-to-3-kB-at-SuperSpeed.patch b/package/kernel/mt76/patches/101-wifi-mt76-mt76x2u-limit-TX-A-MSDUs-to-3-kB-at-SuperSpeed.patch
new file mode 100644
index 00000000..bcafc252
--- /dev/null
+++ b/package/kernel/mt76/patches/101-wifi-mt76-mt76x2u-limit-TX-A-MSDUs-to-3-kB-at-SuperSpeed.patch
@@ -0,0 +1,72 @@
+From 510c7c602c2b6694830ea6ea318a7ce9dd5973e1 Mon Sep 17 00:00:00 2001
+From: Rosen Penev <rosenp@gmail.com>
+Date: Thu, 22 Oct 2026 23:08:37 -0700
+Subject: [PATCH] wifi: mt76: mt76x2u: limit TX A-MSDUs to 3 kB at
+ SuperSpeed
+
+At SuperSpeed the MT7612U stops accepting bulk OUT data after it was
+sent a TX frame longer than 3072 bytes (TXWI and 802.11 frame, the
+TXINFO length). The TX URBs never complete, MCU commands time out
+("mt76x02u_mcu_wait_resp failed with -110") and only a power cycle
+brings the device back; neither a USB reset nor a host reboot with the
+port powered recovers it. Single frames never get that long, but
+A-MSDUs of two full-size subframes are 3096 bytes.
+
+Behind a USB 3 hub this happens within seconds of continuous traffic,
+plugged in directly within minutes. Frames of up to 3072 bytes, at
+MTU 1488, ran for minutes behind the hub, frames of 3080 bytes, at
+MTU 1492, wedged the device. At high speed the same A-MSDUs work.
+
+Cap the A-MSDU length for all TIDs when the device runs at SuperSpeed.
+This keeps A-MSDUs of smaller frames.
+
+Link: https://github.com/openwrt/mt76/issues/405
+Fixes: ee676cd5017c ("mt76: add driver code for MT76x2u based devices")
+Assisted-by: LLM
+Signed-off-by: Rosen Penev <rosenp@gmail.com>
+---
+ mt76x2/usb.c   | 25 ++++++++++++++++++-
+ 1 file changed, 24 insertions(+), 1 deletion(-)
+
+--- a/mt76x2/usb.c
++++ b/mt76x2/usb.c
+@@ -29,6 +29,30 @@ static const struct usb_device_id mt76x2
+ 	{ },
+ };
+ 
++/* At SuperSpeed the MT7612U wedges its bulk OUT path on TX frames longer
++ * than 3072 bytes (TXWI and 802.11 frame), which only A-MSDUs reach. mt76
++ * adds 22 bytes (TXWI, header padding) to the MPDU, and mac80211 counts
++ * each new subframe up to 11 bytes (LLC header, padding) short, plus the
++ * 14-byte subframe header it adds to the first subframe after the check.
++ */
++#define MT76X2U_SS_MAX_AMSDU_LEN	(3072 - 22 - 11 - 14)
++
