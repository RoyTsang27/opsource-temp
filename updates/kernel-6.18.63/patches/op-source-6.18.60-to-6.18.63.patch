++	return drv_adv_ttlm_request(sdata->local, sdata, params);
++}
++
++static void
++ieee80211_adv_ttlm_cancel(struct wiphy *wiphy, struct net_device *dev,
++			  u64 cookie)
++{
++	struct ieee80211_sub_if_data *sdata = IEEE80211_DEV_TO_SUB_IF(dev);
++
++	drv_adv_ttlm_cancel(sdata->local, sdata, cookie);
++}
++
++static int
+ ieee80211_assoc_ml_reconf(struct wiphy *wiphy, struct net_device *dev,
+ 			  struct cfg80211_ml_reconf_req *req)
+ {
+@@ -6226,6 +6278,8 @@ const struct cfg80211_ops mac80211_confi
+ 	.del_link_station = ieee80211_del_link_station,
+ 	.set_hw_timestamp = ieee80211_set_hw_timestamp,
+ 	.set_ttlm = ieee80211_set_ttlm,
++	.adv_ttlm_request = ieee80211_adv_ttlm_request,
++	.adv_ttlm_cancel = ieee80211_adv_ttlm_cancel,
+ 	.get_radio_mask = ieee80211_get_radio_mask,
+ 	.assoc_ml_reconf = ieee80211_assoc_ml_reconf,
+ 	.set_epcs = ieee80211_set_epcs,
+--- a/net/mac80211/driver-ops.h
++++ b/net/mac80211/driver-ops.h
+@@ -1780,6 +1780,42 @@ drv_can_neg_ttlm(struct ieee80211_local
+ 	return res;
+ }
+ 
++static inline int
++drv_adv_ttlm_request(struct ieee80211_local *local,
++		     struct ieee80211_sub_if_data *sdata,
++		     struct cfg80211_adv_ttlm_params *params)
++{
++	int ret = -EOPNOTSUPP;
++
++	might_sleep();
++	lockdep_assert_wiphy(local->hw.wiphy);
++	if (!check_sdata_in_driver(sdata))
++		return -EIO;
++
++	trace_drv_adv_ttlm_request(local, sdata, params);
++	if (local->ops->adv_ttlm_request)
++		ret = local->ops->adv_ttlm_request(&local->hw, &sdata->vif,
++						   params);
++	trace_drv_return_int(local, ret);
++
++	return ret;
++}
++
++static inline void
++drv_adv_ttlm_cancel(struct ieee80211_local *local,
++		    struct ieee80211_sub_if_data *sdata, u64 cookie)
++{
++	might_sleep();
++	lockdep_assert_wiphy(local->hw.wiphy);
++	if (!check_sdata_in_driver(sdata))
++		return;
++
++	trace_drv_adv_ttlm_cancel(local, sdata, cookie);
++	if (local->ops->adv_ttlm_cancel)
++		local->ops->adv_ttlm_cancel(&local->hw, &sdata->vif, cookie);
++	trace_drv_return_void(local);
++}
++
+ static inline void
+ drv_prep_add_interface(struct ieee80211_local *local,
+ 		       enum nl80211_iftype type)
+--- a/net/mac80211/trace.h
++++ b/net/mac80211/trace.h
+@@ -3302,6 +3302,63 @@ TRACE_EVENT(stop_queue,
+ 	)
+ );
+ 
++TRACE_EVENT(drv_adv_ttlm_request,
++	TP_PROTO(struct ieee80211_local *local,
++		 struct ieee80211_sub_if_data *sdata,
++		 struct cfg80211_adv_ttlm_params *params),
++
++	TP_ARGS(local, sdata, params),
++
++	TP_STRUCT__entry(
++		LOCAL_ENTRY
++		VIF_ENTRY
++		__field(u16, links)
