++nl80211_adv_ttlm_msg(struct net_device *dev,
++		     const struct cfg80211_adv_ttlm_event *event, gfp_t gfp)
++{
++	struct wireless_dev *wdev = dev->ieee80211_ptr;
++	struct cfg80211_registered_device *rdev = wiphy_to_rdev(wdev->wiphy);
++	struct sk_buff *msg;
++	void *hdr;
++
++	msg = nlmsg_new(NLMSG_DEFAULT_SIZE, gfp);
++	if (!msg)
++		return NULL;
++
++	hdr = nl80211hdr_put(msg, 0, 0, 0, event->cmd);
++	if (!hdr)
++		goto nla_put_failure;
++
++	if (nla_put_u32(msg, NL80211_ATTR_WIPHY, rdev->wiphy_idx) ||
++	    nla_put_u32(msg, NL80211_ATTR_IFINDEX, dev->ifindex) ||
++	    nla_put_u64_64bit(msg, NL80211_ATTR_WDEV, wdev_id(wdev),
++			      NL80211_ATTR_PAD) ||
++	    nla_put_u64_64bit(msg, NL80211_ATTR_COOKIE, event->cookie,
++			      NL80211_ATTR_PAD))
++		goto nla_put_failure;
++
++	if (event->cmd == NL80211_CMD_ADV_TTLM_STARTED &&
++	    (nla_put_u8(msg, NL80211_ATTR_MLO_LINK_ID, event->link_id) ||
++	     nla_put_u16(msg, NL80211_ATTR_MLO_ADV_TTLM_SWITCH_TSF,
++			 event->switch_tsf)))
++		goto nla_put_failure;
++
++	if (event->cmd != NL80211_CMD_ADV_TTLM_ENDED && event->tbtt_boottime &&
++	    nla_put_u64_64bit(msg, NL80211_ATTR_MLO_ADV_TTLM_TBTT_BOOTTIME,
++			      event->tbtt_boottime, NL80211_ATTR_PAD))
++		goto nla_put_failure;
++
++	genlmsg_end(msg, hdr);
++
++	return msg;
++
++ nla_put_failure:
++	nlmsg_free(msg);
++	return NULL;
++}
