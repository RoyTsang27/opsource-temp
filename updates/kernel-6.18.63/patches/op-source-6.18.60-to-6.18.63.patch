@@ -0,0 +1,677 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sun, 11 Oct 2026 20:00:00 +0200
+Subject: [PATCH] wifi: nl80211: add the advertised TID-to-link mapping of an AP
+ MLD
+
+An AP MLD disables a link for all associated non-AP MLDs with an
+advertised TID-to-link mapping (IEEE 802.11be-2024 35.3.7.2.4). cfg80211
+handles the negotiated mapping of a station only, so user space cannot
+request an advertised one.
+
+The mapping depends on timing that user space does not see. It is
+established at a TBTT, the Mapping Switch Time field holds bits 10 to 25
+of the TSF of each link at that TBTT, and the Expected Duration field
+counts down in each Beacon frame once the mapping is established.
+
+Add a command with which user space requests a mapping of all TIDs to a
+set of links for a duration. Add an extended feature with which the
+driver declares that it times the switch and the end, disables the other
+links while the mapping is established and keeps the Expected Duration
+field current. The driver reports the Mapping Switch Time field of each
+link when it scheduled the mapping, then the establishment and the end,
+so that user space builds the element of each step.
+
+cfg80211 keeps one mapping per AP MLD. It rejects a request while
+another mapping is requested or established, and names the mapping with
+a cookie in the reply and in each event. The driver gets the cookie with
+the request and passes it back with each step, so that cfg80211 drops a
+late step of an earlier mapping. cfg80211 checks the cookie and sends
+the event of a step under the event lock of the interface, so that no
+step of a mapping follows the end of the mapping. A link that stops
+beaconing changes the
+links of the AP MLD, so cfg80211 then cancels the mapping in the driver
+with a new operation and ends it for user space.
+
+The remaining Expected Duration of a frame counts from the most recent
+TBTT (9.4.2.324), which user space does not see either. The driver
+reports the CLOCK_BOOTTIME of the TBTT at which the mapping was
+established, and with the start on each link that of the first TBTT of
+the link at or after it. CLOCK_BOOTTIME is the clock of the other
+nl80211 timestamps and the clock that user space reads without a TSF.
+
+Each step enables or disables links, which is a critical update, so a
+request also needs NL80211_EXT_FEATURE_BEACON_CRIT_UPDATE. The Mapping
+Switch Time field holds 16 bits of the TSF in TUs, which bounds the
+switch time to 0xffff TUs.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+---
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -1864,6 +1864,49 @@ struct cfg80211_ttlm_params {
+ };
+ 
+ /**
++ * struct cfg80211_adv_ttlm_params - advertised TID-to-link mapping
++ *
++ * Used with %NL80211_CMD_ADV_TTLM_REQUEST.
++ *
++ * @links: bitmap of the link IDs to which all TIDs map, in both directions
++ * @switch_time: TUs from the request to the establishment of the mapping, at
++ *	most 0xffff
++ * @duration: TUs that the mapping lasts once established, at most 0xffffff
++ * @cookie: cookie of the mapping, set by cfg80211; the driver passes it back
++ *	in each &struct cfg80211_adv_ttlm_event of the mapping
++ */
++struct cfg80211_adv_ttlm_params {
++	u16 links;
++	u32 switch_time;
++	u32 duration;
++	u64 cookie;
++};
++
++/**
++ * struct cfg80211_adv_ttlm_event - step of an advertised TID-to-link mapping
++ *
++ * Used with cfg80211_adv_ttlm_notify().
++ *
++ * @cmd: %NL80211_CMD_ADV_TTLM_STARTED, %NL80211_CMD_ADV_TTLM_ESTABLISHED or
++ *	%NL80211_CMD_ADV_TTLM_ENDED
++ * @cookie: &cfg80211_adv_ttlm_params.cookie of the mapping
++ * @link_id: link ID, with %NL80211_CMD_ADV_TTLM_STARTED only
++ * @switch_tsf: Mapping Switch Time field of the link, with
++ *	%NL80211_CMD_ADV_TTLM_STARTED only
++ * @tbtt_boottime: CLOCK_BOOTTIME in ns of a TBTT, 0 if not known: with
++ *	%NL80211_CMD_ADV_TTLM_STARTED the first TBTT of the link at or after
++ *	the establishment, with %NL80211_CMD_ADV_TTLM_ESTABLISHED the TBTT at
++ *	which the mapping was established
++ */
++struct cfg80211_adv_ttlm_event {
++	enum nl80211_commands cmd;
++	u64 cookie;
++	unsigned int link_id;
++	u16 switch_tsf;
++	u64 tbtt_boottime;
++};
