diff --git a/package/kernel/mac80211/patches/subsys/014-wifi-cfg80211-mac80211-apply-HE-OBSS-PD-settings-on-.patch b/package/kernel/mac80211/patches/subsys/014-wifi-cfg80211-mac80211-apply-HE-OBSS-PD-settings-on-.patch
new file mode 100644
index 00000000..a9ad8804
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/014-wifi-cfg80211-mac80211-apply-HE-OBSS-PD-settings-on-.patch
@@ -0,0 +1,77 @@
+From 2c50cd5d10e8723797f28c7978f1f61688e0c0d2 Mon Sep 17 00:00:00 2001
+From: John Macias <dencity7@gmail.com>
+Date: Sun, 25 Oct 2026 20:58:03 -0700
+Subject: [PATCH] wifi: cfg80211/mac80211: apply HE OBSS PD settings on beacon
+ update
+
+hostapd puts NL80211_ATTR_HE_OBSS_PD into NL80211_CMD_SET_BEACON as well
+as NL80211_CMD_START_AP, but cfg80211 parses it only when the AP starts.
+A change of the spatial reuse parameters therefore reaches the beacon
+but not the driver, and the only way to apply it is to restart the AP,
+which disconnects all stations.
+
+Parse the attribute in the AP update path and apply it in
+ieee80211_change_beacon() when it differs from the current settings.
+
+Assisted-by: LLM
+Signed-off-by: John Macias <dencity7@gmail.com>
+Link: https://patch.msgid.link/20261026035803.2630025-1-dencity7@gmail.com
+Signed-off-by: Johannes Berg <johannes.berg@intel.com>
+[nbd: in 7.2 the AP update attributes are parsed in nl80211_set_beacon(),
+ which has no nl80211_parse_ap_update() yet]
+---
+ include/net/cfg80211.h | 3 +++
+ net/mac80211/cfg.c     | 7 +++++++
+ net/wireless/nl80211.c | 7 +++++++
+ 3 files changed, 17 insertions(+)
+
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -1647,12 +1647,15 @@ struct cfg80211_ap_settings {
+  * @fils_discovery: FILS discovery transmission parameters
+  * @unsol_bcast_probe_resp: Unsolicited broadcast probe response parameters
+  * @s1g_short_beacon: S1G short beacon data
++ * @he_obss_pd: OBSS Packet Detection settings, applied if @he_obss_pd.enable
++ *	is set
+  */
+ struct cfg80211_ap_update {
+ 	struct cfg80211_beacon_data beacon;
+ 	struct cfg80211_fils_discovery fils_discovery;
+ 	struct cfg80211_unsol_bcast_probe_resp unsol_bcast_probe_resp;
+ 	struct cfg80211_s1g_short_beacon s1g_short_beacon;
++	struct ieee80211_he_obss_pd he_obss_pd;
+ };
+ 
+ /**
+--- a/net/mac80211/cfg.c
++++ b/net/mac80211/cfg.c
+@@ -1993,6 +1993,13 @@ static int ieee80211_change_beacon(struc
+ 		changed |= BSS_CHANGED_HE_BSS_COLOR;
+ 	}
+ 
++	if (params->he_obss_pd.enable && link_conf->he_support &&
++	    memcmp(&params->he_obss_pd, &link_conf->he_obss_pd,
++		   sizeof(params->he_obss_pd))) {
++		link_conf->he_obss_pd = params->he_obss_pd;
++		changed |= BSS_CHANGED_HE_OBSS_PD;
++	}
++
+ 	ieee80211_link_info_change_notify(sdata, link, changed);
+ 	return 0;
+ }
+--- a/net/wireless/nl80211.c
++++ b/net/wireless/nl80211.c
+@@ -7568,6 +7568,13 @@ static int nl80211_set_beacon(struct sk_
+ 			goto out;
+ 	}
+ 
++	attr = info->attrs[NL80211_ATTR_HE_OBSS_PD];
++	if (attr) {
++		err = nl80211_parse_he_obss_pd(attr, &params->he_obss_pd);
++		if (err)
++			goto out;
++	}
++
+ 	err = rdev_change_beacon(rdev, dev, params);
+ 
+ out:
diff --git a/package/kernel/mac80211/patches/subsys/014-wifi-mac80211-fix-swapped-fq_overlimit-fq_overmemory.patch b/package/kernel/mac80211/patches/subsys/014-wifi-mac80211-fix-swapped-fq_overlimit-fq_overmemory.patch
new file mode 100644
index 00000000..597d12d8
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/014-wifi-mac80211-fix-swapped-fq_overlimit-fq_overmemory.patch
@@ -0,0 +1,35 @@
+From 25f3f2ff88ae604a3b473b501fc55d58fcb0f5eb Mon Sep 17 00:00:00 2001
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Fri, 4 Sep 2026 11:06:26 +0200
+Subject: [PATCH] wifi: mac80211: fix swapped fq_overlimit/fq_overmemory in aqm
+ debugfs
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+The two scnprintf arguments for fq_overlimit and fq_overmemory are in the
+wrong order, which results in the aqm debugfs file showing the overmemory
+count under the fq_overlimit label and vice versa.
+
+Fixes: 2a4e675d887b ("mac80211: Export fq memory limit information in debugfs")
+Reviewed-by: Toke Høiland-Jørgensen <toke@toke.dk>
+Assisted-by: Claude:claude-opus-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+Link: https://patch.msgid.link/20260904090626.92727-1-julius@bairaktaris.de
+Signed-off-by: Johannes Berg <johannes.berg@intel.com>
+---
+ net/mac80211/debugfs.c | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+--- a/net/mac80211/debugfs.c
++++ b/net/mac80211/debugfs.c
+@@ -97,8 +97,8 @@ static ssize_t aqm_read(struct file *fil
+ 			"RW fq_quantum %u\n",
+ 			fq->flows_cnt,
+ 			fq->backlog,
+-			fq->overmemory,
+ 			fq->overlimit,
++			fq->overmemory,
+ 			fq->collisions,
+ 			fq->memory_usage,
+ 			fq->memory_limit,
diff --git a/package/kernel/mac80211/patches/subsys/015-wifi-mac80211-don-t-reset-the-TXQ-scheduling-round-n.patch b/package/kernel/mac80211/patches/subsys/015-wifi-mac80211-don-t-reset-the-TXQ-scheduling-round-n.patch
new file mode 100644
index 00000000..f923c35a
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/015-wifi-mac80211-don-t-reset-the-TXQ-scheduling-round-n.patch
@@ -0,0 +1,71 @@
+From 8ea81827d3537db7cfcc82c008f052bb1bbe7567 Mon Sep 17 00:00:00 2001
+From: Julius Bairaktaris <julius@bairaktaris.de>
+Date: Tue, 8 Sep 2026 16:41:55 +0200
+Subject: [PATCH] wifi: mac80211: don't reset the TXQ scheduling round number
+MIME-Version: 1.0
+Content-Type: text/plain; charset=UTF-8
+Content-Transfer-Encoding: 8bit
+
+A round is ended when ieee80211_next_txq() meets a txq whose remembered
+round number is the current one, meaning it has gone full circle.
+
+When the AC exceeds the airtime limit, ieee80211_txq_schedule_start()
+sets the round number to 0 to close the round. The next open round is
+1. A txq from an earlier round 1 still remembers the "1", so the next
+round stops on it and serves nothing.
+
+Fix: use a separate open/closed flag and let the round number keep
+counting.
+
+Testing: ~4200 skipped selections per 20s without the fix and 20
+skipped selections per 20s with the fix on ath11k (with my AQL series
+applied) at BE 500/1000.
+
+Fixes: 8e4bac067105 ("wifi: mac80211: add a per-PHY AQL limit to improve fairness")
+Assisted-by: Claude:claude-opus-5
+Signed-off-by: Julius Bairaktaris <julius@bairaktaris.de>
+Reviewed-by: Toke Høiland-Jørgensen <toke@toke.dk>
+Link: https://patch.msgid.link/20260908144155.756569-1-julius@bairaktaris.de
+Signed-off-by: Johannes Berg <johannes.berg@intel.com>
+---
+ net/mac80211/ieee80211_i.h | 1 +
+ net/mac80211/tx.c          | 8 ++++----
+ 2 files changed, 5 insertions(+), 4 deletions(-)
+
+--- a/net/mac80211/ieee80211_i.h
++++ b/net/mac80211/ieee80211_i.h
+@@ -1459,6 +1459,7 @@ struct ieee80211_local {
+ 	spinlock_t active_txq_lock[IEEE80211_NUM_ACS];
+ 	struct list_head active_txqs[IEEE80211_NUM_ACS];
+ 	u16 schedule_round[IEEE80211_NUM_ACS];
++	bool schedule_open[IEEE80211_NUM_ACS];
+ 
+ 	/* serializes ieee80211_handle_wake_tx_queue */
+ 	spinlock_t handle_wake_tx_queue_lock;
+--- a/net/mac80211/tx.c
++++ b/net/mac80211/tx.c
+@@ -4176,7 +4176,7 @@ struct ieee80211_txq *ieee80211_next_txq
+ 
+ 	spin_lock_bh(&local->active_txq_lock[ac]);
+ 
+-	if (!local->schedule_round[ac])
++	if (!local->schedule_open[ac])
+ 		goto out;
+ 
+  begin:
+@@ -4380,12 +4380,12 @@ void ieee80211_txq_schedule_start(struct
+ 
+ 	spin_lock_bh(&local->active_txq_lock[ac]);
+ 
+-	if (ieee80211_txq_schedule_airtime_check(local, ac)) {
++	local->schedule_open[ac] =
++		ieee80211_txq_schedule_airtime_check(local, ac);
++	if (local->schedule_open[ac]) {
+ 		local->schedule_round[ac]++;
+ 		if (!local->schedule_round[ac])
+ 			local->schedule_round[ac]++;
+-	} else {
+-		local->schedule_round[ac] = 0;
+ 	}
+ 
+ 	spin_unlock_bh(&local->active_txq_lock[ac]);
