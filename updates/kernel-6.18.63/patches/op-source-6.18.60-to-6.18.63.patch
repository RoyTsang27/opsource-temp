++++ b/net/mac80211/link.c
+@@ -17,13 +17,13 @@ static void ieee80211_update_apvlan_link
+ 	unsigned long rem = ~sdata->vif.valid_links &
+ 				    GENMASK(IEEE80211_MLD_MAX_NUM_LINKS - 1, 0);
+ 	struct ieee80211_local *local = sdata->local;
+-	unsigned long add = sdata->vif.valid_links;
+ 	struct wiphy *wiphy = local->hw.wiphy;
+ 	struct ieee80211_sub_if_data *vlan;
+ 	struct ieee80211_link_data *link;
+ 	struct sta_info *sta;
+ 
+ 	list_for_each_entry(vlan, &sdata->u.ap.vlans, u.vlan.list) {
++		unsigned long add = sdata->vif.valid_links;
+ 		int link_id;
+ 
+ 		if (vlan->wdev.use_4addr) {
diff --git a/package/kernel/mac80211/patches/subsys/461-wifi-mac80211-follow-the-station-links-on-its-4-addr.patch b/package/kernel/mac80211/patches/subsys/461-wifi-mac80211-follow-the-station-links-on-its-4-addr.patch
new file mode 100644
index 00000000..b2b9a828
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/461-wifi-mac80211-follow-the-station-links-on-its-4-addr.patch
@@ -0,0 +1,257 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 04:20:07 +0200
+Subject: [PATCH] wifi: mac80211: follow the station links on its 4-address AP
+ VLAN
+
+ieee80211_set_sta_4addr() limits a 4-address AP VLAN to the links of
+the AP that its station holds when it moves to the VLAN. A link that
+the station adds later is not added to the VLAN, so
+sta_link_apply_parameters(), which runs on sta->sdata, finds no link
+data and ieee80211_add_link_station() fails with -EINVAL and no log.
+A WDS non-AP MLD thus cannot add by Link Reconfiguration a link it did
+not set up at association. A link it removes stays on the VLAN.
+Reachable via nl80211_add_link_station() and
+nl80211_remove_link_station() for a station on a WDS VLAN.
+
+Keep the links of a 4-address VLAN equal to the links of the AP that
+its station holds, also when the station adds or removes a link, as
+ieee80211_set_sta_4addr() and ieee80211_update_apvlan_links() do. The
+VLAN takes the new link before the link parameters are applied, and
+gives it back if the addition fails.
+
+While here, clear in the wireless_dev of the VLAN, on an AP link
+change, the links that its station does not hold, as
+ieee80211_set_sta_4addr() does.
+
+Fixes: 469d5d5a3b7a ("wifi: mac80211: synchronize valid links for WDS AP_VLAN interfaces")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/cfg.c
++++ b/net/mac80211/cfg.c
+@@ -2790,13 +2790,7 @@ static int ieee80211_set_sta_4addr(struc
+ 				   struct ieee80211_sub_if_data *sdata,
+ 				   struct sta_info *sta)
+ {
+-	struct ieee80211_vif *vif = &sdata->vif;
+-	struct wiphy *wiphy = local->hw.wiphy;
+ 	struct ieee80211_sub_if_data *master;
+-	struct ieee80211_bss_conf *link_conf;
+-	struct wireless_dev *wdev;
+-	unsigned long master_iter;
+-	int link_id;
+ 	int err;
+ 
+ 	lockdep_assert_wiphy(local->hw.wiphy);
+@@ -2804,38 +2798,16 @@ static int ieee80211_set_sta_4addr(struc
+ 	if (sdata->u.vlan.sta)
+ 		return -EBUSY;
+ 
+-	wdev = &sdata->wdev;
+ 	master = container_of(sdata->bss,
+ 			      struct ieee80211_sub_if_data,
+ 			      u.ap);
+ 
+ 	if (sta->sta.valid_links) {
+-		u16 sta_links = sta->sta.valid_links;
+-		u16 new_links = master->vif.valid_links & sta_links;
+-		u16 orig_links = wdev->valid_links;
+-
+-		wdev->valid_links = new_links;
+-
+-		err = ieee80211_vif_set_links(sdata, new_links, 0);
+-		if (err) {
+-			wdev->valid_links = orig_links;
++		err = ieee80211_apvlan_set_links(sdata,
++						 master->vif.valid_links &
++						 sta->sta.valid_links);
++		if (err)
+ 			return err;
+-		}
+-
+-		master_iter = master->vif.valid_links;
+-
+-		for_each_set_bit(link_id, &master_iter,
+-				 IEEE80211_MLD_MAX_NUM_LINKS) {
+-			if (!(sta_links & BIT(link_id))) {
+-				eth_zero_addr(wdev->links[link_id].addr);
+-			} else {
+-				link_conf = wiphy_dereference(wiphy,
+-							      vif->link_conf[link_id]);
+-
+-				ether_addr_copy(wdev->links[link_id].addr,
+-						link_conf->bssid);
+-			}
+-		}
+ 	}
+ 
+ 	rcu_assign_pointer(sdata->u.vlan.sta, sta);
+@@ -6006,14 +5978,19 @@ ieee80211_add_link_station(struct wiphy
+ 	if (sta->sta.valid_links & BIT(params->link_id))
+ 		return -EALREADY;
+ 
+-	ret = ieee80211_sta_allocate_link(sta, params->link_id);
++	ret = ieee80211_apvlan_sync_sta_links(sta, sta->sta.valid_links |
++						    BIT(params->link_id));
+ 	if (ret)
+ 		return ret;
+ 
++	ret = ieee80211_sta_allocate_link(sta, params->link_id);
++	if (ret)
++		goto out;
++
+ 	ret = sta_link_apply_parameters(local, sta, STA_LINK_MODE_NEW, params);
+ 	if (ret) {
+ 		ieee80211_sta_free_link(sta, params->link_id);
+-		return ret;
++		goto out;
+ 	}
+ 
+ 	if (test_sta_flag(sta, WLAN_STA_ASSOC)) {
+@@ -6024,7 +6001,11 @@ ieee80211_add_link_station(struct wiphy
+ 	}
+ 
+ 	/* ieee80211_sta_activate_link frees the link upon failure */
+-	return ieee80211_sta_activate_link(sta, params->link_id);
++	ret = ieee80211_sta_activate_link(sta, params->link_id);
++out:
++	if (ret)
++		ieee80211_apvlan_sync_sta_links(sta, sta->sta.valid_links);
++	return ret;
+ }
+ 
+ static int
+@@ -6069,6 +6050,7 @@ ieee80211_del_link_station(struct wiphy
+ 		return -EINVAL;
+ 
+ 	ieee80211_sta_remove_link(sta, params->link_id);
++	ieee80211_apvlan_sync_sta_links(sta, sta->sta.valid_links);
+ 
+ 	return 0;
+ }
+--- a/net/mac80211/ieee80211_i.h
++++ b/net/mac80211/ieee80211_i.h
+@@ -2300,6 +2300,9 @@ static inline void ieee80211_vif_clear_l
+ 
+ void ieee80211_apvlan_link_setup(struct ieee80211_sub_if_data *sdata);
+ void ieee80211_apvlan_link_clear(struct ieee80211_sub_if_data *sdata);
++int ieee80211_apvlan_set_links(struct ieee80211_sub_if_data *vlan,
++			       u16 new_links);
++int ieee80211_apvlan_sync_sta_links(struct sta_info *sta, u16 sta_links);
+ 
+ /* tx handling */
+ void ieee80211_clear_tx_pending(struct ieee80211_local *local);
+--- a/net/mac80211/link.c
++++ b/net/mac80211/link.c
+@@ -12,47 +12,82 @@
+ #include "key.h"
+ #include "debugfs_netdev.h"
+ 
++static void ieee80211_apvlan_set_wdev_links(struct ieee80211_sub_if_data *vlan,
++					    struct ieee80211_sub_if_data *ap,
++					    u16 links)
++{
++	int link_id;
++
++	vlan->wdev.valid_links = links;
++
++	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++) {
++		if (links & BIT(link_id))
++			ether_addr_copy(vlan->wdev.links[link_id].addr,
++					ap->wdev.links[link_id].addr);
++		else
++			eth_zero_addr(vlan->wdev.links[link_id].addr);
++	}
++}
++
++int ieee80211_apvlan_set_links(struct ieee80211_sub_if_data *vlan,
++			       u16 new_links)
++{
++	struct ieee80211_sub_if_data *ap = container_of(vlan->bss,
++					struct ieee80211_sub_if_data, u.ap);
++	u16 old_links = vlan->wdev.valid_links;
++	struct ieee80211_link_data *link;
++	unsigned long links = new_links;
++	int link_id;
++	int ret;
++
++	if (new_links == vlan->vif.valid_links)
++		return 0;
++
++	ieee80211_apvlan_set_wdev_links(vlan, ap, new_links);
++
++	ret = ieee80211_vif_set_links(vlan, new_links, 0);
++	if (ret) {
++		ieee80211_apvlan_set_wdev_links(vlan, ap, old_links);
++		return ret;
++	}
++
++	for_each_set_bit(link_id, &links, IEEE80211_MLD_MAX_NUM_LINKS) {
++		link = sdata_dereference(vlan->link[link_id], vlan);
++		ieee80211_link_vlan_copy_chanctx(link);
++	}
++
++	return 0;
++}
++
++int ieee80211_apvlan_sync_sta_links(struct sta_info *sta, u16 sta_links)
++{
++	struct ieee80211_sub_if_data *vlan = sta->sdata;
++	struct ieee80211_sub_if_data *ap;
++
++	if (vlan->vif.type != NL80211_IFTYPE_AP_VLAN || !vlan->wdev.use_4addr)
++		return 0;
++
++	ap = container_of(vlan->bss, struct ieee80211_sub_if_data, u.ap);
++
++	return ieee80211_apvlan_set_links(vlan, ap->vif.valid_links & sta_links);
++}
++
+ static void ieee80211_update_apvlan_links(struct ieee80211_sub_if_data *sdata)
+ {
+-	unsigned long rem = ~sdata->vif.valid_links &
+-				    GENMASK(IEEE80211_MLD_MAX_NUM_LINKS - 1, 0);
+-	struct ieee80211_local *local = sdata->local;
+-	struct wiphy *wiphy = local->hw.wiphy;
++	struct wiphy *wiphy = sdata->local->hw.wiphy;
+ 	struct ieee80211_sub_if_data *vlan;
+-	struct ieee80211_link_data *link;
+ 	struct sta_info *sta;
+ 
+ 	list_for_each_entry(vlan, &sdata->u.ap.vlans, u.vlan.list) {
+-		unsigned long add = sdata->vif.valid_links;
+-		int link_id;
++		u16 links = sdata->vif.valid_links;
+ 
+ 		if (vlan->wdev.use_4addr) {
+-			sta = wiphy_dereference(wiphy,
+-						vlan->u.vlan.sta);
++			sta = wiphy_dereference(wiphy, vlan->u.vlan.sta);
+ 			if (sta)
+-				add = add & sta->sta.valid_links;
+-		}
+-
+-		if (add == vlan->vif.valid_links)
+-			continue;
+-
+-		for_each_set_bit(link_id, &add, IEEE80211_MLD_MAX_NUM_LINKS) {
+-			vlan->wdev.valid_links |= BIT(link_id);
+-			ether_addr_copy(vlan->wdev.links[link_id].addr,
+-					sdata->wdev.links[link_id].addr);
+-		}
+-
+-		for_each_set_bit(link_id, &rem, IEEE80211_MLD_MAX_NUM_LINKS) {
+-			vlan->wdev.valid_links &= ~BIT(link_id);
+-			eth_zero_addr(vlan->wdev.links[link_id].addr);
++				links &= sta->sta.valid_links;
+ 		}
+ 
+-		ieee80211_vif_set_links(vlan, add, 0);
+-
+-		for_each_set_bit(link_id, &add, IEEE80211_MLD_MAX_NUM_LINKS) {
+-			link = sdata_dereference(vlan->link[link_id], vlan);
+-			ieee80211_link_vlan_copy_chanctx(link);
+-		}
++		ieee80211_apvlan_set_links(vlan, links);
+ 	}
+ }
+ 
diff --git a/package/kernel/mac80211/patches/subsys/462-wifi-mac80211-remove-the-stations-of-an-AP-VLAN-befo.patch b/package/kernel/mac80211/patches/subsys/462-wifi-mac80211-remove-the-stations-of-an-AP-VLAN-befo.patch
new file mode 100644
index 00000000..717263d4
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/462-wifi-mac80211-remove-the-stations-of-an-AP-VLAN-befo.patch
@@ -0,0 +1,50 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 09:38:44 +0200
+Subject: [PATCH] wifi: mac80211: remove the stations of an AP VLAN before its
+ links
+
+ieee80211_do_stop() clears the links of an AP VLAN through
+ieee80211_apvlan_link_clear() before it flushes the stations of the
+VLAN. ieee80211_vif_update_links() then finds the station of a VLAN
+that goes down while a station of an AP MLD is on it, and warns:
+
+  WARNING: net/mac80211/link.c:352 at ieee80211_vif_update_links+0xcec/0xd30
+  Call Trace:
+   ieee80211_vif_set_links+0x3d/0x80
+   ieee80211_do_stop+0x768/0xa80
+   ieee80211_stop+0x7e/0x130
+   __dev_close_many+0xdb/0x1a0
+
+Reachable by setting a WDS VLAN down, or by removing the radio, while
+its station is associated. Before commit ae6691b8c1fd ("wifi: mac80211:
+check stations are removed before MLD change") the VLAN lost its
+debugfs directory, station directories included, before the stations
+were removed.
+
+Clear the links of an AP VLAN only after its stations are removed.
+
+Fixes: 90233b0ad215 ("wifi: mac80211: Create separate links for VLAN interfaces")
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/net/mac80211/iface.c
++++ b/net/mac80211/iface.c
+@@ -511,9 +511,6 @@ static void ieee80211_do_stop(struct iee
+ 	case NL80211_IFTYPE_MONITOR:
+ 		list_del_rcu(&sdata->u.mntr.list);
+ 		break;
+-	case NL80211_IFTYPE_AP_VLAN:
+-		ieee80211_apvlan_link_clear(sdata);
+-		break;
+ 	default:
+ 		break;
+ 	}
+@@ -537,6 +534,9 @@ static void ieee80211_do_stop(struct iee
+ 		     sdata->vif.type != NL80211_IFTYPE_NAN &&
+ 		     sdata->vif.type != NL80211_IFTYPE_NAN_DATA && flushed > 0);
+ 
++	if (sdata->vif.type == NL80211_IFTYPE_AP_VLAN)
++		ieee80211_apvlan_link_clear(sdata);
++
+ 	/* don't count this interface for allmulti while it is down */
+ 	if (sdata->flags & IEEE80211_SDATA_ALLMULTI)
+ 		atomic_dec(&local->iff_allmultis);
diff --git a/package/kernel/mac80211/patches/subsys/465-wifi-nl80211-add-a-client-to-SCS-and-MSCS-descriptor.patch b/package/kernel/mac80211/patches/subsys/465-wifi-nl80211-add-a-client-to-SCS-and-MSCS-descriptor.patch
new file mode 100644
index 00000000..2fe9ea82
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/465-wifi-nl80211-add-a-client-to-SCS-and-MSCS-descriptor.patch
@@ -0,0 +1,231 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 24 Oct 2026 14:00:00 +0200
+Subject: [PATCH] wifi: nl80211: add a client to SCS and MSCS descriptors
+
+An AP that serves a 4-address peer, such as the backhaul station of a
+Multi-AP Agent, sends the traffic of every host behind that peer to it.
+Wi-Fi EasyMesh 6.0, 20.2.4 requires the Agent to identify the downlink
+flows of such a host by the destination and source addresses of the
+MSDU, not by the transmitter and receiver addresses.
