new file mode 100644
index 00000000..e5e8dd41
--- /dev/null
+++ b/target/linux/generic/pending-6.18/797-00-wifi-cfg80211-add-the-flow-key-and-flow-description-.patch
@@ -0,0 +1,163 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Thu, 15 Oct 2026 12:00:00 +0200
+Subject: [PATCH] wifi: cfg80211: add the flow key and flow description types
+
+The PPE driver of mtk_eth_soc describes an offloaded flow to the
+wireless driver with struct cfg80211_flow_info, which the SCS and MSCS
+patches of the mac80211 package add to the cfg80211 header of the
+backports tree. The Ethernet driver builds against the kernel header,
+so add the same types there. The layout must match the backports copy,
+since the Ethernet driver fills the structure and the wireless driver
+reads it.
+
+The two copies are separate definitions, so a change to one of them
+still builds and then corrupts the data on the other side. Assert the
+offset of each field, the size of each structure and the value of each
+flow field. The mac80211 package asserts the same values for its copy.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -4013,6 +4013,141 @@ struct cfg80211_nan_band_config {
+ };
+ 
+ /**
++ * enum cfg80211_flow_field - classifier parameter of one MSDU
++ *
++ * A set of these is held as a bitmap of BIT(field) in a u32.
++ *
++ * @CFG80211_FLOW_F_ETH_SA: Ethernet source address
++ * @CFG80211_FLOW_F_ETH_DA: Ethernet destination address
++ * @CFG80211_FLOW_F_ETH_TYPE: ethertype
++ * @CFG80211_FLOW_F_VLAN_PCP: IEEE 802.1Q priority code point
++ * @CFG80211_FLOW_F_VLAN_DEI: IEEE 802.1Q drop eligibility indicator
++ * @CFG80211_FLOW_F_VLAN_VID: IEEE 802.1Q VLAN identifier
++ * @CFG80211_FLOW_F_IP_VERSION: IP version
++ * @CFG80211_FLOW_F_IP_SRC: IP source address
++ * @CFG80211_FLOW_F_IP_DST: IP destination address
++ * @CFG80211_FLOW_F_SRC_PORT: layer 4 source port
++ * @CFG80211_FLOW_F_DST_PORT: layer 4 destination port
++ * @CFG80211_FLOW_F_DSCP: differentiated services code point
++ * @CFG80211_FLOW_F_PROTO: IPv4 protocol or IPv6 next header
++ * @CFG80211_FLOW_F_FLOW_LABEL: IPv6 flow label
++ * @NUM_CFG80211_FLOW_FIELDS: number of fields
++ */
++enum cfg80211_flow_field {
++	CFG80211_FLOW_F_ETH_SA,
++	CFG80211_FLOW_F_ETH_DA,
++	CFG80211_FLOW_F_ETH_TYPE,
++	CFG80211_FLOW_F_VLAN_PCP,
++	CFG80211_FLOW_F_VLAN_DEI,
++	CFG80211_FLOW_F_VLAN_VID,
++	CFG80211_FLOW_F_IP_VERSION,
++	CFG80211_FLOW_F_IP_SRC,
++	CFG80211_FLOW_F_IP_DST,
++	CFG80211_FLOW_F_SRC_PORT,
++	CFG80211_FLOW_F_DST_PORT,
++	CFG80211_FLOW_F_DSCP,
++	CFG80211_FLOW_F_PROTO,
++	CFG80211_FLOW_F_FLOW_LABEL,
++
++	NUM_CFG80211_FLOW_FIELDS,
++};
++
++/**
++ * struct cfg80211_flow_key - masked classifier parameters of one MSDU
++ *
++ * Unselected fields are zero. The whole structure is hashed and compared as a
++ * byte string, so it must contain no undefined octet.
++ *
++ * @src: IP source address, IPv4 in the first four octets
++ * @dst: IP destination address, IPv4 in the first four octets
++ * @flow_label: IPv6 flow label
++ * @sa: Ethernet source address
++ * @da: Ethernet destination address
++ * @eth_type: ethertype
++ * @vlan_tci: IEEE 802.1Q tag control information
++ * @src_port: layer 4 source port
++ * @dst_port: layer 4 destination port
++ * @ip_version: IP version, which keeps IPv4 and IPv6 keys apart
++ * @dscp: differentiated services code point, in the six LSBs
++ * @proto: IPv4 protocol or IPv6 next header
++ * @pad: must be zero
++ */
++struct cfg80211_flow_key {
++	struct in6_addr src;
++	struct in6_addr dst;
++	__be32 flow_label;
++	u8 sa[ETH_ALEN];
++	u8 da[ETH_ALEN];
++	__be16 eth_type;
++	__be16 vlan_tci;
++	__be16 src_port;
++	__be16 dst_port;
++	u8 ip_version;
++	u8 dscp;
++	u8 proto;
++	u8 pad;
++};
++
++/**
++ * struct cfg80211_flow_info - classifier parameters of one MSDU
++ *
++ * @key: every parameter the source carries, with nothing masked out
++ * @present: bitmap of &enum cfg80211_flow_field, the parameters the source
++ *	actually carries. A classifier that names an absent parameter cannot
++ *	match.
++ * @skb: the frame the parameters came from, or %NULL when the caller
++ *	describes a flow rather than a frame. A filter classifier reads the
++ *	frame again and cannot be evaluated without it.
++ * @l3_off: offset of the IP header in @skb
++ */
++struct cfg80211_flow_info {
++	struct cfg80211_flow_key key;
++	u32 present;
++	const struct sk_buff *skb;
++	u16 l3_off;
++};
++
++/*
++ * The kernel and the backports tree each define these types, and a structure
++ * crosses from one build to the other, so both keep this layout.
++ */
++static_assert(CFG80211_FLOW_F_ETH_SA == 0);
++static_assert(CFG80211_FLOW_F_ETH_DA == 1);
++static_assert(CFG80211_FLOW_F_ETH_TYPE == 2);
++static_assert(CFG80211_FLOW_F_VLAN_PCP == 3);
++static_assert(CFG80211_FLOW_F_VLAN_DEI == 4);
++static_assert(CFG80211_FLOW_F_VLAN_VID == 5);
++static_assert(CFG80211_FLOW_F_IP_VERSION == 6);
++static_assert(CFG80211_FLOW_F_IP_SRC == 7);
++static_assert(CFG80211_FLOW_F_IP_DST == 8);
++static_assert(CFG80211_FLOW_F_SRC_PORT == 9);
++static_assert(CFG80211_FLOW_F_DST_PORT == 10);
++static_assert(CFG80211_FLOW_F_DSCP == 11);
++static_assert(CFG80211_FLOW_F_PROTO == 12);
++static_assert(CFG80211_FLOW_F_FLOW_LABEL == 13);
++static_assert(NUM_CFG80211_FLOW_FIELDS == 14);
++static_assert(offsetof(struct cfg80211_flow_key, src) == 0);
++static_assert(offsetof(struct cfg80211_flow_key, dst) == 16);
++static_assert(offsetof(struct cfg80211_flow_key, flow_label) == 32);
++static_assert(offsetof(struct cfg80211_flow_key, sa) == 36);
++static_assert(offsetof(struct cfg80211_flow_key, da) == 42);
++static_assert(offsetof(struct cfg80211_flow_key, eth_type) == 48);
++static_assert(offsetof(struct cfg80211_flow_key, vlan_tci) == 50);
++static_assert(offsetof(struct cfg80211_flow_key, src_port) == 52);
++static_assert(offsetof(struct cfg80211_flow_key, dst_port) == 54);
++static_assert(offsetof(struct cfg80211_flow_key, ip_version) == 56);
++static_assert(offsetof(struct cfg80211_flow_key, dscp) == 57);
++static_assert(offsetof(struct cfg80211_flow_key, proto) == 58);
++static_assert(offsetof(struct cfg80211_flow_key, pad) == 59);
++static_assert(sizeof(struct cfg80211_flow_key) == 60);
++static_assert(offsetof(struct cfg80211_flow_info, key) == 0);
++static_assert(offsetof(struct cfg80211_flow_info, present) == 60);
++static_assert(offsetof(struct cfg80211_flow_info, skb) == 64);
++static_assert(offsetof(struct cfg80211_flow_info, l3_off) ==
++	      64 + sizeof(void *));
++static_assert(sizeof(struct cfg80211_flow_info) == 64 + 2 * sizeof(void *));
++
++/**
+  * struct cfg80211_nan_conf - NAN configuration
+  *
+  * This struct defines NAN configuration parameters
diff --git a/target/linux/generic/pending-6.18/797-01-net-ethernet-mtk_eth_soc-query-the-wireless-driver-f.patch b/target/linux/generic/pending-6.18/797-01-net-ethernet-mtk_eth_soc-query-the-wireless-driver-f.patch
new file mode 100644
index 00000000..55776fae
--- /dev/null
+++ b/target/linux/generic/pending-6.18/797-01-net-ethernet-mtk_eth_soc-query-the-wireless-driver-f.patch
@@ -0,0 +1,825 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sun, 30 Aug 2026 01:44:29 +0200
+Subject: [PATCH] net: ethernet: mtk_eth_soc: query the wireless driver for the
+ flow TID
+
+Packets that the PPE forwards to a WLAN station bypass the wireless
+stack, so the SCS and MSCS rules of the station are not applied to
+them. Query the wireless driver for the user priority of a flow before
+the entry is bound, and store the result in the TID field of the WINFO
+data. Only netsys v3 has this field.
+
+The query happens in __mtk_ppe_check_skb(), because that is the only
+place where the flow of an entry is known for both rule based entries
+and the learned subflows of a bridge entry. The flow description is
+built from the FOE entry and only includes the fields that the entry
+matches on, since one answer has to be valid for every packet that hits
+the entry. This leaves out the DSCP, which varies per packet, and the
+ports of 3-tuple entries. If the driver cannot answer with the fields
+provided, the entry stays unbound.
+
+The DSCP of the packet that binds the entry is passed along for the
+QoS map fallback, so that a flow without a matching rule gets the
+priority that the software path gives its frames, instead of TID 0.
+
+Add a flush callback for the wireless driver to use when the rules of
+a station change, or when the learned priority of one flow changes. It
+unbinds the matching entries of that station, so that the next packet
+binds them again with a fresh query. A bridge entry has no hardware
+entry of its own, so its subflows are removed instead and learned
+again. The wireless driver selects the entries, since matching a flow
+key needs cfg80211.
+
+An AP learns the priority of an MSCS flow from its uplink frames, which
+an offloaded uplink keeps from the wireless stack. A flush of a station
+therefore also unbinds the flows that come from it. An entry records
+the station when the WED receive path binds it. The flow key of the
+wireless driver describes the frames to the station, so the match
+callback learns whether an entry carries the frames of the station. For
+such an entry the flow description takes the tuple before NAT, as the
+station sent it. A routed entry holds the MAC addresses of the next hop,
+so its description leaves them out.
+
+The query runs in the receive path, where hw_lock cannot be taken.
+Publish the WED device for it through a separate RCU protected pointer,
+which is cleared and synchronised before the device is detached.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.h
++++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.h
+@@ -1576,6 +1576,8 @@ int mtk_gmac_usxgmii_path_setup(struct m
+ int mtk_eth_offload_init(struct mtk_eth *eth, u8 id);
+ int mtk_eth_setup_tc(struct net_device *dev, enum tc_setup_type type,
+ 		     void *type_data);
++void mtk_flow_offload_unbind_wcid(struct mtk_eth *eth, int wed_index, u16 wcid,
++				  struct mtk_flow_match *match);
+ int mtk_flow_offload_cmd(struct mtk_eth *eth, struct flow_cls_offload *cls,
+ 			 int ppe_index);
+ void mtk_flow_offload_cleanup(struct mtk_eth *eth, struct list_head *list);
+--- a/drivers/net/ethernet/mediatek/mtk_ppe.c
++++ b/drivers/net/ethernet/mediatek/mtk_ppe.c
+@@ -9,11 +9,13 @@
+ #include <linux/if_ether.h>
+ #include <linux/if_vlan.h>
+ 
++#include <net/cfg80211.h>
+ #include <net/dst_metadata.h>
+ #include <net/dsa.h>
+ #include <net/ipv6.h>
+ 
+ #include "mtk_eth_soc.h"
++#include "mtk_wed.h"
+ #include "mtk_ppe.h"
+ #include "mtk_ppe_regs.h"
+ 
+@@ -475,6 +477,160 @@ int mtk_foe_entry_set_wdma(struct mtk_et
+ 	return 0;
+ }
+ 
++/*
++ * Only report the fields that the entry matches on, since the answer has to
++ * hold for every packet that hits it. This excludes the DSCP and the ports of
++ * 3-tuple entries. An entry with @rx set carries the frames of a station, so
++ * its tuple is taken before NAT, as the station sent it.
++ */
++static void
++mtk_foe_entry_get_flow(struct mtk_eth *eth, struct mtk_foe_entry *entry,
++		       bool rx, struct cfg80211_flow_info *info)
++{
++	int type = mtk_get_ib1_pkt_type(eth, entry->ib1);
++	struct mtk_foe_mac_info *l2;
++	struct mtk_ipv4_tuple *t;
++	int i;
++
++	memset(info, 0, sizeof(*info));
++	info->key.proto = entry->ib1 & MTK_FOE_IB1_UDP ? IPPROTO_UDP
++						       : IPPROTO_TCP;
++
++	l2 = mtk_foe_entry_l2(eth, entry);
++	put_unaligned_be32(l2->dest_mac_hi, info->key.da);
++	put_unaligned_be16(l2->dest_mac_lo, info->key.da + 4);
++	put_unaligned_be32(l2->src_mac_hi, info->key.sa);
++	put_unaligned_be16(l2->src_mac_lo, info->key.sa + 4);
++	info->key.eth_type = htons(l2->etype);
++	info->present = BIT(CFG80211_FLOW_F_ETH_DA) |
++			BIT(CFG80211_FLOW_F_ETH_SA) |
++			BIT(CFG80211_FLOW_F_ETH_TYPE);
++
++	switch (type) {
++	case MTK_PPE_PKT_TYPE_IPV4_HNAPT:
++	case MTK_PPE_PKT_TYPE_IPV4_ROUTE:
++		if (type == MTK_PPE_PKT_TYPE_IPV4_HNAPT && !rx)
++			t = &entry->ipv4.new;
++		else
++			t = &entry->ipv4.orig;
++		info->key.ip_version = 4;
++		info->key.src.s6_addr32[0] = cpu_to_be32(t->src_ip);
++		info->key.dst.s6_addr32[0] = cpu_to_be32(t->dest_ip);
++
++		if (type == MTK_PPE_PKT_TYPE_IPV4_ROUTE) {
++			info->key.proto = t->protocol;
++			break;
++		}
++
++		info->key.src_port = cpu_to_be16(t->src_port);
++		info->key.dst_port = cpu_to_be16(t->dest_port);
++		info->present |= BIT(CFG80211_FLOW_F_SRC_PORT) |
++				 BIT(CFG80211_FLOW_F_DST_PORT);
++		break;
++	case MTK_PPE_PKT_TYPE_IPV6_ROUTE_3T:
++	case MTK_PPE_PKT_TYPE_IPV6_ROUTE_5T:
++		info->key.ip_version = 6;
++		for (i = 0; i < 4; i++) {
++			info->key.src.s6_addr32[i] =
++				cpu_to_be32(entry->ipv6.src_ip[i]);
++			info->key.dst.s6_addr32[i] =
++				cpu_to_be32(entry->ipv6.dest_ip[i]);
++		}
++
++		if (type == MTK_PPE_PKT_TYPE_IPV6_ROUTE_3T) {
++			info->key.proto = entry->ipv6.protocol;
++			break;
++		}
++
++		info->key.src_port = cpu_to_be16(entry->ipv6.src_port);
++		info->key.dst_port = cpu_to_be16(entry->ipv6.dest_port);
++		info->present |= BIT(CFG80211_FLOW_F_SRC_PORT) |
++				 BIT(CFG80211_FLOW_F_DST_PORT);
++		break;
++	default:
++		info->key.proto = 0;
++		return;
++	}
++
++	info->present |= BIT(CFG80211_FLOW_F_IP_VERSION) |
++			 BIT(CFG80211_FLOW_F_IP_SRC) |
++			 BIT(CFG80211_FLOW_F_IP_DST) |
++			 BIT(CFG80211_FLOW_F_PROTO);
++}
++
++static void
++mtk_foe_entry_set_tid(struct mtk_eth *eth, struct mtk_foe_entry *entry, u8 tid)
++{
++	struct mtk_foe_mac_info *l2;
++
++	if (!mtk_is_netsys_v3_or_greater(eth))
++		return;
++
++	l2 = mtk_foe_entry_l2(eth, entry);
++	l2->amsdu &= ~MTK_FOE_WINFO_AMSDU_TID;
++	l2->amsdu |= FIELD_PREP(MTK_FOE_WINFO_AMSDU_TID, tid);
++}
++
++/* The DSCP of the packet that binds an entry, for the QoS map fallback */
++static int mtk_ppe_skb_dscp(struct sk_buff *skb)
++{
++	int off = skb_mac_header(skb) - skb->data + 2 * ETH_ALEN;
++	__be16 proto = skb->protocol;
++	u8 buf[2], *p;
++
++	if (proto == htons(ETH_P_XDSA)) {
++		if (!skb_metadata_dst(skb))
++			off += 4;
++
++		p = skb_header_pointer(skb, off, 2, buf);
++		if (!p)
++			return -1;
++
++		proto = get_unaligned((__be16 *)p);
++	}
++
++	while (eth_type_vlan(proto)) {
++		p = skb_header_pointer(skb, off + 4, 2, buf);
++		if (!p)
++			return -1;
++
++		proto = get_unaligned((__be16 *)p);
++		off += 4;
++	}
++
++	p = skb_header_pointer(skb, off + 2, 2, buf);
++	if (!p)
++		return -1;
++
++	switch (proto) {
++	case htons(ETH_P_IP):
++		return p[1] >> 2;
++	case htons(ETH_P_IPV6):
++		return ((p[0] & 0xf) << 2) | (p[1] >> 6);
++	default:
++		return -1;
++	}
++}
++
++static bool
++mtk_foe_entry_set_prio(struct mtk_ppe *ppe, struct mtk_flow_entry *base,
