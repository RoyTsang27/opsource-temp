+ 	rx_token_id = FIELD_GET(RRO_RXDMAD_DATA2_RX_TOKEN_ID_MASK, data2);
+ 	t = mt76_rx_token_release(dev, rx_token_id);
+ 	if (!t)
+@@ -483,11 +488,6 @@ mt76_dma_get_rxdmad_c_buf(struct mt76_dev *dev, struct mt76_queue *q,
+ 				SKB_WITH_OVERHEAD(q->buf_size),
+ 				page_pool_get_dma_dir(q->page_pool));
+ 
+-	if (len)
+-		*len = FIELD_GET(RRO_RXDMAD_DATA1_SDL0_MASK, data1);
+-	if (more)
+-		*more = !FIELD_GET(RRO_RXDMAD_DATA1_LS_MASK, data1);
+-
+ 	buf = t->ptr;
+ 	ind_reason = FIELD_GET(RRO_RXDMAD_DATA2_IND_REASON_MASK, data2);
+ 	if (ind_reason == MT_DMA_WED_IND_REASON_REPEAT ||
+@@ -535,8 +535,11 @@ mt76_dma_get_buf(struct mt76_dev *dev, struct mt76_queue *q, int idx,
+ 		u32 token = FIELD_GET(MT_DMA_CTL_TOKEN, buf1);
+ 		struct mt76_txwi_cache *t = mt76_rx_token_release(dev, token);
+ 
+-		if (!t)
+-			return NULL;
++		if (!t) {
++			/* The descriptor was consumed even without a buffer. */
++			buf = flush ? NULL : ERR_PTR(-EAGAIN);
++			goto done;
++		}
+ 
+ 		dma_sync_single_for_cpu(dev->dma_dev, t->dma_addr,
+ 				SKB_WITH_OVERHEAD(q->buf_size),
+@@ -924,6 +927,7 @@ mt76_dma_rx_cleanup(struct mt76_dev *dev, struct mt76_queue *q)
+ 		dev_kfree_skb(q->rx_head);
+ 		q->rx_head = NULL;
+ 	}
++	q->rx_drop = false;
+ 
+ 	spin_unlock_bh(&q->lock);
+ }
+@@ -972,29 +976,20 @@ mt76_dma_rx_reset(struct mt76_dev *dev, enum mt76_rxq_id qid)
+ 
+ static void
+ mt76_add_fragment(struct mt76_dev *dev, struct mt76_queue *q, void *data,
+-		  int len, bool more, u32 info, bool allow_direct)
++		  int len, bool more, u32 info)
+ {
+ 	struct sk_buff *skb = q->rx_head;
+ 	struct skb_shared_info *shinfo = skb_shinfo(skb);
