++	params.cookie = cookie;
++
++	err = rdev_adv_ttlm_request(rdev, dev, &params);
++	if (err) {
++		atomic64_set(&wdev->u.ap.adv_ttlm_cookie, 0);
++		goto free_msg;
++	}
++
++	genlmsg_end(msg, hdr);
++
++	return genlmsg_reply(msg, info);
++
++ free_msg:
++	nlmsg_free(msg);
++	return err;
++}
