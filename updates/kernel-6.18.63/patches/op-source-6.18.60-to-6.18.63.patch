diff --git a/package/kernel/mac80211/patches/subsys/446-wifi-cfg80211-report-an-undecided-SCS-evaluation.patch b/package/kernel/mac80211/patches/subsys/446-wifi-cfg80211-report-an-undecided-SCS-evaluation.patch
new file mode 100644
index 00000000..2ddeedab
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/446-wifi-cfg80211-report-an-undecided-SCS-evaluation.patch
@@ -0,0 +1,114 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 22 Sep 2026 10:42:48 +0200
+Subject: [PATCH] wifi: cfg80211: report an undecided SCS evaluation
+
+A caller that evaluates a flow instead of a frame, such as a driver
+that offloads flows to hardware, has no frame for a filter classifier
+and may lack parameters that a classifier selects. A descriptor that
+did not match for that reason could still match a frame of the flow,
+so the caller must not derive a per flow rule from the verdict.
+
+Add an undecided flag to the verdict. It is set when a descriptor that
+did not match selects a parameter that the flow does not carry, and
+matched on nothing else. The transmit path ignores it, since a frame
+without the parameter cannot match.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -4331,11 +4331,15 @@ struct cfg80211_mscs_desc {
+  * struct cfg80211_scs_verdict - result of an SCS evaluation
+  *
+  * @match: an SCS descriptor matched the MSDU
++ * @undecided: a descriptor that did not match selects a parameter that the
++ *	MSDU lacks. A caller that evaluates a flow instead of a frame must
++ *	not derive a flow rule from this verdict.
+  * @scsid: identifier of the matching descriptor
+  * @up: user priority to assign
+  */
+ struct cfg80211_scs_verdict {
+ 	bool match;
++	bool undecided;
+ 	u8 scsid;
+ 	u8 up;
+ };
+--- a/net/wireless/scs.c
++++ b/net/wireless/scs.c
+@@ -756,14 +756,18 @@ static bool tclas_filter_offset(const st
+ }
+ 
+ static bool tclas_filter_match(const struct cfg80211_tclas *t,
+-			       const struct cfg80211_flow_info *info)
++			       const struct cfg80211_flow_info *info,
++			       bool *undecided)
+ {
+ 	const struct cfg80211_tclas_filter *f = &t->filter;
+ 	u8 buf[CFG80211_TCLAS_FILTER_LEN], *p;
+ 	unsigned int i, off;
+ 
+-	if (!info->skb)
++	if (!info->skb) {
++		*undecided = true;
++
+ 		return false;
++	}
+ 
+ 	if (!tclas_filter_offset(info, f, &off))
+ 		return false;
+@@ -780,16 +784,19 @@ static bool tclas_filter_match(const str
+ }
+ 
+ static bool tclas_match(const struct cfg80211_tclas *t,
+-			const struct cfg80211_flow_info *info)
++			const struct cfg80211_flow_info *info, bool *undecided)
+ {
+ 	struct cfg80211_flow_key key;
+ 
+ 	if (t->type == CFG80211_TCLAS_FILTER)
+-		return tclas_filter_match(t, info);
++		return tclas_filter_match(t, info, undecided);
+ 
+ 	if (!cfg80211_flow_key_build(info, t->fields, CFG80211_FLOW_AS_IS,
+-				     &key))
++				     &key)) {
++		*undecided = true;
++
+ 		return false;
++	}
+ 
+ 	return !memcmp(&key, &t->key, sizeof(key));
+ }
+@@ -807,13 +814,14 @@ static u16 tclas_param_count(const struc
+ }
+ 
+ static bool scs_desc_match(const struct cfg80211_scs_desc *desc,
+-			   const struct cfg80211_flow_info *info)
++			   const struct cfg80211_flow_info *info,
++			   bool *undecided)
+ {
+ 	unsigned int i;
+ 	bool any = false;
+ 
+ 	for (i = 0; i < desc->n_tclas; i++) {
+-		if (tclas_match(&desc->tclas[i], info)) {
++		if (tclas_match(&desc->tclas[i], info, undecided)) {
+ 			any = true;
+ 			continue;
+ 		}
+@@ -866,10 +874,14 @@ void cfg80211_scs_evaluate(struct cfg802
+ 	memset(verdict, 0, sizeof(*verdict));
+ 
+ 	for (i = 0; i < n_desc; i++) {
++		bool undecided = false;
+ 		u16 count;
+ 
+-		if (!scs_desc_match(desc[i], info))
++		if (!scs_desc_match(desc[i], info, &undecided)) {
++			/* A missing parameter only matters without a match */
++			verdict->undecided |= undecided;
+ 			continue;
++		}
+ 
+ 		count = scs_desc_param_count(desc[i]);
+ 		if (count <= best)
diff --git a/package/kernel/mac80211/patches/subsys/447-wifi-cfg80211-split-the-DSCP-mapping-out-of-cfg80211.patch b/package/kernel/mac80211/patches/subsys/447-wifi-cfg80211-split-the-DSCP-mapping-out-of-cfg80211.patch
new file mode 100644
index 00000000..a00fc87f
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/447-wifi-cfg80211-split-the-DSCP-mapping-out-of-cfg80211.patch
@@ -0,0 +1,95 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Tue, 13 Oct 2026 11:57:36 +0200
+Subject: [PATCH] wifi: cfg80211: split the DSCP mapping out of
+ cfg80211_classify8021d()
+
+A driver that passes the DSCP mapping to its firmware, or that
+classifies an offloaded flow, has a DSCP but no frame to pass to
+cfg80211_classify8021d(). Move the QoS map lookup and the RFC 8325
+default mapping into cfg80211_dscp_to_up(), so that a caller can map a
+DSCP without a frame.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/cfg80211.h
++++ b/include/net/cfg80211.h
+@@ -8104,6 +8104,15 @@ unsigned int cfg80211_classify8021d(stru
+ 				    struct cfg80211_qos_map *qos_map);
+ 
+ /**
++ * cfg80211_dscp_to_up - map a DSCP to a user priority
++ * @dscp: the DSCP, 0 to 63
++ * @qos_map: Interworking QoS mapping or %NULL for the RFC 8325 default
++ * Return: The user priority.
++ */
++unsigned int cfg80211_dscp_to_up(unsigned int dscp,
++				 const struct cfg80211_qos_map *qos_map);
++
++/**
+  * cfg80211_find_elem_match - match information element and byte array in data
+  *
+  * @eid: element ID
+--- a/net/wireless/util.c
++++ b/net/wireless/util.c
+@@ -1014,19 +1014,30 @@ unsigned int cfg80211_classify8021d(stru
+ 		return 0;
+ 	}
+ 
++	ret = cfg80211_dscp_to_up(dscp >> 2, qos_map);
++out:
++	return array_index_nospec(ret, IEEE80211_NUM_TIDS);
++}
++EXPORT_SYMBOL(cfg80211_classify8021d);
++
++unsigned int cfg80211_dscp_to_up(unsigned int dscp,
++				 const struct cfg80211_qos_map *qos_map)
++{
++	unsigned int ret;
++
+ 	if (qos_map) {
+-		unsigned int i, tmp_dscp = dscp >> 2;
++		unsigned int i;
+ 
+ 		for (i = 0; i < qos_map->num_des; i++) {
+-			if (tmp_dscp == qos_map->dscp_exception[i].dscp) {
++			if (dscp == qos_map->dscp_exception[i].dscp) {
+ 				ret = qos_map->dscp_exception[i].up;
+ 				goto out;
+ 			}
+ 		}
+ 
+ 		for (i = 0; i < 8; i++) {
+-			if (tmp_dscp >= qos_map->up[i].low &&
+-			    tmp_dscp <= qos_map->up[i].high) {
++			if (dscp >= qos_map->up[i].low &&
++			    dscp <= qos_map->up[i].high) {
+ 				ret = i;
+ 				goto out;
+ 			}
+@@ -1037,7 +1048,7 @@ unsigned int cfg80211_classify8021d(stru
+ 	 * Most Significant Bits (MSBs) of the DSCP are used as the
+ 	 * corresponding L2 markings.
+ 	 */
+-	ret = dscp >> 5;
++	ret = dscp >> 3;
+ 
+ 	/* Handle specific DSCP values for which the default mapping (as
+ 	 * described above) doesn't adhere to the intended usage of the DSCP
+@@ -1050,7 +1061,7 @@ unsigned int cfg80211_classify8021d(stru
+ 	 * - Real-Time Interactive: CS4
+ 	 * - Signaling: CS5
+ 	 */
+-	switch (dscp >> 2) {
++	switch (dscp) {
+ 	case 10:
+ 	case 12:
+ 	case 14:
+@@ -1095,7 +1106,7 @@ unsigned int cfg80211_classify8021d(stru
+ out:
+ 	return array_index_nospec(ret, IEEE80211_NUM_TIDS);
+ }
+-EXPORT_SYMBOL(cfg80211_classify8021d);
++EXPORT_SYMBOL(cfg80211_dscp_to_up);
+ 
+ const struct element *ieee80211_bss_get_elem(struct cfg80211_bss *bss, u8 id)
+ {
diff --git a/package/kernel/mac80211/patches/subsys/448-wifi-mac80211-add-a-flow-priority-query.patch b/package/kernel/mac80211/patches/subsys/448-wifi-mac80211-add-a-flow-priority-query.patch
new file mode 100644
index 00000000..14389b18
--- /dev/null
+++ b/package/kernel/mac80211/patches/subsys/448-wifi-mac80211-add-a-flow-priority-query.patch
@@ -0,0 +1,206 @@
+From: Felix Fietkau <nbd@nbd.name>
+Date: Sat, 29 Aug 2026 18:48:59 +0200
+Subject: [PATCH] wifi: mac80211: add a flow priority query
+
+Frames of a flow that the hardware forwards on behalf of the driver
+never pass through mac80211, so the SCS and MSCS rules of the station
+are not applied to them. Add ieee80211_sta_flow_prio(), which lets a
+driver look up the user priority of a flow before it creates an offload
+entry.
+
+Split the rule lookup out of ieee80211_flow_classify(), so that both
+paths apply the same rules in the same order. The lookup works on a
+parsed flow description, since the driver has no frame at hand.
+
+The query fails when a rule refers to a field that the description does
+not carry, since the answer could then differ between frames of the
+flow. The driver must leave such a flow to the software path.
+
+When no rule matches, the caller can pass the DSCP of a packet of the
+flow, and the answer is the QoS map priority for it, like the software
+path assigns to a frame that no rule matches. The DSCP is not part of
+the rule lookup, since it can differ between packets of the flow.
+
+ieee80211_sta_flow_prio() refuses a flow with an undecided verdict
+also when a rule matched, since a rule that the flow cannot decide could
+match some of its frames.
+
+Signed-off-by: Felix Fietkau <nbd@nbd.name>
+
+--- a/include/net/mac80211.h
++++ b/include/net/mac80211.h
+@@ -6841,6 +6841,29 @@ struct ieee80211_sta *ieee80211_find_sta
+ 					 const u8 *addr);
+ 
+ /**
++ * ieee80211_sta_flow_prio - look up the user priority of a flow
++ *
++ * @pubsta: the station the flow is sent to
++ * @info: the flow as it is sent to @pubsta, after any address translation
++ * @dscp: the DSCP of a packet of the flow, or negative if unknown. Used
++ *	for the QoS map fallback only, when no SCS or MSCS rule matches.
++ * @prio: filled with the user priority, left untouched if no rule matches
++ *	and @dscp is negative
++ *
++ * For drivers that forward flows in hardware without passing the frames
++ * through mac80211. The result is the priority that the software path
++ * assigns to frames of this flow.
++ *
++ * Must be called under RCU lock. Does not sleep.
++ *
++ * Return: 0 on success, or a negative error if a rule refers to a field
++ *	that @info does not carry. Such a flow must not be offloaded.
++ */
++int ieee80211_sta_flow_prio(struct ieee80211_sta *pubsta,
++			    const struct cfg80211_flow_info *info, int dscp,
++			    u8 *prio);
++
++/**
+  * ieee80211_find_sta_by_ifaddr - find a station on hardware
+  *
+  * @hw: pointer as obtained from ieee80211_alloc_hw()
+--- a/net/mac80211/scs.c
++++ b/net/mac80211/scs.c
+@@ -4,6 +4,7 @@
+  *
+  * Copyright (C) 2026 Felix Fietkau <nbd@nbd.name>
+  */
++#include <linux/export.h>
+ #include <linux/ieee80211.h>
+ #include <net/cfg80211.h>
+ #include "driver-ops.h"
+@@ -114,40 +115,24 @@ static void ieee80211_scs_sta_fill(struc
+ 	}
+ }
+ 
+-/**
+- * ieee80211_flow_classify - give an MSDU the user priority of its stream
+- *
+- * @sta: the receiver
+- * @skb: the MSDU, in IEEE 802.3 format
+- *
+- * Return: %true when it set skb->priority, %false to leave the frame to the
+- *	QoS map.
+- */
+-bool ieee80211_flow_classify(struct sta_info *sta, struct sk_buff *skb)
++static bool ieee80211_flow_lookup(struct sta_info *sta,
++				  const struct cfg80211_flow_info *info,
++				  struct cfg80211_scs_verdict *verdict)
+ {
+ 	struct ieee80211_flow_entry *entry;
+-	struct cfg80211_scs_verdict verdict;
+ 	struct ieee80211_mscs_sta *mscs;
+ 	struct ieee80211_flow_hkey hkey;
+-	struct cfg80211_flow_info info;
+ 	struct ieee80211_scs_sta *scs;
+ 
++	memset(verdict, 0, sizeof(*verdict));
++
+ 	scs = rcu_dereference(sta->scs);
+ 	mscs = rcu_dereference(sta->mscs);
+-	if (!scs && !mscs)
+-		return false;
+-
+-	if (!cfg80211_flow_parse(skb, &info))
+-		return false;
+ 
+ 	if (scs) {
+-		cfg80211_scs_evaluate(scs->rule, scs->n_rules, &info,
+-				      &verdict);
+-		if (verdict.match) {
+-			skb->priority = verdict.up;
+-
++		cfg80211_scs_evaluate(scs->rule, scs->n_rules, info, verdict);
++		if (verdict->match)
+ 			return true;
+-		}
+ 	}
+ 
+ 	/* An SCS match takes precedence over the MSCS */
+@@ -155,20 +140,83 @@ bool ieee80211_flow_classify(struct sta_
+ 		return false;
+ 
+ 	hkey.sta = sta;
+-	if (!cfg80211_flow_key_build(&info, mscs->layout, CFG80211_FLOW_AS_IS,
+-				     &hkey.key))
++	if (!cfg80211_flow_key_build(info, mscs->layout, CFG80211_FLOW_AS_IS,
++				     &hkey.key)) {
++		verdict->undecided = true;
++
+ 		return false;
++	}
+ 
+ 	entry = rhashtable_lookup(&sta->sdata->bss->flow_tbl, &hkey,
+ 				  flow_rht_params);
+ 	if (!entry)
+ 		return false;
+ 
+-	skb->priority = min_t(u8, READ_ONCE(entry->up), mscs->up_limit);
++	verdict->up = min_t(u8, READ_ONCE(entry->up), mscs->up_limit);
++	verdict->match = true;
+ 
+ 	return true;
+ }
+ 
++/**
++ * ieee80211_flow_classify - give an MSDU the user priority of its stream
++ *
++ * @sta: the receiver
++ * @skb: the MSDU, in IEEE 802.3 format
++ *
++ * Return: %true when it set skb->priority, %false to leave the frame to the
++ *	QoS map.
++ */
++bool ieee80211_flow_classify(struct sta_info *sta, struct sk_buff *skb)
++{
++	struct cfg80211_scs_verdict verdict;
++	struct cfg80211_flow_info info;
++
++	if (!rcu_access_pointer(sta->scs) && !rcu_access_pointer(sta->mscs))
++		return false;
++
++	if (!cfg80211_flow_parse(skb, &info))
++		return false;
++
++	if (!ieee80211_flow_lookup(sta, &info, &verdict))
++		return false;
++
++	skb->priority = verdict.up;
++
++	return true;
++}
++
++int ieee80211_sta_flow_prio(struct ieee80211_sta *pubsta,
++			    const struct cfg80211_flow_info *info, int dscp,
++			    u8 *prio)
++{
++	struct sta_info *sta = container_of(pubsta, struct sta_info, sta);
++	struct cfg80211_scs_verdict verdict;
++	struct mac80211_qos_map *qos_map;
++	bool match;
++
++	match = ieee80211_flow_lookup(sta, info, &verdict);
++
++	/* A rule refers to a field that @info does not carry */
++	if (verdict.undecided)
++		return -EOPNOTSUPP;
++
++	if (match) {
++		*prio = verdict.up;
++
++		return 0;
++	}
++
++	if (dscp < 0)
++		return 0;
++
++	qos_map = rcu_dereference(sta->sdata->qos_map);
++	*prio = cfg80211_dscp_to_up(dscp, qos_map ? &qos_map->qos_map : NULL);
++
++	return 0;
++}
++EXPORT_SYMBOL(ieee80211_sta_flow_prio);
++
+ static void ieee80211_flow_entry_free(struct ieee80211_if_ap *ap,
+ 				      struct ieee80211_flow_entry *entry)
+ {
diff --git a/package/kernel/mac80211/patches/subsys/449-wifi-mac80211-add-the-flow-offload-flush-op.patch b/package/kernel/mac80211/patches/subsys/449-wifi-mac80211-add-the-flow-offload-flush-op.patch
