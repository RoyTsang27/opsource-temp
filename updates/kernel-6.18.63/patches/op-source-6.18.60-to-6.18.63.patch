+ 
+ struct ieee80211_link_data {
+--- a/net/mac80211/tx.c
++++ b/net/mac80211/tx.c
+@@ -5708,6 +5708,40 @@ static void ieee80211_beacon_crit_update
+ 	}
+ }
+ 
++static void ieee80211_beacon_adv_ttlm(struct ieee80211_link_data *link,
++				      struct sk_buff *skb)
++{
++	size_t hdr_len = offsetof(struct ieee80211_mgmt, u.beacon.variable);
++	u32 duration = READ_ONCE(link->u.ap.adv_ttlm_duration);
++	struct ieee80211_mgmt *mgmt = (void *)skb->data;
++	const struct element *elem;
++
++	if (!(duration & IEEE80211_ADV_TTLM_DURATION_SET))
++		return;
++
++	for_each_element_extid(elem, WLAN_EID_EXT_TID_TO_LINK_MAPPING,
++			       mgmt->u.beacon.variable, skb->len - hdr_len) {
++		u8 *pos = (u8 *)elem->data + 2;
++		u8 control;
++
++		if (elem->datalen < 2)
++			continue;
++
++		control = elem->data[1];
++		if ((control & IEEE80211_TTLM_CONTROL_SWITCH_TIME_PRESENT) ||
++		    !(control & IEEE80211_TTLM_CONTROL_EXPECTED_DUR_PRESENT))
++			continue;
++
++		if (!(control & IEEE80211_TTLM_CONTROL_DEF_LINK_MAP))
++			pos++;
++
++		if (pos + 3 > elem->data + elem->datalen)
++			continue;
++
++		put_unaligned_le24(duration, pos);
++	}
++}
