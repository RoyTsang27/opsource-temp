++void cfg80211_adv_ttlm_notify(struct net_device *dev,
++			      const struct cfg80211_adv_ttlm_event *event,
++			      gfp_t gfp)
++{
++	struct wireless_dev *wdev = dev->ieee80211_ptr;
++	atomic64_t *cookie = &wdev->u.ap.adv_ttlm_cookie;
++	struct sk_buff *msg;
++	unsigned long flags;
++
++	trace_cfg80211_adv_ttlm_notify(dev, event);
++
++	if (WARN_ON(event->cmd != NL80211_CMD_ADV_TTLM_STARTED &&
++		    event->cmd != NL80211_CMD_ADV_TTLM_ESTABLISHED &&
++		    event->cmd != NL80211_CMD_ADV_TTLM_ENDED))
++		return;
++
++	if (WARN_ON(wdev->iftype != NL80211_IFTYPE_AP))
++		return;
++
++	if (WARN_ON(event->cmd == NL80211_CMD_ADV_TTLM_STARTED &&
++		    !(wdev->valid_links & BIT(event->link_id))))
++		return;
++
++	if (!event->cookie)
++		return;
++
++	msg = nl80211_adv_ttlm_msg(dev, event, gfp);
++	if (!msg)
++		return;
++
++	/* the event goes out before the ENDED event of a stop, or not at all */
++	spin_lock_irqsave(&wdev->event_lock, flags);
++	if (atomic64_read(cookie) != event->cookie ||
++	    (event->cmd == NL80211_CMD_ADV_TTLM_ENDED &&
++	     atomic64_cmpxchg(cookie, event->cookie, 0) != event->cookie)) {
++		spin_unlock_irqrestore(&wdev->event_lock, flags);
++		nlmsg_free(msg);
++		return;
++	}
++
++	nl80211_send_adv_ttlm(dev, msg, GFP_ATOMIC);
++	spin_unlock_irqrestore(&wdev->event_lock, flags);
++}
++EXPORT_SYMBOL(cfg80211_adv_ttlm_notify);
