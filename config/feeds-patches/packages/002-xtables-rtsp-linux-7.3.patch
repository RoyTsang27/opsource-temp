@@ -0,0 +1,101 @@
+Subject: [PATCH] kernel modules: replace the removed strncpy API
+
+Use explicit bounded byte copies with zero padding to retain the legacy
+fixed-width and substring semantics. The trim operation uses memmove because
+its source and destination overlap. Userspace libc copies are unchanged.
+--- a/extensions/xt_quota2.c
++++ b/extensions/xt_quota2.c
+@@ -12,6 +12,7 @@
+  *	version 2, as published by the Free Software Foundation.
+  */
+ #include <linux/list.h>
++#include <linux/string.h>
+ #include <linux/module.h>
+ #include <linux/nsproxy.h>
+ #include <linux/proc_fs.h>
+@@ -142,7 +143,8 @@
+ 	if (!anon) {
+ 		INIT_LIST_HEAD(&e->list);
+ 		atomic_set(&e->ref, 1);
+-		strncpy(e->name, q->name, sizeof(e->name));
++		memcpy_and_pad(e->name, sizeof(e->name), q->name,
++			       strnlen(q->name, sizeof(e->name)), 0);
+ 	}
+ 	return e;
+ }
