Subject: [PATCH] LTTng: trace detached DMA fences safely on Linux 7.3

The callback table can be cleared after signaling. Follow the kernel trace
events: query detached-safe names for emit, destroy and wait, and retain the
ops class for initialization, enable-signaling and signaling call sites.
The trace caller protects the name access with RCU.
--- a/devel/lttng-modules/Makefile
+++ b/devel/lttng-modules/Makefile
@@ -9,7 +9,7 @@
 
 PKG_NAME:=lttng-modules
 PKG_VERSION:=2.15.2
-PKG_RELEASE:=1
+PKG_RELEASE:=6
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.bz2
 PKG_SOURCE_URL:=https://lttng.org/files/$(PKG_NAME)/
--- /dev/null
+++ b/devel/lttng-modules/patches/100-linux-7.3-detached-dma-fences.patch
@@ -0,0 +1,62 @@
+Subject: [PATCH] LTTng: trace detached DMA fences safely on Linux 7.3
+
+The callback table can be cleared after signaling. Follow the kernel trace
+events: query detached-safe names for emit, destroy and wait, and retain the
+ops class for initialization, enable-signaling and signaling call sites.
+The trace caller protects the name access with RCU.
+--- a/include/instrumentation/events/dma_fence.h
++++ b/include/instrumentation/events/dma_fence.h
+@@ -11,6 +11,26 @@
+ #include <lttng/tracepoint-event.h>
+ 
+ LTTNG_TRACEPOINT_EVENT_CLASS(dma_fence_class,
++
++	TP_PROTO(struct dma_fence *fence),
++
++	TP_ARGS(fence),
++
++	TP_FIELDS(
++#if (LTTNG_LINUX_VERSION_CODE >= LTTNG_KERNEL_VERSION(7,3,0))
++		ctf_string(driver, dma_fence_driver_name(fence))
++		ctf_string(timeline, dma_fence_timeline_name(fence))
++#else
++		ctf_string(driver, fence->ops->get_driver_name(fence))
++		ctf_string(timeline, fence->ops->get_timeline_name(fence))
++#endif
++		ctf_integer(unsigned int, context, fence->context)
++		ctf_integer(unsigned int, seqno, fence->seqno)
++	)
++)
++
++/* These call sites run before detachment, just like the kernel's ops class. */
++LTTNG_TRACEPOINT_EVENT_CLASS(dma_fence_ops_class,
+ 
+ 	TP_PROTO(struct dma_fence *fence),
+ 
+@@ -32,7 +52,7 @@
+ 	TP_ARGS(fence)
+ )
+ 
+-LTTNG_TRACEPOINT_EVENT_INSTANCE(dma_fence_class,
++LTTNG_TRACEPOINT_EVENT_INSTANCE(dma_fence_ops_class,
+ 	dma_fence_init,
+ 
+ 	TP_PROTO(struct dma_fence *fence),
+@@ -48,7 +68,7 @@
+ 	TP_ARGS(fence)
+ )
+ 
+-LTTNG_TRACEPOINT_EVENT_INSTANCE(dma_fence_class,
++LTTNG_TRACEPOINT_EVENT_INSTANCE(dma_fence_ops_class,
+ 	dma_fence_enable_signal,
+ 
+ 	TP_PROTO(struct dma_fence *fence),
+@@ -56,7 +76,7 @@
+ 	TP_ARGS(fence)
+ )
+ 
+-LTTNG_TRACEPOINT_EVENT_INSTANCE(dma_fence_class,
++LTTNG_TRACEPOINT_EVENT_INSTANCE(dma_fence_ops_class,
+ 	dma_fence_signaled,
+ 
+ 	TP_PROTO(struct dma_fence *fence),

--- /dev/null
+++ b/devel/lttng-modules/patches/101-linux-7.3-trace-prototypes.patch
@@ -0,0 +1,53 @@
+Subject: [PATCH] LTTng: match Linux 7.3 packet-drop and Btrfs trace prototypes
+
+The packet-drop socket is now const. Btrfs transaction commit takes a
+transaction handle and reports its transaction ID. Preserve the existing
+trace fields and older-kernel prototypes.
+--- a/include/instrumentation/events/skb.h
++++ b/include/instrumentation/events/skb.h
+@@ -50,8 +50,13 @@
+ 
+ 	skb_kfree,
+ 
++#if (LTTNG_LINUX_VERSION_CODE >= LTTNG_KERNEL_VERSION(7,3,0))
++	TP_PROTO(struct sk_buff *skb, void *location,
++		enum skb_drop_reason reason, const struct sock *rx_sk),
++#else
+ 	TP_PROTO(struct sk_buff *skb, void *location,
+ 		enum skb_drop_reason reason, struct sock *rx_sk),
++#endif
+ 
+ 	TP_ARGS(skb, location, reason, rx_sk),
+ 
+@@ -59,7 +64,7 @@
+ 		ctf_integer_hex(void *, location, location)
+ 		ctf_integer_network(unsigned short, protocol, skb->protocol)
+ 		ctf_enum(skb_drop_reason, uint8_t, reason, reason)
+-		ctf_integer_hex(void *, rx_skaddr, rx_sk)
++		ctf_integer_hex(const void *, rx_skaddr, rx_sk)
+ 	)
+ )
+ #elif (LTTNG_LINUX_VERSION_CODE >= LTTNG_KERNEL_VERSION(5,17,0) \
+--- a/include/instrumentation/events/btrfs.h
++++ b/include/instrumentation/events/btrfs.h
+@@ -55,7 +55,19 @@
+ #define lttng_fs_info_fsid fs_info->fsid
+ #endif
+ 
+-#if (LTTNG_LINUX_VERSION_CODE >= LTTNG_KERNEL_VERSION(5,17,0))
++#if (LTTNG_LINUX_VERSION_CODE >= LTTNG_KERNEL_VERSION(7,3,0))
++LTTNG_TRACEPOINT_EVENT(btrfs_transaction_commit,
++
++	TP_PROTO(const struct btrfs_trans_handle *trans),
++
++	TP_ARGS(trans),
++
++	TP_FIELDS(
++		ctf_integer(u64, generation, trans->transid)
++		ctf_integer(u64, root_objectid, BTRFS_ROOT_TREE_OBJECTID)
++	)
++)
++#elif (LTTNG_LINUX_VERSION_CODE >= LTTNG_KERNEL_VERSION(5,17,0))
+ LTTNG_TRACEPOINT_EVENT(btrfs_transaction_commit,
+ 
+ 	TP_PROTO(const struct btrfs_fs_info *fs_info),

--- /dev/null
+++ b/devel/lttng-modules/patches/102-linux-7.3-syscall-event-name-copy.patch
@@ -0,0 +1,34 @@
+Subject: [PATCH] LTTng: use bounded terminated syscall event names
+
+The ABI event structure is already zeroed. strscpy preserves termination
+and the existing padding without relying on the removed strncpy API.
+--- a/src/lttng-syscalls.c
++++ b/src/lttng-syscalls.c
+@@ -9,6 +9,7 @@
+ 
+ #include <linux/module.h>
+ #include <linux/slab.h>
++#include <linux/string.h>
+ #include <linux/compat.h>
+ #include <linux/err.h>
+ #include <linux/bitmap.h>
+@@ -609,8 +610,7 @@
+ 			ev.u.syscall.abi = LTTNG_KERNEL_ABI_SYSCALL_ABI_COMPAT;
+ 			break;
+ 		}
+-		strncpy(ev.name, desc->event_name, LTTNG_KERNEL_ABI_SYM_NAME_LEN - 1);
+-		ev.name[LTTNG_KERNEL_ABI_SYM_NAME_LEN - 1] = '\0';
++		strscpy(ev.name, desc->event_name, sizeof(ev.name));
+ 		ev.instrumentation = LTTNG_KERNEL_ABI_SYSCALL;
+ 		ev.token = syscall_event_enabler->user_token;
+ 		event_recorder_enabler = lttng_event_recorder_enabler_create(LTTNG_ENABLER_FORMAT_NAME, &ev,
+@@ -701,8 +701,7 @@
+ 			ev.u.syscall.abi = LTTNG_KERNEL_ABI_SYSCALL_ABI_COMPAT;
+ 			break;
+ 		}
+-		strncpy(ev.name, desc->event_name, LTTNG_KERNEL_ABI_SYM_NAME_LEN - 1);
+-		ev.name[LTTNG_KERNEL_ABI_SYM_NAME_LEN - 1] = '\0';
++		strscpy(ev.name, desc->event_name, sizeof(ev.name));
+ 		ev.instrumentation = LTTNG_KERNEL_ABI_SYSCALL;
+ 		ev.token = syscall_event_enabler->user_token;
+ 		event_counter_enabler = lttng_event_counter_enabler_create(LTTNG_ENABLER_FORMAT_NAME, &ev,
