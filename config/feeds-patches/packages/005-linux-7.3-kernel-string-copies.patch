Subject: [PATCH] kernel modules: replace the removed strncpy API

Use explicit bounded byte copies with zero padding to retain the legacy
fixed-width and substring semantics. The trim operation uses memmove because
its source and destination overlap. Userspace libc copies are unchanged.
--- a/net/open-app-filter/Makefile
+++ b/net/open-app-filter/Makefile
@@ -2,7 +2,7 @@
 include $(INCLUDE_DIR)/kernel.mk
 
 PKG_NAME:=open-app-filter
-PKG_RELEASE:=1
+PKG_RELEASE:=3
 
 PKG_SOURCE_URL:=https://github.com/destan19/OpenAppFilter.git
 PKG_SOURCE_PROTO:=git
--- /dev/null
+++ b/net/open-app-filter/patches/950-linux-7.3-bounded-kernel-copies.patch
@@ -0,0 +1,246 @@
+Subject: [PATCH] kernel modules: replace the removed strncpy API
+
+Use explicit bounded byte copies with zero padding to retain the legacy
+fixed-width and substring semantics. The trim operation uses memmove because
+its source and destination overlap. Userspace libc copies are unchanged.
