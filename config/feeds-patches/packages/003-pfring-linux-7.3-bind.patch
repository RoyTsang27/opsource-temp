Subject: [PATCH] PF_RING: match the current socket bind callback type

Current kernels pass a variable-size socket address to proto_ops.bind. Keep
the old type on the supported older kernels, without hiding a type mismatch.

--- a/libs/libpfring/Makefile
+++ b/libs/libpfring/Makefile
@@ -10,7 +10,7 @@
 
 PKG_NAME:=libpfring
 PKG_VERSION:=9.2.0
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE:=$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://codeload.github.com/ntop/PF_RING/tar.gz/$(PKG_VERSION)?
--- /dev/null
+++ b/libs/libpfring/patches/902-linux-7.3-socket-bind-address.patch
@@ -0,0 +1,19 @@
+Subject: [PATCH] PF_RING: match the current socket bind callback type
+
+Current kernels pass a variable-size socket address to proto_ops.bind. Keep
+the old type on the supported older kernels, without hiding a type mismatch.
+
+--- a/kernel/pf_ring.c
++++ b/kernel/pf_ring.c
+@@ -5861,7 +5861,11 @@
+ /* ************************************* */
+ 
+ /* Bind to a device */
++#if LINUX_VERSION_CODE >= KERNEL_VERSION(6,19,0)
++static int ring_bind(struct socket *sock, struct sockaddr_unsized *sa, int addr_len)
++#else
+ static int ring_bind(struct socket *sock, struct sockaddr *sa, int addr_len)
++#endif
+ {
+   struct sock *sk = sock->sk;
+   struct net *net = sock_net(sk);
