Subject: [PATCH] DAHDI: adapt the PPP error callback to Linux 7.3

The unused error-code parameter was removed. Retain the old call for the
older kernels supported by this source.
--- a/libs/dahdi-linux/Makefile
+++ b/libs/dahdi-linux/Makefile
@@ -10,7 +10,7 @@
 
 PKG_NAME:=dahdi-linux
 PKG_VERSION:=3.4.0
-PKG_RELEASE:=3
+PKG_RELEASE:=4
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://github.com/asterisk/$(PKG_NAME)/releases/download/v$(PKG_VERSION)
--- /dev/null
+++ b/libs/dahdi-linux/patches/220-linux-7.3-ppp-input-error.patch
@@ -0,0 +1,18 @@
+Subject: [PATCH] DAHDI: adapt the PPP error callback to Linux 7.3
+
+The unused error-code parameter was removed. Retain the old call for the
+older kernels supported by this source.
+--- a/drivers/dahdi/dahdi-base.c
++++ b/drivers/dahdi/dahdi-base.c
+@@ -6349,7 +6349,11 @@
+ 		ppp_input(chan->ppp, skb);
+ 	if (chan->do_ppp_error) {
+ 		chan->do_ppp_error = 0;
++#if LINUX_VERSION_CODE >= KERNEL_VERSION(7,3,0)
++		ppp_input_error(chan->ppp);
++#else
+ 		ppp_input_error(chan->ppp, 0);
++#endif
+ 	}
+ }
+ #endif
