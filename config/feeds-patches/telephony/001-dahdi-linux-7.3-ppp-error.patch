Subject: [PATCH] DAHDI: adapt the PPP error callback to Linux 7.3

The unused error-code parameter was removed. Retain the old call for the
older kernels supported by this source.
--- a/libs/dahdi-linux/Makefile
+++ b/libs/dahdi-linux/Makefile
@@ -10,7 +10,7 @@
 
 PKG_NAME:=dahdi-linux
 PKG_VERSION:=3.4.0
-PKG_RELEASE:=3
+PKG_RELEASE:=5
 
 PKG_SOURCE:=$(PKG_NAME)-$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://github.com/asterisk/$(PKG_NAME)/releases/download/v$(PKG_VERSION)
--- /dev/null
+++ b/libs/dahdi-linux/patches/220-linux-7.3-ppp-input-error.patch
@@ -0,0 +1,18 @@
+Subject: [PATCH] DAHDI: adapt the PPP error callback to Linux 7.3
+
+The unused error-code parameter was removed. Retain the old call for the
+older kernels supported by this source.
+--- a/drivers/dahdi/dahdi-base.c
++++ b/drivers/dahdi/dahdi-base.c
+@@ -6349,7 +6349,11 @@
+ 		ppp_input(chan->ppp, skb);
+ 	if (chan->do_ppp_error) {
+ 		chan->do_ppp_error = 0;
++#if LINUX_VERSION_CODE >= KERNEL_VERSION(7,3,0)
++		ppp_input_error(chan->ppp);
++#else
+ 		ppp_input_error(chan->ppp, 0);
++#endif
+ 	}
+ }
+ #endif

--- /dev/null
+++ b/libs/dahdi-linux/patches/221-napi-include-before-compatibility-alias.patch
@@ -0,0 +1,16 @@
+Subject: [PATCH] DAHDI: include NAPI declarations before the compatibility alias
+
+The alias otherwise rewrites netdevice.h declarations when PPP is enabled
+without HDLC networking. Include the header first so its inline functions
+retain their original names and signatures.
+--- a/include/dahdi/kernel.h
++++ b/include/dahdi/kernel.h
+@@ -68,6 +68,8 @@
+ #endif
+ 
+ #if LINUX_VERSION_CODE >= KERNEL_VERSION(6, 1, 0)
++/* Parse kernel declarations before applying the legacy four-argument alias. */
++#include <linux/netdevice.h>
+ #define netif_napi_add netif_napi_add_weight
+ #endif
+ 
