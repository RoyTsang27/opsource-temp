Subject: [PATCH] rtpengine: preserve required compiler flags on modern kernels

--- a/net/rtpengine/Makefile
+++ b/net/rtpengine/Makefile
@@ -8,7 +8,7 @@
 
 PKG_NAME:=rtpengine
 PKG_VERSION:=11.5.1.49
-PKG_RELEASE:=1
+PKG_RELEASE:=2
 
 PKG_SOURCE:=$(PKG_NAME)-mr$(PKG_VERSION).tar.gz
 PKG_SOURCE_URL:=https://codeload.github.com/sipwise/rtpengine/tar.gz/mr$(PKG_VERSION)?
--- /dev/null
+++ b/net/rtpengine/patches/220-kbuild-compiler-flags.patch
@@ -0,0 +1,18 @@
+Subject: [PATCH] rtpengine: use supported Kbuild compiler flags
+
+Keep the external header mode and version define on modern kernels.
+
+--- a/kernel-module/Makefile
++++ b/kernel-module/Makefile
+@@ -22,9 +22,9 @@
+     RTPENGINE_VERSION+=undefined
+   endif
+ endif
+-EXTRA_CFLAGS+=	-DRTPENGINE_VERSION="\"$(RTPENGINE_VERSION)\""
++ccflags-y+=	-DRTPENGINE_VERSION="\"$(RTPENGINE_VERSION)\""
+ 
+-EXTRA_CFLAGS += -D__RE_EXTERNAL
++ccflags-y += -D__RE_EXTERNAL
+ 
+ obj-m        += xt_RTPENGINE.o
+ 
