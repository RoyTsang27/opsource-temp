From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 19 Nov 2026 13:43:42 +0100
Subject: [PATCH] wifi: mt76: mt7915: drop the TWT agreements at a full reset

Upstream: https://github.com/openwrt/mt76/commit/734f912cdecbf5d68afff5bd88944b232d997517
Includes upstream 4d24c73d71f6dfb78cb6c067aaccd74d3b04215f for the station rate-control list.
Fixes: 8a55712d124f ("wifi: mt76: mt7915: enable full system reset support")
Fixes: 065c79df595a ("wifi: mt76: mt7915: fix list corruption after hardware restart")
Link: https://patch.msgid.link/20261119124352.1842164-10-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

diff --git a/mt7915/mac.c b/mt7915/mac.c
index 8df4d6a..85d58dc 100644
--- a/mt7915/mac.c
+++ b/mt7915/mac.c
@@ -1525,6 +1525,7 @@ out:
 static void
 mt7915_mac_full_reset(struct mt7915_dev *dev)
 {
+	struct mt7915_twt_flow *flow, *tmp;
 	struct mt76_phy *ext_phy;
 	struct mt7915_phy *phy2;
 	int i;
@@ -1561,8 +1562,20 @@ mt7915_mac_full_reset(struct mt7915_dev *dev)
 
 	mt76_reset_device(&dev->mt76);
 
-	INIT_LIST_HEAD(&dev->sta_rc_list);
-	INIT_LIST_HEAD(&dev->twt_list);
+	spin_lock_bh(&dev->mt76.sta_poll_lock);
+	while (!list_empty(&dev->sta_rc_list))
+		list_del_init(dev->sta_rc_list.next);
+	spin_unlock_bh(&dev->mt76.sta_poll_lock);
+
+	list_for_each_entry_safe(flow, tmp, &dev->twt_list, list) {
+		struct mt7915_sta *msta;
+
+		msta = container_of(flow, struct mt7915_sta, twt.flow[flow->id]);
+		msta->twt.flowid_mask &= ~BIT(flow->id);
+		list_del_init(&flow->list);
+	}
+	dev->twt.table_mask = 0;
+	dev->twt.n_agrt = 0;
 
 	i = mt76_wcid_alloc(dev->mt76.wcid_mask, MT7915_WTBL_STA);
 	dev->mt76.global_wcid.idx = i;
