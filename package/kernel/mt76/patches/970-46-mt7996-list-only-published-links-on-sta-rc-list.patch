From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 19 Nov 2026 13:43:38 +0100
Subject: [PATCH] wifi: mt76: mt7996: list only published links on sta_rc_list

Upstream: https://github.com/openwrt/mt76/commit/585897a5ce77aaffb7787dc6f0c0ca94dca86cdc
Fixes: ace5d3b6b49e ("wifi: mt76: mt7996: improve hardware restart reliability")
Link: https://patch.msgid.link/20261119124352.1842164-6-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

diff --git a/mt7996/main.c b/mt7996/main.c
index e3b4351..5f6f1d3 100644
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1397,8 +1397,10 @@ void mt7996_mac_sta_remove_link(struct mt7996_dev *dev,
 	if (!msta_link)
 		return;
 
-	if (flush)
+	if (flush) {
+		rcu_assign_pointer(msta->link[link_id], NULL);
 		rcu_assign_pointer(dev->mt76.wcid[msta_link->wcid.idx], NULL);
+	}
 
 	spin_lock_bh(&dev->mt76.sta_poll_lock);
 	if (!list_empty(&msta_link->wcid.poll_list))
@@ -1425,7 +1427,6 @@ void mt7996_mac_sta_remove_link(struct mt7996_dev *dev,
 		if (phy)
 			phy->mt76->num_sta--;
 
-		rcu_assign_pointer(msta->link[link_id], NULL);
 		mt76_wcid_mask_clear(dev->mt76.wcid_mask, msta_link->wcid.idx);
 		if (msta_link != &msta->deflink)
 			kfree_rcu(msta_link, rcu_head);
@@ -2572,6 +2573,7 @@ static void mt7996_link_rate_ctrl_update(void *data,
 {
 	struct mt7996_sta *msta = msta_link->sta;
 	struct mt7996_phy *phy = mt7996_vif_link_phy(&msta->vif->deflink);
+	u8 link_id = msta_link->wcid.link_id;
 	struct mt7996_dev *dev;
 	u32 *changed = data;
 
@@ -2582,7 +2584,8 @@ static void mt7996_link_rate_ctrl_update(void *data,
 	spin_lock_bh(&dev->mt76.sta_poll_lock);
 
 	msta_link->changed |= *changed;
-	if (list_empty(&msta_link->rc_list))
+	if (list_empty(&msta_link->rc_list) &&
+	    rcu_access_pointer(msta->link[link_id]) == msta_link)
 		list_add_tail(&msta_link->rc_list, &dev->sta_rc_list);
 
 	spin_unlock_bh(&dev->mt76.sta_poll_lock);
