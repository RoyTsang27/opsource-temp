From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 19 Nov 2026 13:43:45 +0100
Subject: [PATCH] wifi: mt76: mt7996: read twt_list under the mutex in twt_stats

Upstream: https://github.com/openwrt/mt76/commit/badbd18bab1bb3e9efcb63e9d305fab82845cacf
Fixes: 98686cd21624 ("wifi: mt76: mt7996: add driver for MediaTek Wi-Fi 7 (802.11be) devices")
Link: https://patch.msgid.link/20261119124352.1842164-13-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

diff --git a/mt7996/debugfs.c b/mt7996/debugfs.c
index 3780760..0f99c38 100644
--- a/mt7996/debugfs.c
+++ b/mt7996/debugfs.c
@@ -904,11 +904,11 @@ mt7996_twt_stats(struct seq_file *s, void *data)
 	struct mt7996_dev *dev = dev_get_drvdata(s->private);
 	struct mt7996_twt_flow *iter;
 
-	rcu_read_lock();
+	mutex_lock(&dev->mt76.mutex);
 
 	seq_puts(s, "     wcid |       id |    flags |      exp | mantissa");
 	seq_puts(s, " | duration |            tsf |\n");
-	list_for_each_entry_rcu(iter, &dev->twt_list, list)
+	list_for_each_entry(iter, &dev->twt_list, list)
 		seq_printf(s,
 			   "%9d | %8d | %5c%c%c%c | %8d | %8d | %8d | %14lld |\n",
 			   iter->wcid, iter->id,
@@ -919,7 +919,7 @@ mt7996_twt_stats(struct seq_file *s, void *data)
 			   iter->exp, iter->mantissa,
 			   iter->duration, iter->tsf);
 
-	rcu_read_unlock();
+	mutex_unlock(&dev->mt76.mutex);
 
 	return 0;
 }
