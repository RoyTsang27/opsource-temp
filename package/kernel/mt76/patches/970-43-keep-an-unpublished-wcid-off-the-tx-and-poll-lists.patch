From: Felix Fietkau <nbd@nbd.name>
Date: Tue, 17 Nov 2026 19:01:31 +0100
Subject: [PATCH] wifi: mt76: keep an unpublished wcid off the TX and poll lists

Upstream: https://github.com/openwrt/mt76/commit/331cd72f152021b5cf987bf8c6cfb97d3b5905f8
Fixes: 0335c034e726 ("wifi: mt76: fix race condition related to checking tx queue fill status")
Fixes: f520eceacd24 ("wifi: mt76: mt7996: Add mt7996_mac_sta_change_links callback")
Link: https://patch.msgid.link/20261117180134.2940930-16-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

diff --git a/mac80211.c b/mac80211.c
index 842daf8..a07eac5 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -1964,7 +1964,8 @@ void mt76_wcid_add_poll(struct mt76_dev *dev, struct mt76_wcid *wcid)
 		return;
 
 	spin_lock_bh(&dev->sta_poll_lock);
-	if (list_empty(&wcid->poll_list))
+	if (rcu_access_pointer(dev->wcid[wcid->idx]) == wcid &&
+	    list_empty(&wcid->poll_list))
 		list_add_tail(&wcid->poll_list, &dev->sta_poll_list);
 	spin_unlock_bh(&dev->sta_poll_lock);
 }
diff --git a/mt7996/main.c b/mt7996/main.c
index e6a967e..e3b4351 100644
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1397,6 +1397,9 @@ void mt7996_mac_sta_remove_link(struct mt7996_dev *dev,
 	if (!msta_link)
 		return;
 
+	if (flush)
+		rcu_assign_pointer(dev->mt76.wcid[msta_link->wcid.idx], NULL);
+
 	spin_lock_bh(&dev->mt76.sta_poll_lock);
 	if (!list_empty(&msta_link->wcid.poll_list))
 		list_del_init(&msta_link->wcid.poll_list);
@@ -1423,7 +1426,6 @@ void mt7996_mac_sta_remove_link(struct mt7996_dev *dev,
 			phy->mt76->num_sta--;
 
 		rcu_assign_pointer(msta->link[link_id], NULL);
-		rcu_assign_pointer(dev->mt76.wcid[msta_link->wcid.idx], NULL);
 		mt76_wcid_mask_clear(dev->mt76.wcid_mask, msta_link->wcid.idx);
 		if (msta_link != &msta->deflink)
 			kfree_rcu(msta_link, rcu_head);
diff --git a/tx.c b/tx.c
index 58ca6a1..9810feb 100644
--- a/tx.c
+++ b/tx.c
@@ -365,6 +365,7 @@ mt76_tx(struct mt76_phy *phy, struct ieee80211_sta *sta,
 {
 	struct ieee80211_tx_info *info = IEEE80211_SKB_CB(skb);
 	struct ieee80211_hdr *hdr = (void *)skb->data;
+	struct mt76_dev *dev = phy->dev;
 	struct sk_buff_head *head;
 
 	if (mt76_testmode_enabled(phy)) {
@@ -388,16 +389,23 @@ mt76_tx(struct mt76_phy *phy, struct ieee80211_sta *sta,
 	else
 		head = &wcid->tx_pending;
 
-	spin_lock_bh(&head->lock);
+	spin_lock_bh(&dev->tx_lock);
+	if (wcid != &dev->global_wcid &&
+	    rcu_access_pointer(dev->wcid[wcid->idx]) != wcid) {
+		spin_unlock_bh(&dev->tx_lock);
+		ieee80211_free_txskb(phy->hw, skb);
+		return;
+	}
+
+	spin_lock(&head->lock);
 	__skb_queue_tail(head, skb);
-	spin_unlock_bh(&head->lock);
+	spin_unlock(&head->lock);
 
-	spin_lock_bh(&phy->dev->tx_lock);
 	if (list_empty(&wcid->tx_list))
 		list_add_tail(&wcid->tx_list, &phy->tx_list);
-	spin_unlock_bh(&phy->dev->tx_lock);
+	spin_unlock_bh(&dev->tx_lock);
 
-	mt76_worker_schedule(&phy->dev->tx_worker);
+	mt76_worker_schedule(&dev->tx_worker);
 }
 EXPORT_SYMBOL_GPL(mt76_tx);
 
