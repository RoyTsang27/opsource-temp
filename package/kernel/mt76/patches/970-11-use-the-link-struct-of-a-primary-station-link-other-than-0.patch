From: Felix Fietkau <nbd@nbd.name>
Date: Wed, 18 Nov 2026 17:18:13 +0100
Subject: [PATCH] wifi: mt76: use the link struct of a primary station link other than 0

Upstream: https://github.com/openwrt/mt76/commit/7539f346353425835458235213268e2b61279027
Fixes: 381733b3a14a ("wifi: mt76: send nullfunc PS frames on offchannel transitions")
Fixes: 4df75606ece5 ("wifi: mt76: add per-link beacon monitoring for MLO")
Link: https://patch.msgid.link/20261118161827.1208649-2-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

diff --git a/mac80211.c b/mac80211.c
index 56947cc..1563cc4 100644
--- a/mac80211.c
+++ b/mac80211.c
@@ -2353,10 +2353,7 @@ mt76_offchannel_notify_iter(void *_data, u8 *mac, struct ieee80211_vif *vif)
 	}
 
 	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++) {
-		if (link_id == mvif->deflink_id)
-			mlink = (struct mt76_vif_link *)vif->drv_priv;
-		else
-			mlink = rcu_dereference(mvif->link[link_id]);
+		mlink = rcu_dereference(mvif->link[link_id]);
 		if (!mlink)
 			continue;
 		if (mt76_vif_link_phy(mlink) != data->phy)
@@ -2406,10 +2403,7 @@ static void mt76_rx_beacon_iter(void *_data, u8 *mac,
 	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++) {
 		struct ieee80211_bss_conf *link_conf;
 
-		if (link_id == mvif->deflink_id)
-			mlink = (struct mt76_vif_link *)vif->drv_priv;
-		else
-			mlink = rcu_dereference(mvif->link[link_id]);
+		mlink = rcu_dereference(mvif->link[link_id]);
 		if (!mlink || !READ_ONCE(mlink->beacon_mon_interval))
 			continue;
 
@@ -2467,10 +2461,7 @@ static void mt76_beacon_mon_iter(void *data, u8 *mac,
 	for (link_id = 0; link_id < IEEE80211_MLD_MAX_NUM_LINKS; link_id++) {
 		u16 interval;
 
-		if (link_id == mvif->deflink_id)
-			mlink = (struct mt76_vif_link *)vif->drv_priv;
-		else
-			mlink = rcu_dereference(mvif->link[link_id]);
+		mlink = rcu_dereference(mvif->link[link_id]);
 		if (!mlink)
 			continue;
 
