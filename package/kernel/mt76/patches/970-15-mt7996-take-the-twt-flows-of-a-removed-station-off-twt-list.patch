From: Felix Fietkau <nbd@nbd.name>
Date: Thu, 19 Nov 2026 13:43:41 +0100
Subject: [PATCH] wifi: mt76: mt7996: take the TWT flows of a removed station off twt_list

Upstream: https://github.com/openwrt/mt76/commit/2b4a2a162a1b6ed3cf1e38af57dbdeaeec3a8630
Fixes: 98686cd21624 ("wifi: mt76: mt7996: add driver for MediaTek Wi-Fi 7 (802.11be) devices")
Link: https://patch.msgid.link/20261119124352.1842164-9-nbd@nbd.name
Signed-off-by: Felix Fietkau <nbd@nbd.name>

diff --git a/mt7996/main.c b/mt7996/main.c
index a5e75ed..c9690d4 100644
--- a/mt7996/main.c
+++ b/mt7996/main.c
@@ -1993,9 +1993,20 @@ mt7996_mac_sta_remove(struct mt7996_dev *dev, struct ieee80211_vif *vif,
 		      struct ieee80211_sta *sta)
 {
 	struct mt7996_sta *msta = (struct mt7996_sta *)sta->drv_priv;
+	struct mt7996_sta_link *msta_link = &msta->deflink;
 	int i;
 
 	mutex_lock(&dev->mt76.mutex);
+
+	/* the firmware can still hold an agreement whose delete failed, so
+	 * its table entry stays counted
+	 */
+	for (i = 0; i < ARRAY_SIZE(msta_link->twt.flow); i++) {
+		if (msta_link->twt.flowid_mask & BIT(i))
+			list_del_init(&msta_link->twt.flow[i].list);
+	}
+	msta_link->twt.flowid_mask = 0;
+
 	for (i = 0; i < ARRAY_SIZE(msta->link); i++)
 		mt7996_mac_sta_remove_link(dev, sta, i, true);
 	mutex_unlock(&dev->mt76.mutex);
