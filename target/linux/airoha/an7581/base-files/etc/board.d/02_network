. /lib/functions.sh
. /lib/functions/uci-defaults.sh
. /lib/functions/system.sh

an7581_setup_interfaces()
{
	local board="$1"

	case "$board" in
	airoha,an7581-evb)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 lan4" "eth1"
		;;
	gemtek,w1700k-ubi)
		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "wan"
		;;
	nokia,valyrian)
		ucidef_set_interfaces_lan_wan "lan1 lan2 lan3 10g" "wan"
		;;
	nokia,xg-040g-md |\
	nokia,xg-040g-md-tcboot |\
	nokia,xg-040g-md-ubi)
		ucidef_set_interface_lan "lan1 lan2 lan3 lan4"
		;;
	nokia,xg-140g-tf-tcboot)
		ucidef_set_interfaces_lan_wan "lan2 lan3 lan4" "lan1"
		;;
	quantum,q1000k-ubi)
		# Both copper ports are LAN; the upstream connection is PON.
		ucidef_set_interface_lan "lan1 lan2"
		;;
	*)
		echo "Unsupported hardware. Network interfaces not initialized"
		;;
	esac
}

an7581_xg040g_tcboot_ensure_mac()
{
	local board="$1"
	local mac
	local lan_mac
	local idx

	case "$board" in
	nokia,xg-040g-md-tcboot|\
	nokia,xg-140g-tf-tcboot)
		;;
	*)
		return 0
		;;
	esac

	# config_generate runs before uboot-envtools creates fw_env.config.
	# Read the factory MAC directly, as in xiangtailiang's tcboot build.
	idx="$(find_mtd_index env)"
	[ -n "$idx" ] || return 0
	mac="$(strings "/dev/mtd$idx" | sed -n 's/^ethaddr=//p' | head -n1)"
	mac="$(macaddr_canonicalize "$mac")"
	[ -n "$mac" ] || return 0
	lan_mac="$(macaddr_add "$mac" 1)"
	ucidef_set_network_device_mac "lan1" "$mac"
	ucidef_set_network_device_mac "br-lan" "$lan_mac"
	ucidef_set_label_macaddr "$mac"
}

board_config_update
board=$(board_name)
an7581_setup_interfaces "$board"
an7581_xg040g_tcboot_ensure_mac "$board"
board_config_flush

exit 0
