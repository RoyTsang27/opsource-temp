#!/bin/sh

. /lib/functions/uci-defaults.sh

board_config_update

case "$(board_name)" in
skyworth,sk-d840n)
	# The UNI switch needs its conduit and internal lan0 in the LAN bridge.
	ucidef_set_interface lan device "lan1 lan2 lan3 lan4 lan0 lan-cpu0" \
		protocol static ipaddr 192.168.9.1 netmask 255.255.255.0
	ucidef_set_interface_wan eth0
	;;
esac

board_config_flush
exit 0
